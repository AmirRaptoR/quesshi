{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27017"
  },
  "Mongo": {
    "Database": "quesshi"
  },
  "Orleans": {
    "ClusterId": "quesshi"
  },
  "Jwt": {
    "Issuer": "quesshi",
    "Audience": "quesshi",
    "Days": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseTls": true,
    "From": "no-reply@quesshi.app"
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "google/gemini-2.5-flash",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "MaxTokens": 8000,
    "AppName": "Quesshi",
    "AppUrl": "https://quesshi.app"
  },
  "Generation": {
    "Nightly": false,
    "TargetPerBucket": 25,
    "MaxPerRun": 60,
    "BatchSize": 10
  },
  "Auth": {
    "GoogleClientId": ""
  },
  "AdminAuth": {
    "Issuer": "quesshi",
    "SessionHours": 8,
    "BootstrapUsername": "admin",
    "BootstrapEmail": "admin@localhost",
    "BootstrapPassword": ""
  }
}
