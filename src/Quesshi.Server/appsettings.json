{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tenants": {
    "Tenants": [
      {
        "Id": "quesshi",
        "Name": "Quesshi",
        "Hosts": [ "localhost", "127.0.0.1", "quesshi.app", "www.quesshi.app" ],
        "Theme": "quesshi",
        "LandingContent": {
          "fa": "بازی کن، یاد بگیر، با هم رقابت کن",
          "en": "Play, learn, and challenge your friends",
          "nl": "Speel, leer en daag je vrienden uit"
        },
        "Languages": [ "fa", "en", "nl" ],
        "EnabledModes": [ "async", "live", "voting" ],
        "Rules": {
          "defaultLanguage": "fa",
          "defaultMaxParticipants": "2",
          "liveMaxParticipants": "20"
        }
      },
      {
        "Id": "quessher",
        "Name": "Quessher",
        "Hosts": [ "quessher.localhost", "quessher.test" ],
        "Theme": "quessher",
        "LandingContent": {
          "fa": "",
          "en": "",
          "nl": ""
        },
        "Languages": [ "fa", "en", "nl" ],
        "EnabledModes": [ "voting" ],
        "Rules": {}
      }
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27017"
  },
  "Mongo": {
    "Database": "quesshi"
  },
  "Orleans": {
    "ClusterId": "quesshi"
  },
  "Jwt": {
    "Issuer": "quesshi",
    "Audience": "quesshi",
    "Days": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseTls": true,
    "From": "no-reply@quesshi.app"
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "google/gemini-2.5-flash",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "MaxTokens": 8000,
    "AppName": "Quesshi",
    "AppUrl": "https://quesshi.app"
  },
  "Generation": {
    "Nightly": false,
    "TargetPerBucket": 25,
    "SortTargetPerBucket": 6,
    "MapTargetPerBucket": 6,
    "MaxPerRun": 60,
    "BatchSize": 10
  },
  "VotingGeneration": {
    "MaxBatchSize": 20,
    "AutoApprove": false
  },
  "Auth": {
    "GoogleClientId": ""
  },
  "AdminAuth": {
    "Issuer": "quesshi",
    "SessionHours": 8,
    "BootstrapUsername": "admin",
    "BootstrapEmail": "admin@localhost",
    "BootstrapPassword": ""
  }
}
