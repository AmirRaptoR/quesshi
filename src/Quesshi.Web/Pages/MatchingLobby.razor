@page "/matching/lobby/{Code}"
@inherits PageBase
@implements IAsyncDisposable
@inject Func<string, LiveClient> ClientFactory

<PageTitle>@L["matching.lobby.title"] · @L["app.name"]</PageTitle>

<div class="shell">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_view is null)
    {
        <div class="empty"><p>@L["join.noSuchCode"]</p><a class="btn btn--ghost" href="/play">@L["common.back"]</a></div>
    }
    else
    {
        var view = _view;
        var owner = view.Participants.FirstOrDefault()?.Id == MeId;
        var seated = view.Participants.Any(p => p.Id == MeId);
        <header class="topbar enter">
            <a class="lobby-back" href="/play" aria-label="@L["common.back"]"><Icon Name="chevron-back" Size="1.4rem" /></a>
            <h1 class="topbar__title">@L["matching.lobby.title"]</h1>
        </header>

        <section class="card card--taq enter" style="text-align:center">
            <p class="muted" style="margin:0;font-size:var(--step--1)">@L["lobby.shareCode"]</p>
            <p class="lobby-code" dir="ltr">@view.Code</p>
            <p class="muted" style="margin:0">@L.Format("matching.lobby.summary", L.Num(view.TotalSlots), L.Num(view.Capacity))</p>
        </section>

        <section class="enter" style="margin-top:1.2rem">
            <div class="row row--between" style="align-items:baseline;margin-bottom:.7rem">
                <strong>@L["matching.lobby.players"]</strong>
                <span class="muted">@L.Num(view.Participants.Count) / @L.Num(view.Capacity)</span>
            </div>
            <div class="lobby-grid" style="--lobby-cols:3">
                @foreach (var participant in view.Participants)
                {
                    <div class="lobby-tile" @key="participant.Id">
                        <span class="avatar avatar--tile" style="background:@Ranks.Tint(participant.AvatarSeed ?? participant.Id)">@Initial(participant.DisplayName)</span>
                        <span dir="auto" style="font-weight:700;font-size:var(--step--1)">@participant.DisplayName</span>
                        <span class="muted" style="font-size:var(--step--1)">@(participant.Id == view.Participants[0].Id ? L["lobby.seatHost"] : L["lobby.seatReady"])</span>
                    </div>
                }
            </div>
        </section>

        <section class="card enter" style="margin-top:1rem">
            <div class="row row--between"><strong>@L["matching.lobby.settings"]</strong><span class="chip chip--live">@L["home.modeMatching"]</span></div>
            <p class="muted" style="margin:.5rem 0 0">@L.Format("lobby.settingsLine", L.Num(view.TotalSlots), L["lang." + view.Lang])</p>
            @if (owner)
            {
                <div class="count-row" role="group" aria-label="@L["home.length"]" style="margin-top:.8rem">
                    @foreach (var count in QuestionCounts)
                    {
                        <button type="button" class="count-row__option @(_questions == count ? "is-on" : null)"
                                aria-pressed="@(_questions == count).ToString().ToLowerInvariant()"
                                disabled="@_busy" @onclick="() => _questions = count">@L.Num(count)</button>
                    }
                </div>
                <div class="script-tiles" role="group" aria-label="@L["lang.pick"]" style="margin-top:.7rem">
                    @foreach (var lang in Translator.All)
                    {
                        <button type="button" class="script-tile @(_lang == lang ? "is-on" : null)"
                                aria-pressed="@(_lang == lang).ToString().ToLowerInvariant()"
                                disabled="@_busy" @onclick="() => _lang = lang">@L["lang." + lang]</button>
                    }
                </div>
                <div class="row row--between" style="margin-top:.9rem;align-items:baseline">
                    <span class="muted">@L["matching.lobby.categories"]</span>
                    @if (_categoryIds.Count > 0)
                    {
                        <button type="button" class="any-pill" @onclick="ClearCategories">@L["matching.lobby.anyCategories"]</button>
                    }
                </div>
                @if (_categories.Count > 0)
                {
                    <div class="topic-grid" style="margin-top:.55rem">
                        @foreach (var category in _categories)
                        {
                            var selected = _categoryIds.Contains(category.Id);
                            <button type="button" class="topic-tile @(selected ? "is-on" : null)"
                                    aria-pressed="@selected.ToString().ToLowerInvariant()"
                                    @onclick="() => ToggleCategory(category.Id)">
                                <span class="topic-tile__icon" aria-hidden="true">@category.Icon</span>
                                <span class="topic-tile__name" dir="auto">@CategoryName(category)</span>
                                @if (selected)
                                {
                                    <span class="topic-tile__check" aria-hidden="true">✓</span>
                                }
                            </button>
                        }
                    </div>
                }
                <div class="row row--between" style="margin-top:.7rem">
                    <span class="muted">@L["matching.lobby.players"]</span>
                    <span class="row" style="gap:.4rem">
                        <button type="button" class="btn btn--ghost btn--pill" disabled="@(_capacity <= view.Participants.Count || _busy)" @onclick="() => _capacity--">−</button>
                        <span class="numeral">@L.Num(_capacity)</span>
                        <button type="button" class="btn btn--ghost btn--pill" disabled="@(_capacity >= 8 || _busy)" @onclick="() => _capacity++">+</button>
                    </span>
                </div>
                <button type="button" class="btn btn--ghost btn--block" style="margin-top:.8rem" disabled="@_busy" @onclick="SaveSettingsAsync">@L["questions.done"]</button>
            }
            else
            {
                <div class="row row--between" style="margin-top:.8rem;align-items:baseline">
                    <span class="muted">@L["matching.lobby.categories"]</span>
                    <span dir="auto">@SelectedCategoryText()</span>
                </div>
            }
        </section>

        @if (_error is not null) { <div class="notice notice--bad enter">@_error</div> }
        <div class="stack enter" style="margin-top:1.2rem">
            @if (owner)
            {
                <button class="btn btn--block" disabled="@(view.Participants.Count < 2 || _busy)" @onclick="StartAsync">@L["lobby.start"]</button>
                <button class="lobby-quiet" disabled="@_busy" @onclick="LeaveAsync">@L["lobby.leaveOwner"]</button>
            }
            else if (seated)
            {
                <button class="btn btn--block" disabled>@L["lobby.waitingForOwner"]</button>
                <button class="lobby-quiet" disabled="@_busy" @onclick="LeaveAsync">@L["lobby.leave"]</button>
            }
            else
            {
                <button class="btn btn--block" disabled="@(view.Participants.Count >= view.Capacity || _busy)" @onclick="TakeSeatAsync">@L["lobby.takeSeat"]</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
    protected override bool AllowsGuest => true;

    private MatchingViewDto? _view;
    private LiveClient? _client;
    private bool _busy;
    private string? _error;
    private string _lang = "en";
    private int _questions = 10, _capacity = 2;
    private List<MatchingCategoryDto> _categories = [];
    private List<string> _categoryIds = [];
    private static readonly int[] QuestionCounts = [10, 20, 30, 40, 50, 100];
    private string MeId => State.Me!.Id;

    protected override async Task LoadAsync()
    {
        _view = await Api.MatchingByCodeAsync(Code);
        if (_view is null) return;
        _lang = _view.Lang;
        _questions = _view.TotalSlots;
        _capacity = _view.Capacity;
        _categoryIds = [.. _view.CategoryIds ?? []];
        _categories = await Api.MatchingCategoriesAsync(_view.Lang) ?? [];
        if (_view.State is not "awaitingopponent" and not "awaiting_opponent")
        {
            Nav.NavigateTo($"/matching/{_view.Id}", replace: true);
            return;
        }
        if (_view.Participants.Any(p => p.Id == MeId)) await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        _client = ClientFactory("hub/live");
        _client.MatchingRosterChanged += OnRosterChanged;
        if (await _client.StartAndJoinMatchingAsync(_view!.Id)) return;
    }

    private void OnRosterChanged() => _ = InvokeAsync(async () =>
    {
        _view = await Api.MatchingAsync(_view!.Id);
        if (_view is not null && _view.State is not "awaitingopponent" and not "awaiting_opponent")
            Nav.NavigateTo($"/matching/{_view.Id}", replace: true);
        StateHasChanged();
    });

    private async Task TakeSeatAsync()
    {
        if (_view is null) return;
        _busy = true;
        var joined = await Api.JoinMatchingAsync(_view.Code);
        _busy = false;
        if (joined is null) { _error = L["common.error"]; return; }
        _view = joined;
        await ConnectAsync();
    }

    private async Task StartAsync()
    {
        if (_view is null) return;
        _busy = true;
        var ok = await Api.StartMatchingAsync(_view.Id);
        _busy = false;
        if (ok) Nav.NavigateTo($"/matching/{_view.Id}"); else _error = L["common.error"];
    }

    private async Task SaveSettingsAsync()
    {
        if (_view is null) return;
        _busy = true;
        var ok = await Api.UpdateMatchingSettingsAsync(_view.Id, _capacity, _lang, _categoryIds, _questions);
        _busy = false;
        if (!ok) { _error = L["common.error"]; return; }
        _view = await Api.MatchingAsync(_view.Id);
        _categoryIds = [.. _view?.CategoryIds ?? _categoryIds];
    }

    private void ToggleCategory(string id)
        => _categoryIds = _categoryIds.Contains(id)
            ? [.. _categoryIds.Where(category => category != id)]
            : [.. _categoryIds, id];

    private void ClearCategories() => _categoryIds = [];

    private string CategoryName(MatchingCategoryDto category) => _lang switch
    {
        "fa" => Pick(category.NameFa, category.NameEn),
        "nl" => Pick(category.NameNl, category.NameEn),
        _ => Pick(category.NameEn, category.NameFa)
    };

    private static string Pick(string first, string second) => first.Length > 0 ? first : second;

    private string SelectedCategoryText()
    {
        if (_categoryIds.Count == 0) return L["matching.lobby.anyCategories"];
        var names = _categories.Where(category => _categoryIds.Contains(category.Id)).Select(CategoryName).ToList();
        return names.Count == 0 ? string.Join(", ", _categoryIds) : string.Join(", ", names);
    }

    private async Task LeaveAsync()
    {
        if (_view is null) return;
        _busy = true;
        await Api.LeaveMatchingAsync(_view.Id);
        _busy = false;
        Nav.NavigateTo("/play");
    }

    private static string Initial(string name) => name.Length > 0 ? name[..1].ToUpperInvariant() : "?";

    public async ValueTask DisposeAsync()
    {
        if (_client is null) return;
        _client.MatchingRosterChanged -= OnRosterChanged;
        try { await _client.LeaveAsync(); } catch { }
        await _client.DisposeAsync();
    }
}
