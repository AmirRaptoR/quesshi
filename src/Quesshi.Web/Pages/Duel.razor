@page "/duel/{MatchId}"
@inherits PageBase

<PageTitle>@Headline · @L["app.name"]</PageTitle>

<div class="shell">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_detail is null)
    {
        <div class="empty">
            <p>@L["common.error"]</p>
            <a class="btn btn--ghost" href="/">@L["common.back"]</a>
        </div>
    }
    else
    {
        var summary = _detail.Summary;

        <section class="card card--taq enter" style="text-align:center">
            <h2>@Headline</h2>

            <div style="width:min(17rem,80%);margin:1.1rem auto .5rem">
                <Shamseh Mine="@Mine" Theirs="@Theirs" Slots="@summary.Questions" HideTheirs="@(!summary.CanReveal)" Ignite="true"
                         Centre="@(summary.CanReveal ? L.Num(summary.Me.Score) : "…")" />
            </div>

            @if (_detail.Standings.Count > 0)
            {
                @* The match is over: every participant's real placement replaces the plain
                   you/them pair, whether this duel ever had exactly two seats or up to eight —
                   see StandingsList's own remarks. *@
                <div style="margin-top:1rem">
                    <StandingsList Rows="_detail.Standings" MeId="@MeId" />
                </div>
            }
            else
            {
                <div class="row row--between" style="margin-top:1rem">
                    <div style="text-align:start">
                        <div class="faint" style="font-size:var(--step--1)">@L["result.you"]</div>
                        <div class="numeral" style="font-size:var(--step-2);color:var(--zaferan)">@L.Num(summary.Me.Score)</div>
                    </div>
                    <div style="text-align:end">
                        <div class="faint" style="font-size:var(--step--1)">@(summary.Opponent?.DisplayName ?? L["result.them"])</div>
                        <div class="numeral" style="font-size:var(--step-2)">
                            @(summary.CanReveal && summary.Opponent is not null ? L.Num(summary.Opponent.Score) : "—")
                        </div>
                    </div>
                </div>
            }
        </section>

        @if (!summary.CanReveal)
        {
            <p class="empty enter">@L["result.pendingHint"]</p>
        }

        @if (_detail.Reveal.Count > 0)
        {
            <section class="enter" style="margin-top:1rem">
                <h3>@L["result.review"]</h3>
                <div class="stack" style="margin-top:.6rem">
                    @foreach (var row in _detail.Reveal)
                    {
                        <article class="card card--flat">
                            <div class="row row--between" style="gap:.5rem">
                                <span class="faint" style="font-size:var(--step--1)">@row.CategoryName</span>
                                <span class="faint numeral" style="font-size:var(--step--1)">@L.Num(row.Slot + 1)</span>
                            </div>

                            <p dir="auto" style="margin:.4rem 0 .7rem;font-weight:600">@row.Prompt</p>

                            <MediaBlock Media="row.Media" Loop="false" Autoplay="false" />

                            @* A sorting question's Choices are its answer: this contract carries them
                               in stored order, and stored order is correct order — which is why there
                               is no second copy of them here and why each side's response indexes
                               straight into them. A map question leaves Choices empty and puts the
                               answer in CorrectTarget instead. The choice markup below is unchanged. *@
                            @if (row.Kind == 1)
                            {
                                <SortReveal CorrectOrder="row.Choices" Columns="SortColumnsFor(row)" />
                            }
                            else if (row.Kind == 2)
                            {
                                <MapReveal CorrectTarget="@row.CorrectTarget" Answers="MapAnswersFor(row)" />
                            }
                            else
                            {
                            <div class="stack" style="gap:.35rem">
                                @for (var i = 0; i < row.Choices.Count; i++)
                                {
                                    var index = i;
                                    <div class="row" dir="auto" style="gap:.5rem;font-size:var(--step--1)">
                                        <span style="color:@(index == row.CorrectIndex ? "var(--zaferan)" : "var(--sadaf-3)")">
                                            @(index == row.CorrectIndex ? "●" : "○")
                                        </span>
                                        <span class="grow @(index == row.CorrectIndex ? null : "faint")">@row.Choices[index]</span>
                                        @if (row.MyChoice == index) { <span class="chip chip--live">@L["result.you"]</span> }
                                        @if (row.TheirChoice == index) { <span class="chip">@L["result.them"]</span> }
                                    </div>
                                }
                            </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(row.Explanation))
                            {
                                <p class="muted" dir="auto" style="margin:.7rem 0 0;font-size:var(--step--1)">@row.Explanation</p>
                            }

                            <div style="margin-top:.6rem">
                                <ReportQuestion QuestionId="@row.QuestionId" />
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        <div class="stack enter" style="margin-top:1.2rem">
            @if (summary.CanPlay)
            {
                <a class="btn btn--block" href="/play/@summary.Id">@L["play.next"]</a>
            }

            @if (State.IsGuest)
            {
                @* The only route onward a guest has is to stop being one. *@
                <a class="btn btn--ghost btn--block" href="/signin">@L["result.keepScore"]</a>
                <p class="faint" style="margin:-.4rem 0 0;text-align:center;font-size:var(--step--1)">@L["result.guestHint"]</p>
            }
            else
            {
                <a class="btn btn--ghost btn--block" href="/">@L["result.again"]</a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string MatchId { get; set; } = "";

    /// <summary>The result of their one duel: the last thing a guest is shown, and the only thing left.</summary>
    protected override bool AllowsGuest => true;

    private MatchDetailDto? _detail;

    private string MeId => State.Me!.Id;

    /// <summary>
    /// Issue #53: a duel still <c>AwaitingOpponent</c> has no result to show at all — that is now
    /// <c>/lobby/{code}</c>'s job, roster and share code both, replacing the inline "waiting for an
    /// opponent" card this page used to render when <c>summary.Opponent</c> was null. Every other
    /// state (in progress, resolved, forfeited, ...) renders here exactly as before.
    /// </summary>
    protected override async Task LoadAsync()
    {
        _detail = await Api.MatchAsync(MatchId);
        if (_detail is { Summary.State: "awaitingopponent" })
            Nav.NavigateTo($"/lobby/{_detail.Summary.Code}", replace: true);
    }

    /// <summary>
    /// Both sides of a revealed sorting question, mine first. "Them" is only a column when there is
    /// somebody to be them: an unfinished or single-seat duel renders the correct order and my own
    /// beside it rather than an empty column captioned with the opponent that does not exist.
    /// </summary>
    private List<SortRevealColumn> SortColumnsFor(RevealedQuestionDto row)
    {
        List<SortRevealColumn> columns = [new(L["result.you"], AnswerReveal.PlacedItems(row.Choices, row.MyResponse))];

        if (_detail?.Summary.Opponent is not null)
            columns.Add(new(L["result.them"], AnswerReveal.PlacedItems(row.Choices, row.TheirResponse)));

        return columns;
    }

    /// <inheritdoc cref="SortColumnsFor"/>
    private List<MapAnswerLine> MapAnswersFor(RevealedQuestionDto row)
    {
        List<MapAnswerLine> lines =
            [new(L["result.you"], row.MyResponse, AnswerReveal.IsRight(row.Kind, row.CorrectIndex, row.CorrectTarget, row.MyChoice, row.MyResponse))];

        if (_detail?.Summary.Opponent is not null)
            lines.Add(new(L["result.them"], row.TheirResponse,
                AnswerReveal.IsRight(row.Kind, row.CorrectIndex, row.CorrectTarget, row.TheirChoice, row.TheirResponse)));

        return lines;
    }

    private string Headline => _detail?.Summary.Outcome switch
    {
        "win" => L["result.win"],
        "loss" => L["result.loss"],
        "draw" => L["result.draw"],
        _ => L["result.pending"]
    };

    // Once revealed we colour by right/wrong; before that the rays only show how far each side got.
    private IReadOnlyList<bool?> Mine => RaysFor(_detail?.Summary.Me, mine: true);
    private IReadOnlyList<bool?> Theirs => RaysFor(_detail?.Summary.Opponent, mine: false);

    private IReadOnlyList<bool?> RaysFor(PlayerSideDto? side, bool mine)
    {
        if (side is null) return [];

        // Right or wrong is per-kind now, and for one kind it is not knowable from here at all:
        // AnswerReveal.IsRight returns null for a city target, whose verdict depends on a tolerance
        // radius no reveal contract carries. A null ray reads as "not reached", which is a small
        // inaccuracy on a decorative rosette and much better than asserting a wrong answer.
        if (_detail?.Reveal.Count > 0)
            return [.. _detail.Reveal.Select(r => AnswerReveal.IsRight(
                r.Kind, r.CorrectIndex, r.CorrectTarget,
                mine ? r.MyChoice : r.TheirChoice,
                mine ? r.MyResponse : r.TheirResponse))];

        return [.. Enumerable.Range(0, _detail?.Summary.Questions ?? 6)
            .Select(i => i < side.Correct ? (bool?)true : i < side.Answered ? false : null)];
    }
}
