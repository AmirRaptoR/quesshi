@page "/lobby/{Code}"
@inherits PageBase
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject Func<string, LiveClient> ClientFactory
@inject LobbyClient LobbyConnection

@*
    Issue #53's original note still holds: this is the lobby page for both duel kinds, and Duel.razor
    /Live.razor redirect here the moment they see a duel still sitting in its lobby phase rather than
    rendering a "waiting for an opponent" card of their own.

    Issue #90 rewrites what this page actually shows, though — "code first, faces not rows" (see its
    mockup). The old page asked a visitor to read a roster of name rows, a full duel-settings picker
    and a share-code card in that order; the code is the one thing that actually gets someone here
    (nobody opens a lobby without either creating it or being handed its code), so it leads, drawn
    large enough to read at arm's length. The roster becomes a grid of face tiles — a host, a few
    "Ready" seats, an open "+" — because a room of people is a thing you look at, not a list you read.
    Editing a duel's settings moves out of this page entirely: the picker that used to render inline
    here is gone, replaced by one collapsed line ("10 questions · English") that opens issue #89's own
    settings sheet at /play/questions for the owner. Guest identity editing and the "keep this
    account" upgrade stay exactly where they were, just without the ALL-CAPS eyebrow label every
    section used to carry.
*@

<PageTitle>@L["lobby.title"] · @L["app.name"]</PageTitle>

<div class="shell">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_snapshot is null)
    {
        <div class="empty">
            <p>@L["join.noSuchCode"]</p>
            <a class="btn btn--ghost" href="/">@L["common.back"]</a>
        </div>
    }
    else if (!_snapshot.Waiting)
    {
        @* Past lobby phase, and a snapshot at all means the read returned one -- the read refuses a
           non-participant here (404), so reaching this branch already means the caller is seated.
           No redirect on the initial load (issue #104): a Back press into a started duel must render
           this card, not bounce straight back into the duel and make Back unusable. *@
        <div class="empty enter">
            <p>@L["lobby.alreadyStarted"]</p>
            <a class="btn btn--block" href="@LobbyPresentation.TargetRoute(_snapshot)">@L["lobby.goToDuel"]</a>
        </div>
    }
    else
    {
        var snapshot = _snapshot;
        var seats = LobbyPresentation.Seats(snapshot);
        var isOwner = LobbyPresentation.IsOwner(snapshot, MeId);
        var columns = LobbyPresentation.RosterColumns(snapshot);

        @* --- header: back, title, and (for a live lobby only) its own countdown ----------------- *@
        <header class="topbar enter">
            <a class="lobby-back" href="/play" aria-label="@L["common.back"]">
                <Icon Name="chevron-back" Size="1.4rem" />
            </a>
            <h1 class="topbar__title">@L["lobby.title"]</h1>
            <div class="topbar__spacer"></div>
            @if (LobbyExpiry is { Length: > 0 } expiry)
            {
                <span class="muted" style="font-size:var(--step--1)">@expiry</span>
            }
        </header>

        @* --- the code leads: the only reason most visitors are on this page at all -------------- *@
        <div class="enter" style="text-align:center;margin-top:.5rem">
            <p class="muted" style="margin:0;font-size:var(--step--1)">@L["lobby.shareCode"]</p>
            <p class="lobby-code" dir="ltr">@snapshot.Code</p>
            <div class="row" style="justify-content:center;gap:.5rem;margin-top:.2rem">
                <button type="button" class="btn btn--ghost btn--pill" @onclick="CopyAsync">
                    @(_copied ? L["lobby.copied"] : L["lobby.copyLink"])
                </button>
                <button type="button" class="btn btn--ghost btn--pill" @onclick="ShareAsync">@L["lobby.share"]</button>
            </div>
        </div>

        @* --- roster: face tiles, host/ready/open — not rows to read ----------------------------- *@
        <section class="enter" style="margin-top:1.9rem">
            <div class="row row--between" style="align-items:baseline;margin-bottom:.75rem">
                <span style="font-size:var(--step-0);font-weight:700">
                    @L.Format("lobby.rosterCount", L.Num(snapshot.Participants.Count), L.Num(snapshot.Capacity))
                </span>
                @if (isOwner)
                {
                    @* The seat stepper (issue #104): owner-only, capacity 2-8 and never below the
                       seated count -- CapacityStepMin/MaxCapacity mirror the domain's own bounds so a
                       disabled end here means the server would refuse it too. *@
                    <span class="row" style="gap:.35rem">
                        <button type="button" class="btn btn--ghost btn--pill" style="padding:.15rem .6rem"
                                disabled="@(snapshot.Capacity <= LobbyPresentation.CapacityStepMin(snapshot) || _busy)"
                                @onclick="() => ChangeCapacityAsync(-1)">−</button>
                        <button type="button" class="btn btn--ghost btn--pill" style="padding:.15rem .6rem"
                                disabled="@(snapshot.Capacity >= LobbyPresentation.MaxCapacity || _busy)"
                                @onclick="() => ChangeCapacityAsync(1)">+</button>
                    </span>
                    <a class="lobby-settings-line" href="@SettingsSheet(snapshot)">@SettingsLine</a>
                }
                else
                {
                    <span class="muted" style="font-size:var(--step--1)">@SettingsLine</span>
                }
            </div>
            <div class="lobby-grid" style="--lobby-cols:@columns">
                @foreach (var seat in seats)
                {
                    var state = LobbyPresentation.SeatStateFor(snapshot, seat);
                    @if (seat is null)
                    {
                        <div class="lobby-tile lobby-tile--open">
                            <span class="lobby-tile__plus" aria-hidden="true">+</span>
                            <span class="faint" style="font-size:var(--step--1)">@L["lobby.openSeat"]</span>
                        </div>
                    }
                    else
                    {
                        <div class="lobby-tile" @key="seat.PlayerId">
                            <span class="avatar avatar--tile" style="background:@Ranks.Tint(seat.Avatar)">@Initial(seat.Name)</span>
                            <span dir="auto" style="font-weight:700;font-size:var(--step--1)">@seat.Name</span>
                            <span style="font-size:var(--step--1);color:@(state == LobbyPresentation.SeatState.Host ? "var(--zaferan)" : "var(--sadaf-3)")">
                                @(state == LobbyPresentation.SeatState.Host ? L["lobby.seatHost"] : L["lobby.seatReady"])
                            </span>
                        </div>
                    }
                }
            </div>
        </section>

        @* --- invite a friend: an avatar row, tapped rather than read out of a list -------------- *@
        @if (isOwner)
        {
            <section class="enter" style="margin-top:1.7rem">
                <div style="font-size:var(--step-0);font-weight:700;margin-bottom:.6rem">@L["lobby.invite.title"]</div>
                @if (!seats.Any(s => s is null))
                {
                    <p class="faint" style="margin:0;font-size:var(--step--1)">@L["lobby.invite.full"]</p>
                }
                else if (_friends.Count == 0)
                {
                    <p class="faint" style="margin:0;font-size:var(--step--1)">@L["lobby.invite.empty"]</p>
                }
                else
                {
                    <div class="lobby-friends">
                        @foreach (var friend in _friends)
                        {
                            var state = LobbyPresentation.InviteState(snapshot, friend, _invited.Contains(friend.Id));
                            @if (state == LobbyPresentation.InviteTileState.Available)
                            {
                                <button type="button" class="lobby-friend" disabled="@(_inviting == friend.Id)"
                                        aria-label="@($"{L["lobby.invite.button"]} {friend.DisplayName}")"
                                        @onclick="() => InviteAsync(friend.Id)" @key="friend.Id">
                                    <span class="lobby-friend__avatar-wrap">
                                        <span class="avatar avatar--tile" style="background:@Ranks.Tint(friend.AvatarSeed)">@Initial(friend.DisplayName)</span>
                                        @if (friend.Online) { <span class="lobby-friend__dot" title="@L["profile.online"]"></span> }
                                    </span>
                                    <span style="font-size:var(--step--1)">@friend.DisplayName</span>
                                </button>
                            }
                            else
                            {
                                <div class="lobby-friend lobby-friend--dim" @key="friend.Id">
                                    @* No online dot once a tile has stopped being an invitation: joined,
                                       invited or link-only all say something more useful than presence. *@
                                    <span class="lobby-friend__avatar-wrap">
                                        <span class="avatar avatar--tile" style="background:@Ranks.Tint(friend.AvatarSeed)">@Initial(friend.DisplayName)</span>
                                    </span>
                                    <span class="faint" style="font-size:var(--step--1)">
                                        @(state switch
                                        {
                                            LobbyPresentation.InviteTileState.Joined => L["lobby.invite.joined"],
                                            LobbyPresentation.InviteTileState.LinkOnly => L["lobby.invite.linkOnly"],
                                            _ => L["lobby.invite.invited"],
                                        })
                                    </span>
                                </div>
                            }
                        }
                    </div>
                }
                @if (_inviteError is not null) { <div class="notice notice--bad" style="margin-top:.6rem">@_inviteError</div> }
            </section>
        }

        @* --- guest identity: the one moment a guest cares about their name and avatar ----------- *@
        @if (State.IsGuest)
        {
            <section class="card enter" style="margin-top:1.7rem">
                <div style="font-size:var(--step-0);font-weight:700">@L["lobby.identity"]</div>
                <div class="stack" style="margin-top:.8rem">
                    <input class="input" maxlength="24" @bind="_identity.DisplayName" @bind:event="oninput"
                           placeholder="@L["join.yourName"]" aria-label="@L["join.yourName"]" />

                    <div class="field">
                        <label>@L["lobby.avatarLabel"]</label>
                        <div class="picker">
                            @foreach (var seed in AvatarPalette.Seeds)
                            {
                                var pick = seed;
                                <button type="button" class="picker__chip @(_identity.AvatarSeed == pick ? "is-on" : null)"
                                        style="--pick:@Ranks.Tint(pick)" aria-pressed="@((_identity.AvatarSeed == pick).ToString().ToLowerInvariant())"
                                        @onclick="() => _identity.AvatarSeed = pick">
                                    <span class="avatar avatar--sm" style="background:@Ranks.Tint(pick)"></span>
                                </button>
                            }
                        </div>
                    </div>

                    <button class="btn btn--block" disabled="@(!_identity.IsValid || _savingIdentity)" @onclick="SaveIdentityAsync">
                        @(_identitySaved ? L["profile.saved"] : L["profile.save"])
                    </button>
                    @if (_identityError is not null) { <div class="notice notice--bad">@_identityError</div> }
                </div>
            </section>

            @* --- keep this account: the upgrade (issue #55) --------------------------------------
               Right below the name/avatar card rather than folded into it: that one is an instant,
               reversible edit, this is a two-step flow with its own error states (a wrong code, an
               address somebody else already owns) — different enough shapes to earn their own card,
               placed where a guest has just finished deciding who they look like and is already
               thinking about whether this seat is theirs to keep. Disappears on its own the moment it
               succeeds: State.SignInAsync clears IsGuest, which is this whole section's guard. *@
            <section class="card enter">
                <div style="font-size:var(--step-0);font-weight:700">@L["lobby.upgrade.title"]</div>
                <p class="faint" style="margin-top:.4rem">@L["lobby.upgrade.blurb"]</p>

                <div class="stack" style="margin-top:.8rem">
                    @if (_upgradeStage == UpgradeStage.Email)
                    {
                        <input class="input" type="email" inputmode="email" autocomplete="email" dir="ltr"
                               @bind="_upgradeEmail" @bind:event="oninput" placeholder="you@example.com"
                               aria-label="@L["auth.email"]" />

                        <button class="btn btn--block" disabled="@(_upgradeBusy || !LooksLikeUpgradeEmail)" @onclick="SendUpgradeCodeAsync">
                            @(_upgradeBusy ? L["common.loading"] : L["auth.send"])
                        </button>
                    }
                    else
                    {
                        <p class="faint" dir="ltr" style="margin:0">@_upgradeEmail</p>
                        <input class="input code-input" inputmode="numeric" maxlength="6" dir="ltr" autocomplete="one-time-code"
                               @bind="_upgradeCode" @bind:event="oninput" aria-label="@L["auth.code"]" />

                        <button class="btn btn--block" disabled="@(_upgradeBusy || _upgradeCode.Length != 6)" @onclick="VerifyUpgradeAsync">
                            @(_upgradeBusy ? L["common.loading"] : L["auth.verify"])
                        </button>
                        <button class="btn btn--ghost btn--block btn--sm" disabled="@_upgradeBusy" @onclick="() => _upgradeStage = UpgradeStage.Email">
                            @L["auth.back"]
                        </button>
                    }

                    @if (_upgradeError is not null)
                    {
                        <div class="notice notice--bad">
                            @_upgradeError
                            @if (_upgradeTaken)
                            {
                                <a href="/signin">@L["auth.title"]</a>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @if (_error is not null) { <div class="notice notice--bad enter">@_error</div> }

        @* --- one primary button: what happens next, said once ---------------------------------- *@
        <div class="enter" style="margin-top:1.7rem">
            @if (isOwner)
            {
                <button class="btn btn--block" disabled="@(!LobbyPresentation.CanStart(snapshot, MeId) || _busy)" @onclick="StartAsync">
                    @L["lobby.start"]
                </button>
                <p class="faint" style="margin:.6rem 0 0;text-align:center;font-size:var(--step--1)">@L["lobby.startHint"]</p>
                <button type="button" class="lobby-quiet" disabled="@_busy" @onclick="LeaveAsync">@L["lobby.leaveOwner"]</button>
            }
            else if (LobbyPresentation.IsParticipant(snapshot, MeId))
            {
                @* Disabled rather than hidden: this is the same "here is what happens next" slot the
                   owner's own button fills, just one this visitor cannot press themselves. *@
                <button class="btn btn--block" disabled>@L["lobby.waitingForOwner"]</button>
                <button type="button" class="lobby-quiet" disabled="@_busy" @onclick="LeaveAsync">@L["lobby.leave"]</button>
            }
            else
            {
                @* An unseated visitor: nothing to leave, so no second button here -- only take-a-seat,
                   disabled once the lobby is full (issue #104). *@
                var full = LobbyPresentation.IsFull(snapshot);
                <button class="btn btn--block" disabled="@(full || _busy)" @onclick="TakeSeatAsync">@L["lobby.takeSeat"]</button>
                @if (full)
                {
                    <p class="faint" style="margin:.6rem 0 0;text-align:center;font-size:var(--step--1)">@L["lobby.invite.full"]</p>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Code { get; set; } = "";

    /// <summary>A guest arriving by link lands here — see the guest identity card above.</summary>
    protected override bool AllowsGuest => true;

    private LobbySnapshot? _snapshot;
    private LiveClient? _client;
    private GuestIdentityForm _identity = new();
    private bool _copied, _busy, _savingIdentity, _identitySaved;
    private string? _error, _identityError;

    /// <summary>The owner's own friends list, fetched once on load — fresh online status and
    /// <c>IsGuest</c>, the same way Profile.razor's own list is. Empty for anyone who is not the
    /// owner: nobody else sees the invite section at all, so nothing else ever populates this.</summary>
    private List<FriendDto> _friends = [];

    /// <summary>Friend ids this owner has sent an in-app invitation to during this visit — cleared on
    /// reload, not persisted. Re-inviting somebody already invited costs nothing (see
    /// <c>ILiveMatchmakingGrain</c>'s own remarks on why an invitation carries no exclusivity), so
    /// there is nothing to protect by asking the server to remember this instead of the page itself.</summary>
    private readonly HashSet<string> _invited = [];

    private string? _inviting, _inviteError;

    /// <summary>The guest upgrade's own two-step flow (issue #55) — the same email-then-code shape
    /// <c>SignIn.razor</c> already uses, reusing that page's OTP endpoints and translation keys, but
    /// landing on <c>POST /api/me/upgrade</c> instead of <c>/otp/verify</c> at the finish.</summary>
    private enum UpgradeStage { Email, Code }

    private UpgradeStage _upgradeStage = UpgradeStage.Email;
    private string _upgradeEmail = "", _upgradeCode = "";
    private bool _upgradeBusy;
    private string? _upgradeError;

    /// <summary>Whether <see cref="_upgradeError"/> is the one reason worth a different call to
    /// action — the address is already somebody's account, so retrying gets nowhere and the message
    /// offers ordinary sign-in instead.</summary>
    private bool _upgradeTaken;

    /// <summary>The same loose heuristic <c>SignIn.razor</c>'s own <c>LooksLikeEmail</c> uses: enough to
    /// keep the button disabled on an obviously-unfinished address, not a real validator — the server
    /// (<c>EmailAddress.LooksValid</c>) is the actual check, same division every other form in this app
    /// draws between a client-side nicety and the source of truth.</summary>
    private bool LooksLikeUpgradeEmail => _upgradeEmail.Contains('@') && _upgradeEmail.Length > 4 && !_upgradeEmail.Contains(' ');

    private string MeId => State.Me!.Id;
    private string ShareLink => $"{Nav.BaseUri.TrimEnd('/')}/join/{_snapshot!.Code}";

    /// <summary>
    /// The settings summary collapsed to one glance — "10 questions · English" — which is all this
    /// page still says about a duel's shape now that changing it moves to issue #89's own sheet at
    /// <c>/play/questions</c>. The same text renders for everyone; only the owner's copy is also the
    /// link that opens that sheet (see the markup above).
    /// </summary>
    /// <summary>
    /// Where the owner's copy of that line leads: issue #89's questions sheet, opened on *this
    /// lobby's* settings rather than on the player's last-used ones (they are not the same thing — a
    /// lobby is a room that already exists), told where to come back to, and told which lobby to put
    /// the answer to. The sheet does that through the endpoint the inline picker this line replaced
    /// already used, so the room the owner is standing in actually changes when they press Done.
    /// </summary>
    private static string SettingsSheet(LobbySnapshot snapshot)
        => QuestionsDraft.From(snapshot.Settings, $"/lobby/{snapshot.Code}", snapshot.MatchId, snapshot.IsLive)
            .LinkTo("/play/questions");

    private string SettingsLine => _snapshot is null ? ""
        : L.Format("lobby.settingsLine", L.Num(_snapshot.Settings.QuestionCount), L["lang." + _snapshot.Settings.Lang]);

    /// <summary>
    /// How long this lobby has left, in whichever unit reads as a duration rather than a number. The
    /// seconds form is inherited from the old live waiting screen, where a wait really was measured in
    /// them; a lobby lasts ten minutes, and "Closes in 588s" is arithmetic the reader has to do
    /// themselves. Minutes round up, so the label never says "0 min" while there is still time on the
    /// clock, and the last minute counts down in seconds where that precision starts to matter.
    /// </summary>
    private string LobbyExpiry
    {
        get
        {
            if (_snapshot?.LobbyEndsAt is not { } endsAt) return "";

            var seconds = RingClock.RemainingSeconds(endsAt, DateTimeOffset.UtcNow, TimeSpan.Zero);
            return seconds >= 60
                ? L.Format("lobby.closesInMinutes", L.Num((seconds + 59) / 60))
                : L.Format("lobby.closesIn", L.Num(seconds));
        }
    }

    protected override async Task LoadAsync()
    {
        _identity = State.Me is { } me ? GuestIdentityForm.From(me) : new GuestIdentityForm();
        if (!AvatarPalette.IsValid(_identity.AvatarSeed)) _identity.AvatarSeed = AvatarPalette.Seeds[0];

        // A guest who already belongs to a different duel never gets to take a second seat by
        // wandering onto someone else's link — the same rule Join.razor's own reopen-check applies,
        // read the other way: this is the one page that would otherwise actually seat them.
        if (State.IsGuest && State.GuestMatchId is { Length: > 0 } mine)
        {
            var invite = await Api.InviteAsync(Code);
            if (invite is null || invite.Live != State.GuestMatchIsLive || !await BelongsToMeAsync(mine))
            {
                Nav.NavigateTo(State.GuestMatchIsLive ? $"/live/{mine}" : $"/duel/{mine}", replace: true);
                return;
            }
        }

        // The initial load reads without redirecting (issue #104): a Back press into a duel that has
        // already left its lobby phase must render the "already started" card, not bounce straight
        // back into the duel the way every later refresh still does (see RefreshAsync's own remarks).
        if (!await ReadAsync() || _snapshot is not { } snapshot) return;

        if (!LobbyPresentation.IsParticipant(snapshot, MeId)) return; // an unseated visitor: nothing more to fetch or connect

        // Only the owner ever renders the invite section, and only a real signed-in player ever owns
        // a lobby at all (creating one is refused for a guest well before this page exists) — so this
        // is never spent on a visitor who could not use it.
        if (snapshot.Waiting && LobbyPresentation.IsOwner(snapshot, MeId)) _friends = (await Api.MeAsync())?.Friends ?? [];

        // An unseated visitor's socket stays closed (issue #104): LiveHub.Join refuses anyone not a
        // participant anyway, and a duel already past its lobby phase has nothing left to push here.
        if (snapshot.Waiting) await ConnectAsync();
    }

    /// <summary>
    /// Sends <paramref name="friendId"/> a plain in-app invitation into this lobby via
    /// <c>LobbyHub.InviteToLobby</c>. Unlike the owner action methods below, this never re-fetches the
    /// lobby afterwards: sending an invitation changes nothing about the lobby itself, only who has
    /// been told about it — the roster updates on its own, via the same <see cref="OnLobbyUpdated"/>
    /// push every other join already drives, once (if) the friend actually accepts.
    /// </summary>
    private async Task InviteAsync(string friendId)
    {
        if (_snapshot is null || _inviting is not null) return;

        _inviting = friendId;
        _inviteError = null;
        try
        {
            // 0 mirrors Quesshi.Domain.LiveChallengeResult.Sent — Quesshi.Web has no reference to
            // Quesshi.Domain (every hub call already crosses this boundary as a bare int; see
            // LobbyClient.InviteToLobbyAsync's own remarks), so the one value this page acts on is
            // named here instead of shared as a type.
            const int sent = 0;
            var result = await LobbyConnection.InviteToLobbyAsync(friendId, _snapshot.MatchId);
            if (result == sent) _invited.Add(friendId);
            else _inviteError = L["common.error"];
        }
        finally
        {
            _inviting = null;
        }
    }

    /// <summary>Whether the code this page was opened with actually resolves to the guest's own pinned
    /// duel — checked by asking, rather than guessed from the code alone, since a code and a match id
    /// live in different namespaces.</summary>
    private async Task<bool> BelongsToMeAsync(string myMatchId)
    {
        if (State.GuestMatchIsLive)
        {
            var live = await Api.LiveAsync(myMatchId);
            return live?.Code == Code;
        }

        var match = await Api.MatchAsync(myMatchId);
        return match?.Summary.Code == Code;
    }

    /// <summary>
    /// The read path (issue #104): resolves this page's code through the by-code read for its duel
    /// kind — no side effects, nothing joined, started, drawn or written — so a visitor who is not (or
    /// no longer) seated sees the lobby's actual state instead of a join call's 400. Which endpoint to
    /// call is only ever unknown on the very first call — a duel's kind never changes once created —
    /// so every later refresh skips the extra invite lookup and reuses what the first one learned.
    /// Never redirects itself; see <see cref="RefreshAsync"/> for the caller that does.
    /// </summary>
    private async Task<bool> ReadAsync()
    {
        bool isLive;
        if (_snapshot is { } known)
        {
            isLive = known.IsLive;
        }
        else
        {
            var invite = await Api.InviteAsync(Code);
            if (invite is null) return false;
            isLive = invite.Live;
        }

        if (isLive)
        {
            var view = await Api.LiveByCodeAsync(Code);
            if (view is null) return false;
            _snapshot = LobbyPresentation.From(view);
        }
        else
        {
            var summary = await Api.MatchByCodeAsync(Code);
            if (summary is null) return false;
            _snapshot = LobbyPresentation.From(summary);
        }

        return true;
    }

    /// <summary>
    /// Every refresh after the initial load — a <see cref="LiveClient.LobbyUpdated"/> push, the
    /// owner's own Start, a take-a-seat, or the guest identity save — redirects to
    /// <see cref="LobbyPresentation.TargetRoute"/> the moment the duel leaves its lobby phase, exactly
    /// as before issue #104. Only <see cref="LoadAsync"/> reads without this redirect, precisely so a
    /// Back press does not bounce straight back into the duel.
    /// </summary>
    private async Task<bool> RefreshAsync()
    {
        if (!await ReadAsync()) return false;
        if (!_snapshot!.Waiting) Nav.NavigateTo(LobbyPresentation.TargetRoute(_snapshot), replace: true);
        return true;
    }

    /// <summary>
    /// The explicit take-a-seat action (issue #104) — the only thing left in this page that actually
    /// joins. A lost race for the last seat (the join fails) is not an error: re-reading settles the
    /// page into the disabled full-lobby state on its own, with no generic error banner.
    /// </summary>
    private async Task TakeSeatAsync()
    {
        if (_snapshot is null || _busy) return;

        _busy = true;
        if (_snapshot.IsLive) await Api.JoinLiveAsync(_snapshot.Code); else await Api.JoinAsync(_snapshot.Code);
        await RefreshAsync();
        if (_snapshot is { Waiting: true } && LobbyPresentation.IsParticipant(_snapshot, MeId)) await ConnectAsync();
        _busy = false;
    }

    private async Task ConnectAsync()
    {
        if (_snapshot is null || _client is not null) return; // already connected -- take-a-seat can race a push here

        _client = ClientFactory("/hub/live");
        _client.LobbyUpdated += OnLobbyUpdated;

        try
        {
            await _client.StartAsync();
            if (_snapshot.IsLive) await _client.JoinAsync(_snapshot.MatchId);
            else await _client.JoinAsyncLobbyAsync(_snapshot.MatchId);
        }
        catch
        {
            // The initial fetch above already has us a usable snapshot; without the socket, the page
            // simply stops updating live and needs a reload to see anyone else's change.
        }
    }

    private void OnLobbyUpdated() => _ = InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    // --- owner actions: every one re-fetches afterwards, since none of these endpoints echoes the
    // resulting state back — the push every other viewer gets is this same re-fetch, run locally. ---

    private async Task StartAsync()
    {
        if (_snapshot is null || _busy) return;

        _busy = true; _error = null;
        var ok = await Api.StartLobbyAsync(_snapshot.MatchId, _snapshot.IsLive);
        if (ok) await RefreshAsync(); else _error = L["common.error"];
        _busy = false;
    }

    private async Task LeaveAsync()
    {
        if (_snapshot is null || _busy) return;

        _busy = true;
        await Api.LeaveLobbyAsync(_snapshot.MatchId, _snapshot.IsLive);
        Nav.NavigateTo("/");
    }

    /// <summary>
    /// The owner-only seat stepper (issue #104). Sends the lobby's own <em>current</em> settings
    /// alongside the new capacity — the coercion trap <see cref="UpdateDuelSettingsDto"/>'s own remarks
    /// warn about: an absent <c>Lang</c>/<c>Questions</c>/<c>Categories</c> on this endpoint is coerced
    /// to a default, not left alone, so a capacity-only change that omitted them would silently reset
    /// the lobby's question settings.
    /// </summary>
    private async Task ChangeCapacityAsync(int delta)
    {
        if (_snapshot is null || _busy) return;

        var next = _snapshot.Capacity + delta;
        if (next < LobbyPresentation.CapacityStepMin(_snapshot) || next > LobbyPresentation.MaxCapacity) return;

        _busy = true; _error = null;
        var settings = _snapshot.Settings;
        var ok = await Api.UpdateLobbySettingsAsync(_snapshot.MatchId, _snapshot.IsLive,
            new UpdateDuelSettingsDto(settings.Lang, settings.CategoryIds, settings.QuestionCount, settings.Levels, next));
        if (ok) await RefreshAsync(); else _error = L["common.error"];
        _busy = false;
    }

    private async Task SaveIdentityAsync()
    {
        if (!_identity.IsValid || _savingIdentity) return;

        _savingIdentity = true; _identityError = null; _identitySaved = false;
        var me = await Api.SaveProfileAsync(_identity.DisplayName.Trim(), State.Lang, _identity.AvatarSeed);
        _savingIdentity = false;

        if (me is null)
        {
            // Expected until issue #54 lands: PUT /api/me refuses a guest outright today (403).
            _identityError = L["common.error"];
            return;
        }

        State.SetMe(me);
        _identitySaved = true;
        await RefreshAsync(); // the roster reads this player's name/avatar off the roster fetch, not off State.Me
    }

    private async Task SendUpgradeCodeAsync()
    {
        _upgradeBusy = true; _upgradeError = null; _upgradeTaken = false;

        var sent = await Api.RequestOtpAsync(_upgradeEmail.Trim(), State.Lang);
        _upgradeBusy = false;

        if (sent is null) { _upgradeError = L["auth.badEmail"]; return; }

        _upgradeCode = "";
        _upgradeStage = UpgradeStage.Code;
    }

    /// <summary>
    /// On success this hands the fresh sign-in result to <c>State.SignInAsync</c> — exactly the call a
    /// real sign-in makes — which clears <c>IsGuest</c> and the guest match keys and, through
    /// <c>SetLangAsync</c>'s own <c>Changed</c> event, is the one state change
    /// <c>MainLayout.SyncLobbyConnectionAsync</c> needs to reconnect the lobby hub with the new,
    /// non-guest token. Nothing else in this method needs to react to success: the moment <c>State</c>
    /// reflects it, this whole card's guard (<c>@if (State.IsGuest)</c> above) stops rendering it.
    /// </summary>
    private async Task VerifyUpgradeAsync()
    {
        _upgradeBusy = true; _upgradeError = null; _upgradeTaken = false;

        var (result, error) = await Api.VerifyUpgradeAsync(_upgradeEmail.Trim(), _upgradeCode.Trim(), State.Lang);
        _upgradeBusy = false;

        if (result is null)
        {
            _upgradeTaken = error == "addresstaken";
            _upgradeError = _upgradeTaken ? L["lobby.upgrade.taken"] : L["auth.badCode"];
            return;
        }

        await State.SignInAsync(result);
    }

    private async Task CopyAsync()
    {
        _copied = await Js.InvokeAsync<bool>("quesshi.copy", ShareLink);
        StateHasChanged();
    }

    /// <summary>
    /// The Share pill: the OS share sheet where the browser offers one (most mobile browsers), a
    /// plain copy everywhere else — reusing <see cref="CopyAsync"/> rather than duplicating its
    /// clipboard call and its "Copied" feedback. <c>quesshi.share</c> (index.html) reports only
    /// whether <c>navigator.share</c> exists at all; whether the person then finishes or cancels that
    /// native sheet is theirs to decide, not something this page reacts to.
    /// </summary>
    private async Task ShareAsync()
    {
        var shared = await Js.InvokeAsync<bool>("quesshi.share", new { title = L["app.name"], text = L["lobby.shareCode"], url = ShareLink });
        if (!shared) await CopyAsync();
    }

    private static string Initial(string name) => name.Length > 0 ? name[..1].ToUpperInvariant() : "?";

    public async ValueTask DisposeAsync()
    {
        if (_client is null) return;

        _client.LobbyUpdated -= OnLobbyUpdated;
        try { await _client.LeaveAsync(); } catch { /* the connection may already be gone */ }
        await _client.DisposeAsync();
    }
}
