@page "/live/{MatchId}"
@inherits PageBase
@implements IAsyncDisposable
@inject Func<string, LiveClient> ClientFactory
@inject Sounds Sounds

<PageTitle>@L["live.title"] · @L["app.name"]</PageTitle>

<div class="shell">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_refused || _view is null)
    {
        <div class="empty">
            <p>@(_refused ? L["live.refused"] : L["common.error"])</p>
            <a class="btn btn--ghost" href="/">@L["common.back"]</a>
        </div>
    }
    else
    {
        var body = LivePhaseSelector.Select(_view.Phase);

        @if (_reconnecting)
        {
            <p class="notice notice--bad enter" role="status">@L["live.reconnecting"]</p>
        }

        @if (body == LiveBody.Lobby)
        {
            @* Issue #53: replaced by a redirect to /lobby/{code} — see ConnectAsync's own remarks.
               This branch is never actually reached; it stays only so LivePhaseSelector's five bodies
               still cover every phase this switch could in principle see. *@
            <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
        }
        else if (body == LiveBody.Countdown)
        {
            <section class="card card--taq enter" style="text-align:center">
                <div class="row row--between" style="margin-top:.5rem;flex-wrap:wrap;justify-content:center;gap:1rem">
                    @foreach (var p in _view.Participants)
                    {
                        <div class="stack" style="justify-items:center;gap:.35rem" @key="p.PlayerId">
                            <span class="avatar avatar--lg" style="background:@Ranks.Tint(p.Avatar)">@Initial(p.Name)</span>
                            <span dir="auto">@p.Name</span>
                        </div>
                    }
                </div>
                <p class="faint" style="margin-top:1rem">@L["live.countdown.starting"]</p>
                <p class="numeral" style="font-size:var(--step-4);margin-top:.5rem">@L.Num(CountdownDigit)</p>
            </section>
        }
        else if (body == LiveBody.Question)
        {
            var card = _view.CurrentCard;

            @if (card is null)
            {
                <div class="empty"><p>@L["common.error"]</p></div>
            }
            else
            {
                <DuelBar View="_view" MeId="@MeId" Eliminated="_eliminated" />

                <header class="topbar">
                    <span class="chip" style="border-color:@(card.CategoryColor + "66")">
                        <span aria-hidden="true">@card.CategoryIcon</span> @card.CategoryName
                    </span>
                    <span class="level" aria-label="@L["level." + card.Level]">
                        @for (var i = 1; i <= 5; i++) { <i class="@(i <= card.Level ? "on" : null)"></i> }
                    </span>
                    <div class="topbar__spacer"></div>
                    <span class="muted numeral">@L.Num(card.Slot + 1) / @L.Num(card.TotalRounds)</span>
                    <Ring EndsAt="card.EndsAt" Skew="Skew" Total="(int)(card.EndsAt - card.StartedAt).TotalSeconds" Size="38" />
                </header>

                <section class="card card--taq enter" @key="card.Slot">
                    <h1 dir="auto" style="font-size:var(--step-2);text-wrap:balance">@card.Prompt</h1>

                    <MediaBlock Media="card.Media" />

                    @* Kind 0 is the multiple-choice round this page was built around, and its markup
                       below is untouched. The other two kinds need a control rather than a row of
                       tiles, and both need an explicit commit — you cannot lock in an arrangement or
                       a pin by touching it, the way you can lock in a choice by choosing it. *@
                    @if (card.Kind == 1)
                    {
                        <SortList Items="card.Choices" @bind-Ordering="_ordering" Disabled="@AnswerClosed" />

                        <button class="btn btn--block" style="margin-top:.9rem" disabled="@AnswerClosed"
                                @onclick="() => ChooseAsync(-1, _ordering.Response)">
                            @L["play.lockIn"]
                        </button>
                    }
                    else if (card.Kind == 2)
                    {
                        <MapField Shape="card.TargetShape ?? 0" BaseLayer="card.BaseLayer ?? 0"
                                  @bind-Selection="_pick" Disabled="@AnswerClosed"
                                  OnConfirm="() => ChooseAsync(-1, _pick?.Response)" />
                    }
                    else
                    {
                    <div class="answers">
                        @for (var i = 0; i < card.Choices.Count; i++)
                        {
                            var index = i;
                            <button class="answer @(_myChoice == index ? "answer--locked" : null)"
                                    disabled="@(_locked || TimeUp || IsEliminatedMe)" @onclick="() => ChooseAsync(index)">
                                <span class="answer__key" aria-hidden="true">@Keys[index]</span>
                                <span class="grow" dir="auto">@card.Choices[index]</span>
                            </button>
                        }
                    </div>
                    }
                </section>

                <p class="empty enter" style="margin-top:.7rem">
                    @if (IsEliminatedMe)
                    {
                        @L["live.eliminated.notice"]
                    }
                    else if (_locked)
                    {
                        @(AllActiveAnswered ? L["live.question.theyAnswered"] : L["live.question.waitingForThem"])
                    }
                    else if (TimeUp)
                    {
                        @L["play.timeUp"]
                    }
                    else if (AllActiveAnswered)
                    {
                        @L["live.question.theyAnswered"]
                    }
                    else
                    {
                        @L["live.question.locked"]
                    }
                </p>

                @if (AnyActiveAway)
                {
                    <p class="notice notice--bad enter">@L["live.opponentAway"]</p>
                }
            }
        }
        else if (body == LiveBody.Reveal)
        {
            var card = _view.CurrentCard;
            var round = CurrentRound;

            @if (card is null || round is null)
            {
                <div class="empty"><p>@L["common.error"]</p></div>
            }
            else
            {
                var mine = round.Answers.FirstOrDefault(a => a.PlayerId == MeId);
                var others = round.Answers.Where(a => a.PlayerId != MeId).ToList();

                <DuelBar View="_view" MeId="@MeId" Eliminated="_eliminated" />

                <header class="topbar">
                    <span class="chip" style="border-color:@(card.CategoryColor + "66")">
                        <span aria-hidden="true">@card.CategoryIcon</span> @card.CategoryName
                    </span>
                    <span class="level" aria-label="@L["level." + card.Level]">
                        @for (var i = 1; i <= 5; i++) { <i class="@(i <= card.Level ? "on" : null)"></i> }
                    </span>
                    <div class="topbar__spacer"></div>
                    <span class="muted numeral">@L.Num(card.Slot + 1) / @L.Num(card.TotalRounds)</span>
                    <Ring EndsAt="_view.PhaseEndsAt" Skew="Skew" Total="RevealSeconds" Size="38" />
                </header>

                <section class="card card--taq enter" @key="card.Slot">
                    <h1 dir="auto" style="font-size:var(--step-2);text-wrap:balance">@card.Prompt</h1>

                    <MediaBlock Media="card.Media" Loop="false" Autoplay="false" />

                    @* The renderer is chosen off the *card*, which carries the kind in every phase,
                       rather than off the round: LiveRoundResultViewDto.Kind is filled in only for
                       rounds the server has closed, and a client that has just been pushed a reveal
                       is holding both. Using the one that is always right avoids depending on which
                       of the two arrived. The answer itself comes off the round, which is the only
                       thing carrying it. *@
                    @if (card.Kind == 1)
                    {
                        <SortReveal CorrectOrder="round.CorrectOrder ?? []" Columns="SortColumnsFor(round)" />
                    }
                    else if (card.Kind == 2)
                    {
                        <MapReveal CorrectTarget="@round.CorrectTarget" BaseLayer="card.BaseLayer ?? 1"
                                   Answers="MapAnswersFor(round)" />
                    }
                    else
                    {
                    <div class="answers">
                        @for (var i = 0; i < card.Choices.Count; i++)
                        {
                            var index = i;
                            <div class="stack" style="gap:.3rem">
                                <button class="answer @RevealClassFor(index, round.CorrectIndex, mine?.ChoiceIndex)" disabled>
                                    <span class="answer__key" aria-hidden="true">@Keys[index]</span>
                                    <span class="grow" dir="auto">@card.Choices[index]</span>
                                    @if (index == round.CorrectIndex) { <span aria-hidden="true">✓</span> }
                                </button>
                                <div class="row" style="gap:.35rem;flex-wrap:wrap">
                                    @if (mine?.ChoiceIndex == index) { <span class="chip chip--live">@L["result.you"]</span> }
                                    @if (others.Count == 1)
                                    {
                                        @if (others[0].ChoiceIndex == index) { <span class="chip">@L["result.them"]</span> }
                                    }
                                    else
                                    {
                                        @foreach (var other in others.Where(o => o.ChoiceIndex == index))
                                        {
                                            <span class="chip" dir="auto" @key="other.PlayerId">@NameOf(other.PlayerId)</span>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    }
                </section>

                <section class="card card--flat enter" style="margin-top:.85rem">
                    @if (others.Count <= 1)
                    {
                        var theirs = others.FirstOrDefault();
                        <div class="row row--between">
                            <span class="numeral" style="color:var(--zaferan)">@L["result.you"]: +@L.Num(mine?.Score ?? 0)</span>
                            <span class="numeral">@L["result.them"]: +@L.Num(theirs?.Score ?? 0)</span>
                        </div>
                    }
                    else
                    {
                        <div class="row" style="flex-wrap:wrap;gap:.4rem 1rem">
                            <span class="numeral" style="color:var(--zaferan)">@L["result.you"]: +@L.Num(mine?.Score ?? 0)</span>
                            @foreach (var other in others)
                            {
                                <span class="numeral" dir="auto" @key="other.PlayerId">@NameOf(other.PlayerId): +@L.Num(other.Score)</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_view.CurrentExplanation))
                    {
                        <p class="muted" dir="auto" style="margin:.6rem 0 0;font-size:var(--step--1)">@_view.CurrentExplanation</p>
                    }
                </section>
            }
        }
        else
        {
            <section class="card card--taq enter" style="text-align:center">
                <h2>@L[LiveOutcomeText.HeadlineKey(Outcome)]</h2>

                <div style="width:min(17rem,80%);margin:1.1rem auto .5rem">
                    <Shamseh Mine="RaysFor(MeId)" Theirs="TheirsRays" Slots="_view.TotalRounds" Ignite="true"
                             HideTheirs="@(_view.Participants.Count != 2)"
                             Centre="@L.Num(_view.Players.FirstOrDefault(p => p.PlayerId == MeId)?.Score ?? 0)" />
                </div>
            </section>

            @if (_view.Standings.Count > 0)
            {
                <section class="card card--flat enter" style="margin-top:.85rem">
                    <h3>@L["result.standings"]</h3>
                    <div style="margin-top:.5rem">
                        <StandingsList Rows="_view.Standings" MeId="@MeId" />
                    </div>
                </section>
            }

            <div class="stack enter" style="margin-top:1.2rem">
                @if (CanOfferRematch)
                {
                    @if (_rematchFailed)
                    {
                        <p class="notice notice--bad" style="text-align:center">@L["live.rematch.failed"]</p>
                    }
                    <button class="btn btn--block" disabled="@_rematchPressed" @onclick="RequestRematchAsync">@L["live.rematch.button"]</button>
                }
                else if (_view.Participants.Count > 1 && !State.IsGuest)
                {
                    @* A signed-in player reads this as "them, not you" — for a guest it would just
                       repeat result.guestHint below in different words, and issue #92 caps a screen
                       at one helper sentence. *@
                    <p class="faint" style="text-align:center">@L["live.rematch.guestBlocked"]</p>
                }

                @if (State.IsGuest)
                {
                    <a class="btn btn--ghost btn--block" href="/signin">@L["result.keepScore"]</a>
                    <p class="faint" style="margin:-.4rem 0 0;text-align:center;font-size:var(--step--1)">@L["result.guestHint"]</p>
                }
                else
                {
                    <a class="btn btn--ghost btn--block" href="/">@L["result.again"]</a>
                }
            </div>
        }
    }
</div>

@code {
    private static readonly string[] Keys = ["A", "B", "C", "D"];

    /// <summary>Mirrors <c>LiveRules.RevealTime</c> (Domain, 3s) — the Web project has no reference
    /// to Domain, so this is the ring's denominator for the reveal countdown, not a second source
    /// of truth: the server's <c>PhaseEndsAt</c> is what actually ends the phase.</summary>
    private const int RevealSeconds = 3;

    [Parameter] public string MatchId { get; set; } = "";

    /// <summary>A guest may join a live duel by code, per #12 — playing is the whole reason a guest exists.</summary>
    protected override bool AllowsGuest => true;

    private LiveClient? _client;
    private LiveViewDto? _view;
    private bool _refused;
    private bool _reconnecting;

    private bool _locked;
    private int? _myChoice;

    /// <summary>A sorting round's answer as the player is building it, cleared on every new round so
    /// the next question never inherits the last one's arrangement.</summary>
    private SortOrdering _ordering = SortOrdering.Served(0);

    /// <summary>A map round's answer: the country or point last tapped. Unlike the sorting order,
    /// this one <i>can</i> be restored after a reconnect — see <see cref="SyncLocalAnswerState"/>.</summary>
    private MapPick? _pick;

    /// <summary>
    /// Every id in here has hit <c>LiveRules.MissesBeforeAbandon</c> and is done playing for good — a
    /// player never returns from this set. Seeded from a fresh view's per-player <c>MissStreak</c> on
    /// every load and rejoin (see <see cref="SyncEliminatedFromView"/>) and grown live by the
    /// <c>PlayerEliminated</c> push in between, since an ordinary round reveal never refreshes
    /// <c>MissStreak</c> on its own — see <see cref="LiveElimination"/>'s own remarks for why both
    /// sources are necessary.
    /// </summary>
    private readonly HashSet<string> _eliminated = [];

    /// <summary>Who has locked in an answer for the round currently open, other than me. Reset every
    /// new round; grown by the live <c>OpponentAnswered</c> push and rebuilt from the round's own
    /// redacted answers on load or rejoin.</summary>
    private readonly HashSet<string> _answeredOthers = [];

    /// <summary>Who is currently away (disconnected), other than me. Presence is connection-level, not
    /// round-level, so this is never cleared on a new round the way <see cref="_answeredOthers"/> is.</summary>
    private readonly HashSet<string> _awayOthers = [];

    private bool _rematchPressed;
    private bool _rematchFailed;

    private Timer? _ticker;
    private string? _boundMatchId;

    /// <summary>The remaining-seconds reading the tick cue last fired for, so the 250ms ticker below
    /// plays it once per second rather than up to four times over the same second. Null between
    /// rounds and reset on every fresh <see cref="OnRoundStarted"/> — see <see cref="SoundTicks"/>.</summary>
    private int? _lastTickedSecond;

    private string MeId => State.Me!.Id;

    protected override async Task LoadAsync()
    {
        await ConnectAsync();
        _ticker = new Timer(OnTick, null, 250, 250);
    }

    /// <summary>
    /// The ticker's own callback: it used to only ever trigger a redraw, so the countdown ring stays
    /// live between server pushes. It also now checks the same remaining-seconds reading for the tick
    /// cue — <see cref="SoundTicks.ShouldTick"/> is what keeps this to once per second rather than
    /// once per 250ms tick, and only while a round's question is actually in flight (not, say, during
    /// the reveal that follows it, whose own clock counts down to something else entirely).
    /// </summary>
    private void OnTick(object? _)
    {
        if (_view is { Phase: "question" } && _view.CurrentCard is { } card)
        {
            var remaining = RingClock.RemainingSeconds(card.EndsAt, DateTimeOffset.UtcNow, Skew);
            if (SoundTicks.ShouldTick(remaining, _lastTickedSecond))
            {
                _lastTickedSecond = remaining;
                _ = Sounds.Tick();
            }
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// A rematch push navigates to <c>/live/{newId}</c> while this page is already open — the same
    /// component instance is reused (#35's own technical note), so this is the only hook that ever
    /// notices the route changed. Tears down the finished duel's <see cref="LiveClient"/> and
    /// re-enters for the new id rather than staying bound to the old one. Every set this page keeps
    /// for the *previous* duel — who was eliminated, who had answered, who was away — is cleared here
    /// too, or a player eliminated in a finished duel would still read as eliminated in its rematch.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_boundMatchId is null || _boundMatchId == MatchId) return;

        if (_client is not null)
        {
            try { await _client.LeaveAsync(); } catch { /* the connection may already be gone */ }
            await _client.DisposeAsync();
        }

        _view = null;
        _refused = false;
        _eliminated.Clear();
        _answeredOthers.Clear();
        _awayOthers.Clear();
        await ConnectAsync();
        StateHasChanged();
    }

    private async Task ConnectAsync()
    {
        _client = ClientFactory("/hub/live");
        _client.RoundStarted += OnRoundStarted;
        _client.RoundRevealed += OnRoundRevealed;
        _client.Ended += OnEnded;
        _client.OpponentLeft += p => OnPresence(p, online: false);
        _client.OpponentBack += p => OnPresence(p, online: true);
        _client.OpponentAnswered += OnOpponentAnswered;
        _client.PlayerEliminated += OnPlayerEliminated;
        _client.Rejoined += OnRejoined;
        _client.RematchCreated += OnRematchCreated;
        _client.RematchFailed += OnRematchFailed;
        _client.Connection.Reconnecting += _ => Toggle(true);
        _client.Connection.Reconnected += _ => Toggle(false);
        _client.Connection.Closed += _ => Toggle(true);

        try
        {
            await _client.StartAsync();
            _view = await _client.JoinAsync(MatchId);
        }
        catch
        {
            // The socket isn't up yet, or the hub refused us — either way #13's shell falls back
            // to the same catch-up read GET /api/live/{id} serves; a genuine non-participant is
            // refused by both paths alike.
            _view = await Api.LiveAsync(MatchId);
        }

        _refused = _view is null;
        _rematchPressed = false;
        _rematchFailed = false;
        SyncLocalAnswerState();
        SyncEliminatedFromView();
        _boundMatchId = MatchId;

        // Issue #53: a duel still sitting in its lobby phase has nothing for this page to show — that
        // is now /lobby/{code}'s job, roster and share code both, replacing the inline "waiting for
        // your opponent" card this page used to render for LiveBody.Lobby.
        if (_view is { Phase: "lobby" }) Nav.NavigateTo($"/lobby/{_view.Code}", replace: true);
    }

    private Task Toggle(bool reconnecting)
    {
        _reconnecting = reconnecting;
        return InvokeAsync(StateHasChanged);
    }

    // --- server pushes: the only way _view ever changes -----------------------------------------

    private void OnRoundStarted(LiveRoundCardDto card)
    {
        if (_view is null) return;

        // The round that has just opened carries the card's kind and no answer of any sort: a client
        // that has just been told what kind of round this is must not, in the same breath, be handed
        // what the answer to it was.
        List<LiveRoundResultViewDto> rounds = [.. _view.Rounds.Take(card.Slot), new(card.Slot, card.QuestionId, card.StartedAt, null, [], card.Kind)];
        _view = _view with { Phase = "question", PhaseEndsAt = card.EndsAt, RoundIndex = card.Slot, CurrentCard = card, CurrentExplanation = null, Rounds = rounds };
        _locked = false;
        _myChoice = null;
        _ordering = SortOrdering.Served(card.Choices.Count);
        _pick = null;
        _answeredOthers.Clear();
        _lastTickedSecond = null;
        _ = Sounds.RoundStart();
        InvokeAsync(StateHasChanged);
    }

    private void OnRoundRevealed(LiveRoundRevealDto reveal)
    {
        if (_view?.CurrentCard is not { } card) return;

        // Every field of the reveal moves into the history the same way the correct index always has,
        // kind-specific answers included: a client that reconnects after this round must find the
        // same round it would have kept from the push, or the two would tell it different stories
        // about the same slot.
        List<LiveRoundAnswerViewDto> answers = [.. reveal.Players.Select(p => new LiveRoundAnswerViewDto(p.PlayerId, true, p.ChoiceIndex, p.Correct, p.RoundScore, p.Response))];
        List<LiveRoundResultViewDto> rounds = [.. _view.Rounds.Take(reveal.Slot), new(reveal.Slot, card.QuestionId, card.StartedAt, reveal.CorrectIndex, answers, reveal.Kind, reveal.CorrectOrder, reveal.CorrectTarget)];
        List<LivePlayerViewDto> players = [.. _view.Players.Select(p =>
        {
            var mine = reveal.Players.FirstOrDefault(r => r.PlayerId == p.PlayerId);
            return mine is null ? p : p with { Score = mine.TotalScore, Correct = p.Correct + (mine.Correct ? 1 : 0) };
        })];

        _view = _view with { Phase = "reveal", PhaseEndsAt = reveal.EndsAt, CurrentExplanation = reveal.Explanation, Rounds = rounds, Players = players };

        // The local player's own answer, and only that one — never a cue for how anyone else did.
        // A player with no entry here (already eliminated, no seat at all) gets neither cue.
        var mine = reveal.Players.FirstOrDefault(p => p.PlayerId == MeId);
        if (mine is not null) _ = mine.Correct ? Sounds.Correct() : Sounds.Wrong();

        InvokeAsync(StateHasChanged);
    }

    private void OnEnded(LiveEndedDto ended)
    {
        if (_view is null) return;

        List<LivePlayerViewDto> players = [.. _view.Players.Select(p =>
        {
            var final = ended.Scores.FirstOrDefault(s => s.PlayerId == p.PlayerId);
            return final is null ? p : p with { Score = final.Score, Correct = final.Correct };
        })];

        // The authoritative standings, straight off LiveMatch.Standings via LiveEndedDto — every
        // abandoner correctly ranked below every finisher, unlike the best-effort reconstruction
        // Mappers.ToLiveDtoAsync falls back to for a cold load. Name/avatar are filled in from the
        // participants this view already carries, since the push itself only names ids.
        List<StandingRowDto> standings = [.. ended.Standings.Select(s => new StandingRowDto(s.PlayerId, NameOf(s.PlayerId), AvatarOf(s.PlayerId), s.Score, s.Place, s.Outcome))];

        _view = _view with { Phase = "over", State = ended.State, WinnerId = ended.WinnerId, IsDraw = ended.IsDraw, AbandonedBy = ended.AbandonedBy, Players = players, Standings = standings };

        // The local player's own row decides win or loss; a draw (or a no-contest, which leaves no
        // row for anybody) earns neither cue — see SoundOutcomeMapping's own remarks.
        var myStanding = standings.FirstOrDefault(s => s.PlayerId == MeId);
        if (myStanding is not null)
        {
            _ = SoundOutcomeMapping.ForOutcome(myStanding.Outcome) switch
            {
                SoundOutcome.Win => Sounds.Win(),
                SoundOutcome.Loss => Sounds.Loss(),
                _ => Task.CompletedTask
            };
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnOpponentAnswered(OpponentAnsweredDto a)
    {
        if (a.PlayerId == MeId) return;
        _answeredOthers.Add(a.PlayerId);
        InvokeAsync(StateHasChanged);
    }

    private void OnPresence(OpponentPresenceDto p, bool online)
    {
        if (p.PlayerId == MeId) return; // that push is about my own connection, not theirs
        if (online) _awayOthers.Remove(p.PlayerId); else _awayOthers.Add(p.PlayerId);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The eliminated client's own switch to spectating — nothing more to sync here, since the
    /// question/answers markup above already reads <see cref="IsEliminatedMe"/> and
    /// <see cref="_eliminated"/> on every render. The survivors' side of the contract —
    /// <see cref="AllActiveAnswered"/> no longer waiting on a dropped seat — falls out of the same
    /// set for free, since <see cref="ActiveOtherIds"/> already excludes it.
    /// </summary>
    private void OnPlayerEliminated(LivePlayerEliminatedDto e)
    {
        _eliminated.Add(e.PlayerId);
        InvokeAsync(StateHasChanged);
    }

    private void OnRematchCreated(RematchCreatedDto r) => InvokeAsync(() => Nav.NavigateTo($"/live/{r.NewMatchId}"));

    private void OnRematchFailed()
    {
        _rematchPressed = false;
        _rematchFailed = true;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// A dropped-and-restored connection may have missed a whole phase change — the reveal that
    /// closed the round we were locked into, or the round after that. The rejoin's fresh catch-up
    /// view is the only source of truth for what actually happened while the socket was down, so it
    /// replaces <see cref="_view"/> outright rather than being patched in.
    /// </summary>
    private void OnRejoined(LiveViewDto view)
    {
        _view = view;
        SyncLocalAnswerState();
        SyncEliminatedFromView();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Rebuilds the locked/choice/others-answered fields from whatever the current view says about
    /// the round in flight — needed after both a fresh load and a rejoin, since either can land mid-
    /// round with answers already recorded server-side that this page never locally submitted.
    /// </summary>
    private void SyncLocalAnswerState()
    {
        var round = _view is { Phase: "question" } v && v.RoundIndex < v.Rounds.Count ? v.Rounds[v.RoundIndex] : null;
        var mine = round?.Answers.FirstOrDefault(a => a.PlayerId == MeId);

        _locked = mine is { Answered: true };
        _myChoice = mine?.ChoiceIndex;

        // A sorting arrangement cannot come back: the server normalised it into stored-index terms
        // at submission and the round in flight reveals no correct order to resolve it against, so
        // the list is reset to the served order and left locked. A map answer can come back exactly
        // — a country code or a point is the same string on both sides of the wire — so a player who
        // dropped and reconnected mid-round still sees their own pin where they put it.
        _ordering = SortOrdering.Served(_view?.CurrentCard?.Choices.Count ?? 0);
        _pick = MapPick.Parse(mine?.Response);

        _answeredOthers.Clear();
        if (round is not null)
            foreach (var a in round.Answers.Where(a => a.PlayerId != MeId && a.Answered))
                _answeredOthers.Add(a.PlayerId);
    }

    /// <summary>See <see cref="_eliminated"/>'s own remarks: a fresh view's <c>MissStreak</c> is
    /// accurate at the instant it was built, and stays frozen at the threshold forever after a player
    /// is dropped, so union-ing it in is always safe to repeat.</summary>
    private void SyncEliminatedFromView()
    {
        if (_view is null) return;
        foreach (var id in LiveElimination.EliminatedIds(_view)) _eliminated.Add(id);
    }

    // --- actions ----------------------------------------------------------------------------------

    /// <summary>
    /// One path for all three kinds. A choice answer sends its index and no response, exactly as it
    /// always did; a sorting or map answer sends -1 and the response string, which is what
    /// <c>AnswerDto</c> and <c>LiveHub.Answer</c> document. Nothing here submits an empty answer:
    /// unlike the async screen there is no client-side timeout to represent, since the server closes
    /// a live round on its own clock and records the miss itself.
    /// </summary>
    private async Task ChooseAsync(int index, string? response = null)
    {
        if (_locked || TimeUp || IsEliminatedMe || _view?.CurrentCard is null || _client is null) return;
        if (index < 0 && response is null) return;

        _locked = true;
        _myChoice = index;
        StateHasChanged();

        try { await _client.AnswerAsync(MatchId, _view.RoundIndex, index, response); }
        catch { /* rejected as late or duplicate — the reveal that follows is authoritative */ }
    }

    private async Task RequestRematchAsync()
    {
        if (_client is null) return;

        _rematchPressed = true;
        _rematchFailed = false;
        StateHasChanged();

        RematchOutcomeDto outcome;
        try { outcome = await _client.RematchAsync(MatchId); }
        catch { outcome = new RematchOutcomeDto("failed"); }

        switch (outcome.Status)
        {
            case "created" when outcome.NewMatchId is not null:
                Nav.NavigateTo($"/live/{outcome.NewMatchId}");
                break;
            default: // "refused" or "failed" — nothing to press again for, or the server needs another try
                _rematchPressed = false;
                _rematchFailed = outcome.Status == "failed";
                StateHasChanged();
                break;
        }
    }

    // --- derived state ------------------------------------------------------------------------------

    /// <summary>Whether this player can still answer the round in flight. The choice tiles spell the
    /// same three conditions out inline, unchanged; the sorting and map controls read them here.</summary>
    private bool AnswerClosed => _locked || TimeUp || IsEliminatedMe;

    /// <summary>
    /// One column per player for a revealed sorting round, mine first. Every response arrives in
    /// stored-index terms, which <see cref="AnswerReveal.PlacedItems"/> resolves against the round's
    /// correct order — a lookup, never a re-shuffle, and never anything that needs the round's seed.
    /// </summary>
    private List<SortRevealColumn> SortColumnsFor(LiveRoundResultViewDto round)
    {
        var others = round.Answers.Where(a => a.PlayerId != MeId).ToList();
        var mine = round.Answers.FirstOrDefault(a => a.PlayerId == MeId);

        List<SortRevealColumn> columns = [new(L["result.you"], AnswerReveal.PlacedItems(round.CorrectOrder, mine?.Response))];

        // A capacity-2 duel says "Them", the way every other two-player surface in this app does;
        // beyond two there is no "them" to speak of and each column carries a name instead.
        columns.AddRange(others.Select(other => new SortRevealColumn(
            others.Count == 1 ? L["result.them"] : NameOf(other.PlayerId),
            AnswerReveal.PlacedItems(round.CorrectOrder, other.Response))));

        return columns;
    }

    /// <summary>The same list for a revealed map round. <c>Correct</c> comes straight off the round's
    /// own redacted answer, so unlike the async duel history this side never has to work out whether
    /// a pin fell inside a radius it was never told.</summary>
    private List<MapAnswerLine> MapAnswersFor(LiveRoundResultViewDto round)
    {
        var others = round.Answers.Where(a => a.PlayerId != MeId).ToList();
        var mine = round.Answers.FirstOrDefault(a => a.PlayerId == MeId);

        List<MapAnswerLine> lines = [new(L["result.you"], mine?.Response, mine?.Correct)];

        lines.AddRange(others.Select(other => new MapAnswerLine(
            others.Count == 1 ? L["result.them"] : NameOf(other.PlayerId), other.Response, other.Correct)));

        return lines;
    }

    private bool TimeUp => _view?.CurrentCard is { } c && DateTimeOffset.UtcNow + Skew >= c.EndsAt;
    private TimeSpan Skew => _client?.Skew ?? TimeSpan.Zero;

    private int CountdownDigit => _view?.PhaseEndsAt is { } endsAt
        ? RingClock.RemainingSeconds(endsAt, DateTimeOffset.UtcNow, Skew)
        : 0;

    private bool IsEliminatedMe => _eliminated.Contains(MeId);

    /// <summary>Every other seated player still worth waiting on: not me, and not anyone already
    /// eliminated — an eliminated seat can never answer again, so a round would otherwise wait
    /// forever on it. This is what makes <see cref="AllActiveAnswered"/> true again once a dropped
    /// player stops being counted, rather than surviving them staying permanently "not yet answered".</summary>
    private IEnumerable<string> ActiveOtherIds => _view is null
        ? []
        : _view.Participants.Select(p => p.PlayerId).Where(id => id != MeId && !_eliminated.Contains(id));

    /// <summary>True once every active seat but mine has locked in an answer for the round in flight.
    /// For a capacity-2 duel this is exactly the old single-opponent-answered flag, since there is
    /// only ever one other active id to check.</summary>
    private bool AllActiveAnswered => ActiveOtherIds.Any() && ActiveOtherIds.All(_answeredOthers.Contains);

    private bool AnyActiveAway => ActiveOtherIds.Any(_awayOthers.Contains);

    /// <summary>Consistent with #12: a guest may join a live duel, but not create one — and a
    /// rematch creates one. Offered only once the duel actually holds more than one seat and nobody
    /// in it is a guest.</summary>
    private bool CanOfferRematch => _view is not null && _view.Participants.Count >= 2 && _view.Participants.All(p => !p.IsGuest);

    private LiveRoundResultViewDto? CurrentRound =>
        _view is not null && _view.RoundIndex < _view.Rounds.Count ? _view.Rounds[_view.RoundIndex] : null;

    private static string Initial(string name) => name.Length > 0 ? name[..1].ToUpperInvariant() : "?";

    private LiveOutcome Outcome => LiveOutcomeText.Resolve(_view!.State, _view.WinnerId, _view.IsDraw, _view.AbandonedBy, MeId);

    private static string? RevealClassFor(int index, int? correctIndex, int? myChoice)
    {
        if (index == correctIndex) return "answer--right";
        if (index == myChoice) return "answer--wrong";
        return "answer--dim";
    }

    private IReadOnlyList<bool?> RaysFor(string? playerId) => playerId is null || _view is null
        ? []
        : [.. _view.Rounds.Select(r => r.Answers.FirstOrDefault(a => a.PlayerId == playerId) is { Answered: true } a ? a.Correct : (bool?)null)];

    /// <summary>The rosette's second ring only ever made sense for exactly one other player — see
    /// <c>Shamseh</c>'s own remarks. A capacity&gt;2 duel hides it (<c>HideTheirs</c> above) rather
    /// than picking one other participant arbitrarily to represent the rest.</summary>
    private IReadOnlyList<bool?> TheirsRays => _view is { Participants.Count: 2 } v
        ? RaysFor(v.Participants.First(p => p.PlayerId != MeId).PlayerId)
        : [];

    private string NameOf(string playerId) => _view?.Participants.FirstOrDefault(p => p.PlayerId == playerId)?.Name ?? playerId;
    private string AvatarOf(string playerId) => _view?.Participants.FirstOrDefault(p => p.PlayerId == playerId)?.Avatar ?? "";

    public async ValueTask DisposeAsync()
    {
        _ticker?.Dispose();
        if (_client is not null)
        {
            try { await _client.LeaveAsync(); } catch { /* the connection may already be gone */ }
            await _client.DisposeAsync();
        }
    }
}
