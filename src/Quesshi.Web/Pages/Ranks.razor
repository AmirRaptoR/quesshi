@page "/ranks"
@inherits PageBase

<PageTitle>@L["nav.ranks"] · @L["app.name"]</PageTitle>

<div class="shell">
    <header class="topbar"><h1 class="topbar__title">@L["nav.ranks"]</h1></header>

    <div class="row" style="gap:.5rem;margin-bottom:1rem">
        <button class="btn btn--sm @(_friendsOnly ? "btn--ghost" : "")" @onclick="() => Switch(false)">@L["ranks.global"]</button>
        <button class="btn btn--sm @(_friendsOnly ? "" : "btn--ghost")" @onclick="() => Switch(true)">@L["ranks.friends"]</button>
    </div>

    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_rows.Count == 0)
    {
        <p class="empty">@L["ranks.empty"]</p>
    }
    else
    {
        <div class="stack">
            @foreach (var row in _rows)
            {
                <div class="card card--flat row enter @(row.PlayerId == State.Me?.Id ? "is-me" : null)"
                     style="@(row.PlayerId == State.Me?.Id ? "border-color:var(--line-2)" : null)">
                    <span class="numeral faint" style="width:1.8rem;text-align:center">@L.Num(row.Rank)</span>
                    <span class="avatar" style="background:@Tint(row.AvatarSeed)">@Initial(row.DisplayName)</span>
                    <span class="grow" style="font-weight:600">@row.DisplayName</span>
                    <span class="numeral" style="color:var(--zaferan)">@L.Num(row.Score)</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<LeaderboardRowDto> _rows = [];
    private bool _friendsOnly;

    protected override async Task LoadAsync()
    {
        _friendsOnly = QueryState.Read(Nav, "board") == "friends";
        _rows = (_friendsOnly ? await Api.FriendsBoardAsync() : await Api.LeaderboardAsync()) ?? [];
    }

    private async Task Switch(bool friends)
    {
        if (_friendsOnly == friends) return;

        _friendsOnly = friends;
        QueryState.Write(Nav, new Dictionary<string, string?> { ["board"] = friends ? "friends" : null });

        Loading = true;
        _rows = (_friendsOnly ? await Api.FriendsBoardAsync() : await Api.LeaderboardAsync()) ?? [];
        Loading = false;
    }

    private static string Initial(string name) => name.Length > 0 ? name[..1].ToUpperInvariant() : "?";

    /// <summary>Every player gets a stable glaze colour derived from their id.</summary>
    internal static string Tint(string seed)
    {
        var hue = Math.Abs(seed.GetHashCode()) % 360;
        return $"hsl({hue} 55% 62%)";
    }
}
