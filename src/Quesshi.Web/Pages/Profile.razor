@page "/profile"
@inherits PageBase
@inject LobbyClient Lobby
@inject IJSRuntime Js
@using System.Globalization

@*
    Issue #91: Profile stops being a settings form with a stats card bolted on and becomes identity,
    record and friends — one Duel action per friend, nothing else competing for the first tap. Every
    field that used to live here (display name, language, sign-out) moved behind the gear at
    Settings.razor, alongside the new sounds switch (#93). The old per-topic accuracy breakdown has no
    home in the redesign's mockup at all; it is not carried over anywhere.
*@

<PageTitle>@L["nav.profile"] · @L["app.name"]</PageTitle>

<div class="shell">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading || State.Me is null)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else
    {
        var me = State.Me;
        var points = me.Stats.TotalScore.ToString("N0", CultureInfo.InvariantCulture);

        @* --- the gear: the only door into everything this page used to ask for as a form ----------- *@
        <div class="row" style="justify-content:flex-end">
            <a class="icon-hit" href="/settings" aria-label="@L["settings.title"]">
                <Icon Name="gear" Size="1.4rem" />
            </a>
        </div>

        @* --- identity: a big avatar, the name, and points with a rank alongside it when there is one -
           RankOrdinal.Rank returns null for anyone outside the leaderboard's own top 20, and that null
           is exactly "unranked" — this renders the points alone rather than inventing a position. ---- *@
        <div class="profile-id enter">
            <span class="avatar profile-id__avatar" style="background:@Ranks.Tint(me.AvatarSeed)">@Initial(me.DisplayName)</span>
            <h1 class="profile-id__name" dir="auto">@me.DisplayName</h1>
            <div class="profile-id__meta">
                <span class="numeral profile-id__points">@L.Num(points)</span>
                <span class="faint">
                    @if (_rank is { } rank)
                    {
                        @L.Format("profile.rankSuffix", RankOrdinal.Format(L.Num(rank), rank, L.Lang))
                    }
                    else
                    {
                        @L["profile.pointsSuffix"]
                    }
                </span>
            </div>
        </div>

        @* --- record: Won / Lost / Streak, unlabelled by design (no ALL-CAPS eyebrow above it) — the
           wrapper's aria-label is what keeps a screen reader from reading three bare numbers. --------- *@
        <section class="record-grid enter" aria-label="@L["profile.stats"]">
            <div class="record-tile">
                <div class="record-tile__value" style="color:var(--firouzeh)">@L.Num(me.Stats.Wins)</div>
                <div class="record-tile__label">@L["profile.wins"]</div>
            </div>
            <div class="record-tile">
                <div class="record-tile__value">@L.Num(me.Stats.Losses)</div>
                <div class="record-tile__label">@L["profile.losses"]</div>
            </div>
            <div class="record-tile">
                <div class="record-tile__value" style="color:var(--zaferan)">@L.Num(me.Stats.Streak)</div>
                <div class="record-tile__label">@L["profile.streak"]</div>
            </div>
        </section>

        @* --- friends: Add reveals the search inline instead of it sitting open by default; every row
           after that is a friend with one Duel pill, whose style and action both come from whether
           they are online right now (see FriendDuelPlan) rather than from a menu on the pill itself. -- *@
        <section class="enter" style="margin-top:1.75rem">
            <div class="row row--between">
                <h2 class="friends-title">@L["profile.friends"]</h2>
                <button type="button" class="link-action" @onclick="ToggleAdd">@L["profile.add"]</button>
            </div>

            @if (_adding)
            {
                <div class="row" style="margin-top:.8rem">
                    <input class="input grow" placeholder="@L["profile.findFriends"]"
                           @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKey" />
                    <button class="btn btn--ghost btn--sm" @onclick="SearchAsync">@L["admin.search"]</button>
                </div>

                @if (_found.Count > 0)
                {
                    <div class="stack" style="margin-top:.6rem;gap:.4rem">
                        @foreach (var found in _found.Where(f => f.Id != me.Id && me.Friends.All(x => x.Id != f.Id)))
                        {
                            <div class="row" @key="found.Id">
                                <span class="avatar avatar--sm" style="background:@Ranks.Tint(found.AvatarSeed)">@Initial(found.DisplayName)</span>
                                <span class="grow" dir="auto">@found.DisplayName</span>
                                <button class="btn btn--sm" @onclick="() => AddAsync(found.Id)">@L["profile.add"]</button>
                            </div>
                        }
                    </div>
                }
            }

            <div class="stack friend-list" style="margin-top:.9rem;gap:.5rem">
                @if (me.Friends.Count == 0)
                {
                    @* An invitation to act, not a statement — issue #91's own wording for this state. *@
                    <p class="friends-empty">
                        @L["profile.friendsEmpty"]
                        <button type="button" class="btn btn--sm" @onclick="ToggleAdd">@L["profile.add"]</button>
                    </p>
                }
                @foreach (var friend in me.Friends)
                {
                    <div class="friend-row" @key="friend.Id">
                        <span class="avatar friend-row__avatar" style="background:@Ranks.Tint(friend.AvatarSeed)">
                            @Initial(friend.DisplayName)
                            @if (friend.Online)
                            {
                                <span class="dot--online friend-row__dot" aria-label="@L["profile.online"]" title="@L["profile.online"]"></span>
                            }
                        </span>
                        <div class="grow">
                            <div class="friend-row__name" dir="auto">@friend.DisplayName</div>
                            <div class="faint friend-row__status">
                                @(friend.Online
                                    ? L.Format("profile.friendScoreOnline", L.Num(friend.Score))
                                    : L.Format("profile.friendScore", L.Num(friend.Score)))
                            </div>
                        </div>
                        <button type="button" class="duel-pill @(friend.Online ? "duel-pill--live" : "duel-pill--async")"
                                disabled="@(_duelingId == friend.Id)" @onclick="() => DuelAsync(friend)">
                            @L["profile.duel"]
                        </button>

                        @* Issue #92: #91's redesign dropped the remove control the old Profile had — see
                           git history on this file. A quiet affordance rather than the old bare "×": one
                           tap turns the icon into a plain "Remove?" text so a mis-tap costs nothing, a
                           second tap within three seconds actually removes, and it reverts on its own
                           otherwise — no modal, no menu, for a row that already has one primary action. *@
                        <button type="button" class="icon-hit friend-row__remove @(_removeConfirmId == friend.Id ? "is-confirm" : null)"
                                aria-label="@(_removeConfirmId == friend.Id ? L["profile.removeConfirm"] : L["profile.remove"])"
                                @onclick="() => ToggleRemoveAsync(friend.Id)">
                            @if (_removeConfirmId == friend.Id)
                            {
                                <span class="friend-row__removeText">@L["profile.removeConfirm"]</span>
                            }
                            else
                            {
                                <Icon Name="close" Size="1.05rem" />
                            }
                        </button>
                    </div>
                }
            </div>

            @if (_toast is not null) { <div class="notice notice--good enter" style="margin-top:.8rem">@_toast</div> }
            @if (_error is not null) { <div class="notice notice--bad enter" style="margin-top:.8rem">@_error</div> }
        </section>
    }
</div>

@code {
    private string _query = "";
    private List<FriendDto> _found = [];
    private int? _rank;
    private bool _adding;
    private string? _duelingId;
    private string? _toast;
    private string? _error;

    /// <summary>The one friend row currently showing "Remove?" instead of the × — never more than one
    /// at a time, since tapping a second row's × is as much a change of mind as pressing anything
    /// else on the page would be.</summary>
    private string? _removeConfirmId;
    private CancellationTokenSource? _removeConfirmCts;

    protected override async Task LoadAsync()
    {
        var board = await Api.LeaderboardAsync() ?? [];
        _rank = State.Me is null ? null : RankOrdinal.Rank(board, State.Me.Id);
    }

    private static string Initial(string name) => name.Length > 0 ? name[..1].ToUpperInvariant() : "?";

    private void ToggleAdd()
    {
        _adding = !_adding;
        if (!_adding) { _query = ""; _found = []; }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (_query.Trim().Length < 2) { _found = []; return; }
        _found = await Api.SearchPlayersAsync(_query.Trim()) ?? [];
    }

    private async Task AddAsync(string id)
    {
        if (await Api.AddFriendAsync(id)) await RefreshMeAsync();
    }

    /// <summary>
    /// First tap arms the row (swaps the × for "Remove?" and starts a three-second window); a second
    /// tap on the same row within that window is the confirmation and actually removes the friend.
    /// Arming a different row, or letting the window lapse, disarms this one — there is only ever one
    /// live timer, cancelled and replaced rather than left to fire on a row that already moved on.
    /// </summary>
    private async Task ToggleRemoveAsync(string friendId)
    {
        if (_removeConfirmId == friendId)
        {
            _removeConfirmCts?.Cancel();
            _removeConfirmId = null;
            if (await Api.RemoveFriendAsync(friendId)) await RefreshMeAsync();
            return;
        }

        _removeConfirmCts?.Cancel();
        _removeConfirmCts = new CancellationTokenSource();
        _removeConfirmId = friendId;
        _ = DisarmAfterDelayAsync(_removeConfirmCts.Token);
    }

    private async Task DisarmAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), token);
        }
        catch (TaskCanceledException)
        {
            return; // superseded by a second tap (confirmed) or a different row's first tap
        }

        _removeConfirmId = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshMeAsync()
    {
        if (await Api.MeAsync() is { } me) State.SetMe(me);
        _found = [];
    }

    /// <summary>
    /// The pill's whole decision is <see cref="FriendDuelPlan.Choose"/>: a live challenge — the same
    /// call this page always made — for a friend online right now, or a fresh async duel for anyone
    /// else, its code copied to the clipboard and announced with a toast rather than delivered in-app
    /// (see FriendDuelPlan's own remarks for why no in-app path reaches an offline friend). The same
    /// "last live settings, or the defaults" fallback the old Challenge button used carries over to
    /// both branches, so a friend duel keeps whatever length/language/topics Home.razor last chose.
    /// </summary>
    private async Task DuelAsync(FriendDto friend)
    {
        _error = null;
        _toast = null;
        _duelingId = friend.Id;
        try
        {
            if (FriendDuelPlan.Choose(friend.Online) == FriendDuelKind.Live)
            {
                var result = await Lobby.ChallengeAsync(friend.Id,
                    State.LastLiveLang ?? State.Lang,
                    State.LastLiveQuestionCount ?? 10,
                    State.LastLiveCategories ?? [],
                    State.LastLiveLevels ?? []);

                if (result is null) _error = L["common.error"];
            }
            else
            {
                var match = await Api.CreateMatchAsync(random: false,
                    State.LastLiveLang ?? State.Lang,
                    State.LastLiveCategories ?? [],
                    State.LastLiveQuestionCount ?? 10,
                    State.LastLiveLevels ?? []);

                if (match is null)
                {
                    _error = L["common.error"];
                }
                else
                {
                    await Js.InvokeVoidAsync("quesshi.copy", match.Code);
                    _toast = L.Format("profile.codeCopied", friend.DisplayName);
                }
            }
        }
        finally
        {
            _duelingId = null;
        }
    }

    /// <summary>Leaving mid-window must not let the delayed disarm fire against a page that has already
    /// torn down — nothing else on this page owns a timer, so this is the only reason to override it.</summary>
    public override void Dispose()
    {
        _removeConfirmCts?.Cancel();
        base.Dispose();
    }
}
