@page "/play/{MatchId}"
@inherits PageBase
@implements IAsyncDisposable
@inject Sounds Sounds

<PageTitle>@L["play.question"] · @L["app.name"]</PageTitle>

<div class="shell">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="State.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_card is null)
    {
        <div class="empty">
            <p>@L["common.error"]</p>
            <a class="btn btn--ghost" href="/">@L["common.back"]</a>
        </div>
    }
    else
    {
        <header class="topbar">
            <span class="chip" style="border-color:@(_card.CategoryColor + "66")">
                <span aria-hidden="true">@_card.CategoryIcon</span> @_card.CategoryName
            </span>
            <span class="level" aria-label="@L["level." + _card.Level]">
                @for (var i = 1; i <= 5; i++) { <i class="@(i <= _card.Level ? "on" : null)"></i> }
            </span>
            <div class="topbar__spacer"></div>
            <span class="muted numeral">@L.Num(_card.Slot + 1) / @L.Num(_card.TotalSlots)</span>
            <Ring Remaining="_remaining" Total="_card.SecondsLimit" Size="38" />
        </header>

        <section class="card card--taq enter" @key="_card.Slot">
            <h1 dir="auto" style="font-size:var(--step-2);text-wrap:balance">@_card.Prompt</h1>

            <MediaBlock Media="_card.Media" />

            @* Kind 0 is the multiple-choice question this app was built around and its markup below
               is untouched — every branch here is an alternative to it, never a change to it. Kinds
               1 and 2 swap the answering surface for the reveal once the answer is in, rather than
               disabling it in place the way a choice question colours its own tiles: there is no
               way to draw "the correct order" or "where the answer was" on top of the control you
               used to say something else. *@
            @if (_card.Kind == 1)
            {
                @if (_result is { CorrectOrder: { Count: > 0 } correctOrder })
                {
                    <SortReveal CorrectOrder="correctOrder" Columns="MySortColumn" />
                }
                else
                {
                    <SortList Items="_card.Choices" @bind-Ordering="_ordering" Disabled="@(_result is not null)" />

                    <button class="btn btn--block" style="margin-top:.9rem" disabled="@(_result is not null)"
                            @onclick="() => AnswerAsync(-1, _ordering.Response)">
                        @L["play.lockIn"]
                    </button>
                }
            }
            else if (_card.Kind == 2)
            {
                @if (_result is { CorrectTarget: { Length: > 0 } target })
                {
                    <MapReveal CorrectTarget="@target" BaseLayer="_card.BaseLayer ?? 1" Answers="MyMapAnswer" />
                }
                else
                {
                    <MapField Shape="_card.TargetShape ?? 0" BaseLayer="_card.BaseLayer ?? 0"
                              @bind-Selection="_pick" Disabled="@(_result is not null)"
                              OnConfirm="() => AnswerAsync(-1, _pick?.Response)" />
                }
            }
            else
            {
            <div class="answers">
                @for (var i = 0; i < _card.Choices.Count; i++)
                {
                    var index = i;
                    <button class="answer @ClassFor(index)" disabled="@(_result is not null)" @onclick="() => AnswerAsync(index)">
                        <span class="answer__key" aria-hidden="true">@Keys[index]</span>
                        <span class="grow" dir="auto">@_card.Choices[index]</span>
                        @if (_result is not null && index == _result.CorrectIndex) { <span aria-hidden="true">✓</span> }
                    </button>
                }
            </div>
            }
        </section>

        @if (_result is { } result)
        {
            <section class="card card--flat enter" style="margin-top:.85rem">
                <div class="row row--between">
                    <strong style="color:@(result.Correct ? "var(--zaferan)" : "var(--anaar)")">
                        @(_timedOut ? L["play.timeUp"] : result.Correct ? L["play.correct"] : L["play.wrong"])
                    </strong>
                    <span class="numeral" style="color:var(--zaferan)">+@L.Num(result.Score)</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(result.Explanation))
                {
                    <p class="muted" dir="auto" style="margin:.6rem 0 0;font-size:var(--step--1)">@result.Explanation</p>
                }

                <button class="btn btn--block" style="margin-top:.9rem" @onclick="AdvanceAsync">
                    @(result.RunFinished ? L["play.finish"] : L["play.next"])
                </button>

                <div style="margin-top:.7rem;text-align:center">
                    <ReportQuestion QuestionId="@_card.QuestionId" />
                </div>
            </section>
        }
    }
</div>

@code {
    private static readonly string[] Keys = ["A", "B", "C", "D"];

    /// <summary>Playing the duel is the whole reason a guest exists.</summary>
    protected override bool AllowsGuest => true;

    [Parameter] public string MatchId { get; set; } = "";

    private QuestionCardDto? _card;
    private AnswerResultDto? _result;
    private int _remaining;
    private bool _timedOut;

    /// <summary>A sorting question's answer as the player is building it: which served item is in
    /// which place. Reset per card, so the next question never inherits the last one's arrangement.</summary>
    private SortOrdering _ordering = SortOrdering.Served(0);

    /// <summary>A map question's answer: the country or the point last tapped, or null before the
    /// first tap.</summary>
    private MapPick? _pick;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _ticking = new();

    protected override async Task LoadAsync() => await NextAsync();

    private async Task NextAsync()
    {
        _result = null;
        _timedOut = false;

        _card = await Api.NextAsync(MatchId);
        if (_card is null)
        {
            Nav.NavigateTo($"/duel/{MatchId}");
            return;
        }

        // A sorting answer starts as the card served it, which is a real answer — "the order you
        // showed me is already right" — and not a null one.
        _ordering = SortOrdering.Served(_card.Choices.Count);
        _pick = null;

        _remaining = _card.SecondsLimit;
        StartClock();
    }

    /// <summary>Decoration only — the server stamped when the question was served and scores on its own clock.</summary>
    private void StartClock()
    {
        _ticking.Cancel();
        _ticking = new CancellationTokenSource();
        var token = _ticking.Token;

        _timer?.Dispose();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(token))
                {
                    _remaining--;
                    await InvokeAsync(StateHasChanged);

                    if (_remaining > 0) continue;

                    // The one caller that may submit an empty answer, and the only place _timedOut
                    // becomes true. A sorting or map answer also travels with a -1 index, so the
                    // index alone can no longer mean "the clock ran out".
                    await InvokeAsync(async () => await AnswerAsync(-1, timedOut: true));
                    return;
                }
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    /// <summary>
    /// One submission path for all three kinds. A choice answer passes its index and no response,
    /// exactly as it always did; a sorting or map answer passes -1 and the response string, which is
    /// the convention <c>AnswerDto</c> documents. The timeout is the third caller, with -1 and no
    /// response at all — which is why <see cref="_timedOut"/> now tests both, rather than reading a
    /// -1 index as "the clock ran out" and mislabelling every sort and map answer as a timeout.
    /// </summary>
    private async Task AnswerAsync(int choice, string? response = null, bool timedOut = false)
    {
        if (_result is not null || _card is null) return;

        // A sorting or map answer with nothing in it is not an answer. Only the clock may submit
        // one, and it says so: without this a confirm button pressed before anything was tapped
        // would record a timeout for a player who is still trying to answer.
        if (!timedOut && choice < 0 && response is null) return;

        _ticking.Cancel();
        _timedOut = timedOut;
        _chosen = choice;

        _result = await Api.AnswerAsync(MatchId, _card.Slot, choice, response)
                  ?? new AnswerResultDto(false, -1, 0, null, false, 0);

        _ = _result.Correct ? Sounds.Correct() : Sounds.Wrong();

        // The run finishing is not the same thing as the duel resolving: an async opponent may still
        // be mid-run, in which case Api.MatchAsync's own Outcome comes back "pending" and
        // SoundOutcomeMapping plays neither cue. Fire-and-forget, and off the UI thread's own path to
        // StateHasChanged below — the extra round trip is only for a sound, never for what the "next"
        // button already needs to know.
        if (_result.RunFinished) _ = PlayDuelOutcomeAsync();

        StateHasChanged();
    }

    /// <summary>See the remark on <see cref="AnswerAsync"/>'s own call site: the only place this page
    /// asks the server anything beyond the answer it just submitted, and only ever to decide between
    /// a win cue, a loss cue, or (a draw, or an opponent not yet finished) neither.</summary>
    private async Task PlayDuelOutcomeAsync()
    {
        var detail = await Api.MatchAsync(MatchId);
        if (detail is null) return;

        _ = SoundOutcomeMapping.ForOutcome(detail.Summary.Outcome) switch
        {
            SoundOutcome.Win => Sounds.Win(),
            SoundOutcome.Loss => Sounds.Loss(),
            _ => Task.CompletedTask
        };
    }

    private async Task AdvanceAsync()
    {
        if (_result?.RunFinished == true) { Nav.NavigateTo($"/duel/{MatchId}"); return; }
        await NextAsync();
    }

    private string? ClassFor(int index)
    {
        if (_result is null) return null;
        if (index == _result.CorrectIndex) return "answer--right";
        if (!_result.Correct && !_timedOut && index == _chosen) return "answer--wrong";
        return "answer--dim";
    }

    private int _chosen = -1;

    /// <summary>
    /// The player's own sorting order for the reveal, taken from the items the card served and the
    /// arrangement they left them in — not from a response string. The server normalises a
    /// submission into stored-index terms and <c>AnswerResultDto</c> does not send that back, so the
    /// client's own arrangement is both the only copy it has and the exact thing the player did.
    /// <para>
    /// Except on a timeout, where it is emphatically not: the rows are still sitting wherever they
    /// were left, but nothing was ever submitted, and showing that arrangement as "yours" would
    /// present an answer the player never gave — and, half the time, mark it wrong.
    /// </para>
    /// </summary>
    private List<SortRevealColumn> MySortColumn =>
        [new(L["result.you"], _timedOut ? null : [.. _ordering.Placed.Select(served => _card!.Choices[served])])];

    /// <inheritdoc cref="MySortColumn"/>
    private List<MapAnswerLine> MyMapAnswer =>
        [new(L["result.you"], _timedOut ? null : _pick?.Response, _result?.Correct)];

    public async ValueTask DisposeAsync()
    {
        await _ticking.CancelAsync();
        _timer?.Dispose();
        _ticking.Dispose();
        base.Dispose();
    }
}
