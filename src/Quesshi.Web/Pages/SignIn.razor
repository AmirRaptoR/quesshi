@page "/signin"
@implements IDisposable
@inject AppState State
@inject Api Api
@inject Translator L
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>@L["app.name"]</PageTitle>

<div class="shell">
    <div class="stack" style="margin-top:12vh">

        <div class="enter" style="text-align:center">
            <div style="width:9rem;margin-inline:auto">
                <Shamseh Mine="@Mark" Theirs="@Mark" Ignite="true" Label="@L["app.name"]" />
            </div>
            <h1 style="margin-top:1.25rem">@L["app.name"]</h1>
            <p class="muted">@L["app.tagline"]</p>
        </div>

        <div class="card card--taq enter">
            @if (_stage == Stage.Email)
            {
                <div class="stack">
                    <div>
                        <span class="eyebrow">@L["auth.title"]</span>
                        <p class="muted" style="margin-top:.4rem">@L["auth.blurb"]</p>
                    </div>

                    <div class="field">
                        <label for="email">@L["auth.email"]</label>
                        <input id="email" class="input" type="email" inputmode="email" autocomplete="email"
                               dir="ltr" @bind="_email" @bind:event="oninput" @onkeydown="OnEmailKey" placeholder="you@example.com" />
                    </div>

                    @if (_error is not null) { <div class="notice notice--bad">@_error</div> }

                    <button class="btn btn--block" disabled="@(_busy || !LooksLikeEmail)" @onclick="SendCodeAsync">
                        @(_busy ? L["common.loading"] : L["auth.send"])
                    </button>
                </div>
            }
            else
            {
                <div class="stack">
                    <div>
                        <span class="eyebrow">@L["auth.code"]</span>
                        <p class="muted" style="margin-top:.4rem" dir="ltr">@_email</p>
                    </div>


                    <input class="input code-input" inputmode="numeric" maxlength="6" dir="ltr" autocomplete="one-time-code"
                           @bind="_code" @bind:event="oninput" @onkeydown="OnCodeKey" />

                    @if (_error is not null) { <div class="notice notice--bad">@_error</div> }

                    <button class="btn btn--block" disabled="@(_busy || _code.Length != 6)" @onclick="VerifyAsync">
                        @(_busy ? L["common.loading"] : L["auth.verify"])
                    </button>
                    <button class="btn btn--ghost btn--block btn--sm" @onclick="() => _stage = Stage.Email">@L["auth.back"]</button>
                </div>
            }
        </div>

        @if (_config?.GoogleEnabled == true)
        {
            <div class="enter" style="display:grid;justify-items:center;gap:.75rem">
                <span class="faint">— @L["auth.google"] —</span>
                <div id="google-button"></div>
            </div>
        }

        <div class="enter" style="text-align:center">
            <LangToggle />
        </div>
    </div>
</div>

@code {
    private enum Stage { Email, Code }

    // Decorative: a half-lit rosette, so the mark says "a duel in progress" rather than "a logo".
    private static readonly IReadOnlyList<bool?> Mark = [true, true, false, true, null, null];

    private Stage _stage = Stage.Email;
    private string _email = "";
    private string _code = "";
    private string? _error;
    private bool _busy;
    private AuthConfigDto? _config;
    private DotNetObjectReference<SignIn>? _self;

    private bool LooksLikeEmail => _email.Contains('@') && _email.Length > 4 && !_email.Contains(' ');

    /// <summary>
    /// Where to go once signed in. An invite link sends people here and wants them back, so the
    /// destination travels in the query string — but only ever as a path on this site: anything
    /// that could point at another host is an open redirect waiting to be mailed to someone.
    /// </summary>
    private string Destination
    {
        get
        {
            var next = QueryState.Read(Nav, "next");
            return next.StartsWith('/') && !next.StartsWith("//") ? next : "/play";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += StateHasChanged;
        await State.InitialiseAsync();

        if (State.SignedIn) { Nav.NavigateTo(Destination); return; }

        _config = await Api.AuthConfigAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_config?.GoogleEnabled != true || _self is not null) return;

        _self = DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("quesshi.google", _config.GoogleClientId, _self); }
        catch { /* Google is optional; the emailed code still works without it. */ }
    }

    [JSInvokable]
    public async Task OnGoogleCredential(string credential)
    {
        var result = await Api.GoogleAsync(credential, State.Lang);
        if (result is null) { _error = L["common.error"]; StateHasChanged(); return; }

        await State.SignInAsync(result);
        Nav.NavigateTo(Destination);
    }

    private async Task OnEmailKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && LooksLikeEmail) await SendCodeAsync();
    }

    private async Task OnCodeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _code.Length == 6) await VerifyAsync();
    }

    private async Task SendCodeAsync()
    {
        _busy = true; _error = null;

        var sent = await Api.RequestOtpAsync(_email.Trim(), State.Lang);
        _busy = false;

        if (sent is null) { _error = L["auth.badEmail"]; return; }

        _code = "";
        _stage = Stage.Code;
    }

    private async Task VerifyAsync()
    {
        _busy = true; _error = null;

        var result = await Api.VerifyOtpAsync(_email.Trim(), _code.Trim(), State.Lang);
        _busy = false;

        if (result is null) { _error = L["auth.badCode"]; return; }

        await State.SignInAsync(result);
        Nav.NavigateTo(Destination);
    }


    public void Dispose()
    {
        State.Changed -= StateHasChanged;
        _self?.Dispose();
    }
}
