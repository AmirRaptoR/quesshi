@page "/admin/voting/categories"
@inherits AdminPageBase

<PageTitle>@L["admin.voting.categories"] · @L["app.name"]</PageTitle>
<AdminShell Title="@L["admin.voting.categories"]">
    @if (Unconfirmed) { <SessionUnconfirmed Busy="Admin.Retrying" OnRetry="RetrySessionAsync" /> }
    else if (Loading) { <div class="spinner" role="status" aria-label="@L["common.loading"]"></div> }
    else
    {
        <AdminToolbar Label="@L["admin.voting.categories"]">
            <Filters><span class="faint">@L.Num(_categories.Count) @L["admin.voting.categories"]</span></Filters>
            <Actions><button type="button" class="btn btn--sm" @onclick="StartNew">@L["admin.voting.addCategory"]</button></Actions>
        </AdminToolbar>
        <AdminCategoryTable Rows="Rows" CanToggle="false" Edit="Edit" Delete="DeleteAsync" />
        @if (_error is not null) { <div class="notice notice--bad" style="margin-top:.8rem">@_error</div> }
        @if (_editorOpen)
        {
        <AdminModal Title="@(_known ? L["admin.edit"] : L["admin.voting.addCategory"])" OnClose="Reset">
            <div class="stack" style="margin-top:.9rem">
                <div class="grid-2"><div class="field"><label>@L["admin.name"] (@L["lang.fa"])</label><input class="input" @bind="_editing.NameFa" /></div><div class="field"><label>@L["admin.name"] (@L["lang.en"])</label><input class="input" dir="ltr" @bind="_editing.NameEn" /></div><div class="field"><label>@L["admin.name"] (@L["lang.nl"])</label><input class="input" dir="ltr" @bind="_editing.NameNl" /></div><div class="field"><label>@L["admin.icon"]</label><input class="input" dir="ltr" inputmode="text" @bind="_editing.Icon" /></div><div class="field"><label>@L["admin.colour"]</label><input class="input" type="color" @bind="_editing.Color" /></div></div>
                <div class="field"><label>@L["admin.voting.categoryId"]</label><input class="input" dir="ltr" @bind="_editing.Id" disabled="@_known" placeholder="@L["admin.voting.categoryIdHint"]" /></div>
                <label class="row" style="gap:.5rem"><input type="checkbox" @bind="_editing.IsActive" /> @L["admin.active"]</label>
                @if (_error is not null) { <div class="notice notice--bad">@_error</div> }
                <div class="row"><button class="btn" @onclick="SaveAsync">@L["admin.save"]</button><button class="btn btn--ghost" @onclick="Reset">@L["admin.cancel"]</button></div>
            </div>
        </AdminModal>
        }
    }
</AdminShell>

@code {
    private List<VotingCategoryDto> _categories = [];
    private VotingCategoryForm _editing = new();
    private bool _known, _editorOpen;
    private string? _error;
    private IReadOnlyList<AdminCategoryRow> Rows => [.. _categories.Select(c =>
        new AdminCategoryRow(c.Id, c.NameFa, c.NameEn, c.NameNl, c.Icon, c.Color, c.IsActive))];

    protected override async Task LoadAsync() => await ReloadAsync();
    private async Task ReloadAsync() { _categories = await Api.AdminVotingCategoriesAsync() ?? []; }
    private void StartNew() { Reset(); _editorOpen = true; }
    private void Edit(string id) { var c = _categories.Single(c => c.Id == id); _editing = VotingCategoryForm.From(c); _known = true; _editorOpen = true; _error = null; }
    private void Reset() { _editing = new VotingCategoryForm(); _known = false; _editorOpen = false; _error = null; }
    private async Task SaveAsync()
    {
        _error = null;
        if (!EmojiIcon.TryNormalize(_editing.Icon, out _)) { _error = L["admin.err.bad_icon"]; return; }
        var result = await Api.TrySaveVotingCategoryAsync(_editing.ToDto());
        if (result.Saved is null) { _error = L.Or("admin.err." + (result.Error ?? "common.error"), L["common.error"]); return; }
        Reset(); await ReloadAsync();
    }
    private async Task DeleteAsync(string id)
    {
        var error = await Api.TryDeleteVotingCategoryAsync(id);
        if (error is not null) { _error = L.Or("admin.err." + error, L["common.error"]); return; }
        await ReloadAsync();
    }
}
