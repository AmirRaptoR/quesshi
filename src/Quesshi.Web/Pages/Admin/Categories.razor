@page "/admin/categories"
@inherits AdminPageBase

<PageTitle>@L["admin.categories"] · @L["app.name"]</PageTitle>

<AdminShell Title="@L["admin.categories"]">
    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="Admin.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else
    {
        <AdminToolbar Label="@L["admin.categories"]">
            <Filters><span class="faint">@L.Num(_categories.Count) @L["admin.categories"]</span></Filters>
            <Actions><button type="button" class="btn btn--sm" @onclick="StartNew">@L["admin.addCategory"]</button></Actions>
        </AdminToolbar>
        <AdminCategoryTable Rows="Rows" Edit="Edit" Toggle="ToggleAsync" Delete="DeleteAsync" />
        @if (_error is not null) { <div class="notice notice--bad" style="margin-top:.8rem">@_error</div> }

        @if (_editorOpen)
        {
        <AdminModal Title="@(_known ? L["admin.edit"] : L["admin.addCategory"])" OnClose="Reset">
            <div class="stack" style="margin-top:.9rem">
                <div class="grid-2">
                    <div class="field"><label>@L["admin.name"] (@L["lang.fa"])</label><input class="input" @bind="_editing.NameFa" /></div>
                    <div class="field"><label>@L["admin.name"] (@L["lang.en"])</label><input class="input" dir="ltr" @bind="_editing.NameEn" /></div>
                    <div class="field"><label>@L["admin.name"] (@L["lang.nl"])</label><input class="input" dir="ltr" @bind="_editing.NameNl" /></div>
                    <div class="field"><label>@L["admin.icon"]</label><input class="input" dir="ltr" inputmode="text" @bind="_editing.Icon" /></div>
                    <div class="field"><label>@L["admin.colour"]</label><input class="input" type="color" @bind="_editing.Color" /></div>
                </div>

                <p class="faint" style="margin:0;font-size:var(--step--1)">@L["admin.categoryHint"]</p>

                <div class="field">
                    <label>@L["admin.promptHelper"]</label>
                    <textarea class="textarea" rows="3" @bind="_editing.PromptHelper"></textarea>
                </div>

                @if (_known)
                {
                    <p class="faint" dir="ltr" style="margin:0;font-size:var(--step--1)">@_editing.Id</p>
                }

                @if (_error is not null) { <div class="notice notice--bad">@_error</div> }

                <div class="row">
                    <button class="btn" @onclick="SaveAsync">@L["admin.save"]</button>
                    <button class="btn btn--ghost" @onclick="Reset">@L["admin.cancel"]</button>
                </div>
            </div>
        </AdminModal>
        }
    }
</AdminShell>

@code {
    private List<CategoryDto> _categories = [];

    private CategoryForm _editing = new();
    private bool _known, _editorOpen;
    private string? _error;
    private IReadOnlyList<AdminCategoryRow> Rows => [.. _categories.Select(c =>
        new AdminCategoryRow(c.Id, c.NameFa, c.NameEn, c.NameNl, c.Icon, c.Color, c.IsActive))];

    protected override async Task LoadAsync() => _categories = await Api.AdminCategoriesAsync() ?? [];

    private void StartNew() { Reset(); _editorOpen = true; }

    private void Edit(string id)
    {
        var category = _categories.Single(c => c.Id == id);
        _editing = CategoryForm.From(category);
        _known = true;
        _editorOpen = true;
    }

    private void Reset()
    {
        _editing = new CategoryForm();
        _known = false;
        _editorOpen = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (_editing.NameEn.Trim().Length == 0)
        {
            _error = L["common.error"];
            return;
        }

        if (!EmojiIcon.TryNormalize(_editing.Icon, out _)) { _error = L["admin.err.bad_icon"]; return; }
        var result = await Api.TrySaveCategoryAsync(_editing.ToDto());
        if (!result.Saved) { _error = L.Or("admin.err." + (result.Error ?? "common.error"), L["common.error"]); return; }

        Reset();
        await LoadAsync();
    }

    private async Task ToggleAsync(string id)
    {
        var category = _categories.Single(c => c.Id == id);
        var result = await Api.TrySaveCategoryAsync(category with { IsActive = !category.IsActive });
        if (!result.Saved) { _error = L.Or("admin.err." + (result.Error ?? "common.error"), L["common.error"]); return; }
        await LoadAsync();
    }

    private async Task DeleteAsync(string id)
    {
        // The server refuses while questions still point at it, which is the behaviour we want.
        if (!await Api.DeleteCategoryAsync(id)) { _error = L["common.error"]; return; }
        await LoadAsync();
    }
}
