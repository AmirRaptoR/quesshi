@page "/admin/password"
@inherits AdminPageBase

<PageTitle>@L["admin.auth.changeTitle"]</PageTitle>

<div class="shell">
    @if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else
    {
        <div class="stack" style="margin-top:8vh">
            <div class="card card--taq enter">
                <div class="stack">
                    <div>
                        <span class="eyebrow">@L["admin.auth.changeTitle"]</span>
                        <p class="faint" style="margin-top:.4rem;font-size:var(--step--1)">
                            @L.Format("admin.auth.signedInAs", Admin.Admin!.Username)
                        </p>
                    </div>

                    @if (Admin.Admin!.MustChangePassword)
                    {
                        <div class="notice">@L["admin.auth.mustChange"]</div>
                    }

                    <div class="field">
                        <label for="email">@L["admin.auth.email"]</label>
                        <div class="row">
                            <input id="email" class="input grow" type="email" dir="ltr" @bind="_email" @bind:event="oninput" />
                            <button class="btn btn--ghost btn--sm" disabled="@(_savingEmail || _email.Trim().Length == 0)" @onclick="SaveEmailAsync">
                                @L["admin.auth.saveEmail"]
                            </button>
                        </div>
                        <span class="faint" style="font-size:var(--step--1)">@L["admin.auth.emailHint"]</span>

                        @if (IsPlaceholder)
                        {
                            <div class="notice notice--bad" style="margin-top:.4rem">@L["admin.auth.placeholder"]</div>
                        }
                        @if (_emailMessage is not null)
                        {
                            <div class="notice @(_emailOk ? "notice--good" : "notice--bad")" style="margin-top:.4rem">@_emailMessage</div>
                        }
                    </div>

                    <hr style="border:0;border-top:1px solid var(--line);margin:.4rem 0" />

                    <div class="field">
                        <label for="current">@L["admin.auth.currentPassword"]</label>
                        <input id="current" class="input" type="password" dir="ltr" autocomplete="current-password" @bind="_current" @bind:event="oninput" />
                    </div>

                    <PasswordFields @bind-Password="_password" @bind-Repeat="_repeat" />

                    @if (_message is not null)
                    {
                        <div class="notice @(_ok ? "notice--good" : "notice--bad")">@_message</div>
                    }

                    <button class="btn btn--block" disabled="@(_busy || !Filled)" @onclick="SubmitAsync">
                        @(_busy ? L["common.loading"] : L["admin.auth.change"])
                    </button>

                    @if (!Admin.Admin!.MustChangePassword)
                    {
                        <a class="btn btn--ghost btn--block btn--sm" href="/admin">@L["admin.dashboard"]</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _current = "", _password = "", _repeat = "";
    private string _email = "";
    private string? _message, _emailMessage;
    private bool _busy, _ok, _savingEmail, _emailOk;

    /// <summary>The bootstrap account ships with an address no mail can reach.</summary>
    private bool IsPlaceholder
    {
        get
        {
            var email = Admin.Admin?.Email ?? "";
            return !email.Contains('@')
                || email.EndsWith(".local", StringComparison.OrdinalIgnoreCase)
                || email.EndsWith("@localhost", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override Task LoadAsync()
    {
        _email = Admin.Admin?.Email ?? "";
        return Task.CompletedTask;
    }

    private async Task SaveEmailAsync()
    {
        _savingEmail = true;
        _emailMessage = null;

        var error = await Api.ChangeEmailAsync(_email.Trim());
        _savingEmail = false;

        if (error is null)
        {
            _emailOk = true;
            _emailMessage = L["admin.auth.emailSaved"];
            if (await Api.MeAsync() is { } me) Admin.SetAdmin(me);
            return;
        }

        _emailOk = false;
        _emailMessage = L[error.Reason];
    }

    /// <summary>This is the one page a must-change admin is allowed to reach.</summary>
    protected override bool AllowWhilePasswordChangePending => true;

    private bool Filled => _current.Length > 0 && _password.Length > 0 && _repeat.Length > 0;

    private async Task SubmitAsync()
    {
        _message = null;
        _ok = false;
        var wasForced = Admin.Admin!.MustChangePassword;

        if (_password != _repeat) { _message = L["admin.auth.mismatch"]; return; }

        _busy = true;
        var error = await Api.ChangePasswordAsync(_current, _password);
        _busy = false;

        if (error is null)
        {
            _ok = true;
            _message = L["admin.auth.changed"];
            _current = _password = _repeat = "";

            if (await Api.MeAsync() is { } me) Admin.SetAdmin(me);

            // A forced change is a gate: once it is done, get out of the way. A voluntary one
            // stays put, so the confirmation is visible and the email field is still to hand.
            if (wasForced) Nav.NavigateTo("/admin");
            return;
        }

        _message = error.Problems is { Count: > 0 }
            ? string.Join(" ", error.Problems.Select(p => L[p]))
            : L[error.Reason];
    }
}
