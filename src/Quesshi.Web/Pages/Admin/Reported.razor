@page "/admin/reported"
@inherits AdminPageBase

<PageTitle>@L["admin.reported"] · @L["app.name"]</PageTitle>

<div class="shell shell--wide">
    <header class="topbar"><h1 class="topbar__title">@L["admin.reported"]</h1></header>
    <AdminNav />

    @if (Unconfirmed)
    {
        <SessionUnconfirmed Busy="Admin.Retrying" OnRetry="RetrySessionAsync" />
    }
    else if (Loading)
    {
        <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
    }
    else if (_page is null or { Items.Count: 0 })
    {
        <p class="empty">@L["admin.noReports"]</p>
    }
    else
    {
        <Pager Total="_page.Total" Page="_pageNumber" PageSize="_pageSize"
               PageChanged="GoToPageAsync" PageSizeChanged="SetPageSizeAsync" />

        <div class="stack" style="margin-top:.75rem">
            @foreach (var question in _page.Items)
            {
                <article class="card">
                    <div class="row row--between" style="gap:.5rem;flex-wrap:wrap">
                        <div class="row" style="gap:.4rem;flex-wrap:wrap">
                            <span class="chip chip--loss">@ReportLabel(question.ReportCount)</span>
                            <span class="chip" dir="ltr">@question.Lang</span>
                            <span class="chip">@CategoryName(question.CategoryId)</span>
                            <span class="chip">@L[$"level.{question.Level}"]</span>
                            @if (question.Status == "pending")
                            {
                                <span class="chip chip--loss">@L["admin.suppressed"]</span>
                            }
                        </div>

                        <div class="row" style="gap:.35rem">
                            <button class="btn btn--sm" @onclick="() => DismissAsync(question.Id)">@L["admin.dismiss"]</button>
                            <button class="btn btn--ghost btn--sm" @onclick="() => RejectAsync(question.Id)">@L["admin.reject"]</button>
                            <button class="btn btn--sm btn--icon btn--icon-danger" title="@L["admin.delete"]"
                                    aria-label="@L["admin.delete"]" @onclick="() => DeleteAsync(question.Id)">
                                <Icon Name="trash" />
                            </button>
                        </div>
                    </div>

                    <p dir="auto" style="margin:.6rem 0 .4rem;font-weight:600">@question.Prompt</p>

                    <MediaBlock Media="question.Media" Compact="true" Autoplay="false" Loop="false" />

                    <div class="row" dir="auto" style="gap:.4rem;flex-wrap:wrap;font-size:var(--step--1);margin-top:.4rem">
                        @for (var i = 0; i < question.Choices.Count; i++)
                        {
                            <span class="chip @(i == question.CorrectIndex ? "chip--win" : null)">@question.Choices[i]</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(question.Explanation))
                    {
                        <p class="muted" dir="auto" style="margin:.55rem 0 0;font-size:var(--step--1)">@question.Explanation</p>
                    }

                    <div style="margin-top:.7rem;border-top:1px solid var(--line);padding-top:.55rem">
                        <span class="eyebrow">@L["admin.reportedBy"]</span>
                        <div class="stack" style="gap:.25rem;margin-top:.4rem">
                            @foreach (var report in question.Reports)
                            {
                                <div class="row" style="gap:.5rem;font-size:var(--step--1)">
                                    <span class="chip chip--loss">@L[$"report.{report.Reason}"]</span>
                                    <span class="grow muted">@report.PlayerName</span>
                                    <span class="faint" dir="ltr">@report.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <Pager Total="_page.Total" Page="_pageNumber" PageSize="_pageSize"
               PageChanged="GoToPageAsync" PageSizeChanged="SetPageSizeAsync" />
    }
</div>

@code {
    /// <summary>"1 reports" reads like a bug, so the singular gets its own string.</summary>
    private string ReportLabel(int count)
        => count == 1 ? L["admin.reportCountOne"] : L.Format("admin.reportCount", L.Num(count));

    private AdminQuestionPageDto? _page;
    private List<CategoryDto> _categories = [];
    private int _pageNumber = 1;
    private int _pageSize = 25;

    /// <summary>A category's display name, falling back to the slug for one that has since been deleted.</summary>
    private string CategoryName(string id)
        => _categories.FirstOrDefault(c => c.Id == id) is { } category ? L.Name(category) : id;

    protected override async Task LoadAsync()
    {
        _categories = await Api.AdminCategoriesAsync() ?? [];
        _pageNumber = Math.Max(1, QueryState.ReadInt(Nav, "page", 1));
        _pageSize = QueryState.ReadInt(Nav, "size", 25) is var size && size is 25 or 50 or 100 ? size : 25;
        await FetchAsync();
    }

    private async Task FetchAsync()
    {
        QueryState.Write(Nav, new Dictionary<string, string?>
        {
            ["page"] = _pageNumber == 1 ? null : _pageNumber.ToString(),
            ["size"] = _pageSize == 25 ? null : _pageSize.ToString()
        });

        _page = await Api.ReportedAsync((_pageNumber - 1) * _pageSize, _pageSize);

        // Clearing the last item on the last page would otherwise leave an empty screen.
        if (_page is not null)
        {
            var pages = Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_pageSize));
            if (_pageNumber > pages)
            {
                _pageNumber = pages;
                _page = await Api.ReportedAsync((_pageNumber - 1) * _pageSize, _pageSize);
            }
        }

        StateHasChanged();
    }

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = page;
        await FetchAsync();
    }

    private async Task SetPageSizeAsync(int size)
    {
        _pageSize = size;
        _pageNumber = 1;
        await FetchAsync();
    }

    private async Task DismissAsync(string id) { await Api.DismissReportsAsync(id); await FetchAsync(); }
    private async Task RejectAsync(string id) { await Api.RejectAsync(id); await FetchAsync(); }
    private async Task DeleteAsync(string id) { await Api.DeleteQuestionAsync(id); await FetchAsync(); }
}
