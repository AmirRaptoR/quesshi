@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AppState State
@inject Translator L
@inject NavigationManager Nav
@inject LobbyClient Lobby

@if (!State.Ready)
{
    <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
}
else
{
    @* Behind the same gate as the tab bar below: a guest has no friends list, so nothing here is ever
       theirs to see. More than one can show at once now — issue #51 removes the old one-at-a-time
       exclusivity, so being invited to several lobbies simultaneously is normal, not an edge case. *@
    @if (State.SignedIn && !State.IsGuest)
    {
        @foreach (var challenge in _challenges)
        {
            <div class="card card--taq enter" style="position:sticky;top:0;z-index:20;margin-bottom:.6rem">
                <div class="row row--between">
                    <span>@L.Format("challenge.title", challenge.ChallengerName)</span>
                    <span class="numeral faint">@L.Format("challenge.timeLeft", Math.Max(0, (int)(challenge.ExpiresAt - DateTimeOffset.UtcNow).TotalSeconds))</span>
                </div>
                <div class="row" style="margin-top:.6rem;gap:.5rem">
                    <button class="btn btn--sm" @onclick="() => AcceptAsync(challenge)">@L["challenge.accept"]</button>
                    <button class="btn btn--ghost btn--sm" @onclick="() => DeclineAsync(challenge)">@L["challenge.decline"]</button>
                </div>
            </div>
        }
    }

    @Body

    @* A guest has exactly one page; a row of tabs to places they cannot open is worse than no tabs. *@
    @if (State.SignedIn && !State.IsGuest && !IsAdminArea)
    {
        <nav class="tabbar" aria-label="@L["app.name"]">
            <NavLink class="tabbar__link" href="/play">
                <span class="tabbar__icon" aria-hidden="true">◈</span>@L["nav.play"]
            </NavLink>
            <NavLink class="tabbar__link" href="/duels">
                <span class="tabbar__icon" aria-hidden="true">⚔</span>@L["nav.matches"]
            </NavLink>
            <NavLink class="tabbar__link" href="/ranks">
                <span class="tabbar__icon" aria-hidden="true">▲</span>@L["nav.ranks"]
            </NavLink>
            <NavLink class="tabbar__link" href="/profile">
                <span class="tabbar__icon" aria-hidden="true">☾</span>@L["nav.profile"]
            </NavLink>
        </nav>
    }
}

@code {
    /// <summary>The admin panel has its own navigation; it should not wear the game's chrome.</summary>
    private bool IsAdminArea => new Uri(Nav.Uri).AbsolutePath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);

    /// <summary>Every invitation currently pending for this player, oldest first — plural because
    /// issue #51 removed the single-commitment exclusivity that used to make one enough. Keyed
    /// implicitly by <c>ChallengeId</c>: <see cref="OnChallengeReceived"/> replaces rather than
    /// duplicates an entry, in case a reconnect redelivers one already showing.</summary>
    private List<LiveChallengeDto> _challenges = [];
    private System.Threading.Timer? _ticker;

    /// <summary>Whether <see cref="Lobby"/>'s underlying connection is currently established. Set from
    /// the outcome of each connect attempt — never assumed — and cleared by <see cref="Lobby"/>'s
    /// <c>Closed</c> event, so a later sync retries rather than believing a dead connection is live.</summary>
    private bool _lobbyConnected;

    /// <summary>Separate from <see cref="_lobbyConnected"/>: whether the challenge events, ticker and
    /// <c>Closed</c> handler are wired. Tracks sign-in state, not connect success, so a failed connect
    /// attempt still leaves the player able to receive a challenge once some other path — a button's own
    /// <see cref="LobbyClient.EnsureConnectedAsync"/> — brings the connection up, and a later successful
    /// sync never wires the same handlers a second time.</summary>
    private bool _lobbySubscribed;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        await State.InitialiseAsync();
        await SyncLobbyConnectionAsync();
    }

    private void OnStateChanged()
    {
        StateHasChanged();
        _ = SyncLobbyConnectionAsync();
    }

    /// <summary>The same "signed in and not a guest" condition the tab bar above already gates on: a
    /// guest has no door into presence, the queue or a challenge, so it never opens this connection.</summary>
    private async Task SyncLobbyConnectionAsync()
    {
        var shouldConnect = State.SignedIn && !State.IsGuest;

        if (shouldConnect && !_lobbySubscribed)
        {
            _lobbySubscribed = true;
            WireLobbyEvents();
            StartTicker();
        }
        else if (!shouldConnect && _lobbySubscribed)
        {
            _lobbySubscribed = false;
            UnwireLobbyEvents();
            StopTicker();
            _challenges = [];
        }

        if (shouldConnect)
        {
            // Idempotent: a connection a button already brought up via EnsureConnectedAsync resolves
            // to true here with no second start attempt, rather than assuming it is still down.
            _lobbyConnected = await Lobby.EnsureConnectedAsync();
        }
        else if (_lobbyConnected)
        {
            _lobbyConnected = false;
            await Lobby.StopAsync();
        }
    }

    private void WireLobbyEvents()
    {
        Lobby.ChallengeReceived += OnChallengeReceived;
        Lobby.ChallengeExpired += OnChallengeCleared;
        Lobby.ChallengeDeclined += OnChallengeCleared;
        Lobby.ChallengeFailed += OnChallengeCleared;
        Lobby.DuelReady += OnDuelReady;
        Lobby.Closed += OnLobbyClosed;
    }

    private void UnwireLobbyEvents()
    {
        Lobby.ChallengeReceived -= OnChallengeReceived;
        Lobby.ChallengeExpired -= OnChallengeCleared;
        Lobby.ChallengeDeclined -= OnChallengeCleared;
        Lobby.ChallengeFailed -= OnChallengeCleared;
        Lobby.DuelReady -= OnDuelReady;
        Lobby.Closed -= OnLobbyClosed;
    }

    /// <summary>Fires for a drop as much as for our own intentional <c>StopAsync</c> above — either way,
    /// the connection is down, so the flag should say so. It does not itself restart anything: recovery
    /// is on-demand, off whichever <see cref="SyncLobbyConnectionAsync"/> or button press comes next.</summary>
    private void OnLobbyClosed() => _lobbyConnected = false;

    private void OnChallengeReceived(LiveChallengeDto challenge) => InvokeAsync(() =>
    {
        // Replace rather than duplicate: a reconnect redelivers every still-pending invitation (see
        // LobbyHub.OnConnectedAsync), which would otherwise stack a second banner for one already showing.
        _challenges = [.. _challenges.Where(c => c.ChallengeId != challenge.ChallengeId), challenge];
        StateHasChanged();
    });

    private void OnChallengeCleared(string challengeId) => Remove(challengeId);

    private void OnDuelReady(string matchId) => InvokeAsync(() => Nav.NavigateTo($"/live/{matchId}"));

    private void Remove(string challengeId) => InvokeAsync(() =>
    {
        var before = _challenges.Count;
        _challenges = [.. _challenges.Where(c => c.ChallengeId != challengeId)];
        if (_challenges.Count != before) StateHasChanged();
    });

    /// <summary>Each banner's time-left counts down locally; a challenge past its deadline hides
    /// itself even before any server round trip confirms it.</summary>
    private void StartTicker()
    {
        _ticker ??= new System.Threading.Timer(_ =>
        {
            var expired = _challenges.Where(c => c.ExpiresAt <= DateTimeOffset.UtcNow).ToList();
            foreach (var c in expired) Remove(c.ChallengeId);
            if (expired.Count == 0) InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopTicker()
    {
        _ticker?.Dispose();
        _ticker = null;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => StateHasChanged();

    private async Task AcceptAsync(LiveChallengeDto challenge)
    {
        await Lobby.AcceptAsync(challenge.ChallengeId);
        // Navigation happens off the DuelReady push, delivered to both players alike. The banner
        // itself clears via the same push removing it, exactly as accepting always has.
    }

    private async Task DeclineAsync(LiveChallengeDto challenge)
    {
        Remove(challenge.ChallengeId);
        await Lobby.DeclineAsync(challenge.ChallengeId);
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_lobbySubscribed) UnwireLobbyEvents();
        StopTicker();
    }
}
