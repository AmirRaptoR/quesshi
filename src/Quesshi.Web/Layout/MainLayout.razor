@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AppState State
@inject Translator L
@inject NavigationManager Nav
@inject LobbyClient Lobby

@if (!State.Ready)
{
    <div class="spinner" role="status" aria-label="@L["common.loading"]"></div>
}
else
{
    @* Behind the same gate as the tab bar below: a guest has no friends list, so nothing here is ever theirs to see. *@
    @if (State.SignedIn && !State.IsGuest && _challenge is { } challenge)
    {
        <div class="card card--taq enter" style="position:sticky;top:0;z-index:20;margin-bottom:.6rem">
            <div class="row row--between">
                <span>@L.Format("challenge.title", challenge.ChallengerName)</span>
                <span class="numeral faint">@L.Format("challenge.timeLeft", Math.Max(0, (int)(challenge.ExpiresAt - DateTimeOffset.UtcNow).TotalSeconds))</span>
            </div>
            <div class="row" style="margin-top:.6rem;gap:.5rem">
                <button class="btn btn--sm" @onclick="AcceptAsync">@L["challenge.accept"]</button>
                <button class="btn btn--ghost btn--sm" @onclick="DeclineAsync">@L["challenge.decline"]</button>
            </div>
        </div>
    }

    @Body

    @* A guest has exactly one page; a row of tabs to places they cannot open is worse than no tabs. *@
    @if (State.SignedIn && !State.IsGuest && !IsAdminArea)
    {
        <nav class="tabbar" aria-label="@L["app.name"]">
            <NavLink class="tabbar__link" href="/play">
                <span class="tabbar__icon" aria-hidden="true">◈</span>@L["nav.play"]
            </NavLink>
            <NavLink class="tabbar__link" href="/duels">
                <span class="tabbar__icon" aria-hidden="true">⚔</span>@L["nav.matches"]
            </NavLink>
            <NavLink class="tabbar__link" href="/ranks">
                <span class="tabbar__icon" aria-hidden="true">▲</span>@L["nav.ranks"]
            </NavLink>
            <NavLink class="tabbar__link" href="/profile">
                <span class="tabbar__icon" aria-hidden="true">☾</span>@L["nav.profile"]
            </NavLink>
        </nav>
    }
}

@code {
    /// <summary>The admin panel has its own navigation; it should not wear the game's chrome.</summary>
    private bool IsAdminArea => new Uri(Nav.Uri).AbsolutePath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);

    private LiveChallengeDto? _challenge;
    private System.Threading.Timer? _ticker;

    /// <summary>Whether <see cref="Lobby"/> is currently started — the app has exactly one, and it tracks
    /// sign-in state rather than being restarted on every render.</summary>
    private bool _lobbyConnected;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        await State.InitialiseAsync();
        await SyncLobbyConnectionAsync();
    }

    private void OnStateChanged()
    {
        StateHasChanged();
        _ = SyncLobbyConnectionAsync();
    }

    /// <summary>The same "signed in and not a guest" condition the tab bar above already gates on: a
    /// guest has no door into presence, the queue or a challenge, so it never opens this connection.</summary>
    private async Task SyncLobbyConnectionAsync()
    {
        var shouldConnect = State.SignedIn && !State.IsGuest;
        if (shouldConnect && !_lobbyConnected)
        {
            _lobbyConnected = true;
            WireLobbyEvents();
            StartTicker();

            try
            {
                await Lobby.StartAsync();
            }
            catch
            {
                // A dropped lobby connection is not fatal to the rest of the app; the automatic
                // reconnect keeps trying, and OnConnectedAsync re-delivers anything still pending.
            }
        }
        else if (!shouldConnect && _lobbyConnected)
        {
            _lobbyConnected = false;
            UnwireLobbyEvents();
            StopTicker();
            _challenge = null;
            await Lobby.StopAsync();
        }
    }

    private void WireLobbyEvents()
    {
        Lobby.ChallengeReceived += OnChallengeReceived;
        Lobby.ChallengeExpired += OnChallengeCleared;
        Lobby.ChallengeDeclined += OnChallengeCleared;
        Lobby.ChallengeFailed += OnChallengeCleared;
        Lobby.DuelReady += OnDuelReady;
    }

    private void UnwireLobbyEvents()
    {
        Lobby.ChallengeReceived -= OnChallengeReceived;
        Lobby.ChallengeExpired -= OnChallengeCleared;
        Lobby.ChallengeDeclined -= OnChallengeCleared;
        Lobby.ChallengeFailed -= OnChallengeCleared;
        Lobby.DuelReady -= OnDuelReady;
    }

    private void OnChallengeReceived(LiveChallengeDto challenge)
        => InvokeAsync(() => { _challenge = challenge; StateHasChanged(); });

    private void OnChallengeCleared(string challengeId) => ClearIfCurrent(challengeId);

    private void OnDuelReady(string matchId) => InvokeAsync(() => Nav.NavigateTo($"/live/{matchId}"));

    private void ClearIfCurrent(string challengeId)
    {
        if (_challenge?.ChallengeId == challengeId)
            InvokeAsync(() => { _challenge = null; StateHasChanged(); });
    }

    /// <summary>The banner's time-left counts down locally; a challenge past its deadline hides itself
    /// even before any server round trip confirms it.</summary>
    private void StartTicker()
    {
        _ticker ??= new System.Threading.Timer(_ =>
        {
            if (_challenge is { } c && c.ExpiresAt <= DateTimeOffset.UtcNow)
                ClearIfCurrent(c.ChallengeId);
            else
                InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopTicker()
    {
        _ticker?.Dispose();
        _ticker = null;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => StateHasChanged();

    private async Task AcceptAsync()
    {
        if (_challenge is not { } challenge) return;
        await Lobby.AcceptAsync(challenge.ChallengeId);
        // Navigation happens off the DuelReady push, delivered to both players alike.
    }

    private async Task DeclineAsync()
    {
        if (_challenge is not { } challenge) return;
        _challenge = null;
        await Lobby.DeclineAsync(challenge.ChallengeId);
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_lobbyConnected) UnwireLobbyEvents();
        StopTicker();
    }
}
