@* New password plus confirmation, with the rule stated up front rather than after a rejection. *@
@inject Translator L

<div class="field">
    <label for="@_id">@L["admin.auth.newPassword"]</label>
    <input id="@_id" class="input" type="password" dir="ltr" autocomplete="@Autocomplete"
           value="@Password" @oninput="@(e => PasswordChanged.InvokeAsync(e.Value?.ToString() ?? ""))" />
    <span class="faint" style="font-size:var(--step--1)">@L["password.rules"]</span>
</div>

<div class="field">
    <label for="@_repeatId">@L["admin.auth.confirmPassword"]</label>
    <input id="@_repeatId" class="input" type="password" dir="ltr" autocomplete="@Autocomplete"
           value="@Repeat" @oninput="@(e => RepeatChanged.InvokeAsync(e.Value?.ToString() ?? ""))" />
</div>

@code {
    [Parameter] public string Password { get; set; } = "";
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }

    [Parameter] public string Repeat { get; set; } = "";
    [Parameter] public EventCallback<string> RepeatChanged { get; set; }

    [Parameter] public string Autocomplete { get; set; } = "new-password";

    private readonly string _id = $"pw-{Guid.NewGuid():N}";
    private readonly string _repeatId = $"pw2-{Guid.NewGuid():N}";
}
