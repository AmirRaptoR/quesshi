@implements IDisposable
@inject Translator L

<nav class="admin-nav" aria-label="@L["admin.dashboard"]">
    <div class="admin-nav__pages">
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin" Match="NavLinkMatch.All">@L["admin.dashboard"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/questions">@L["admin.questions"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/categories">@L["admin.categories"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/matching/questions">@L["admin.matching.questions"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/matching/categories">@L["admin.matching.categories"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/reported">@L["admin.reported"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/users">@L["admin.users"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/live">@L["admin.live"]</NavLink>
        <NavLink class="admin-nav__link" ActiveClass="is-active" href="/admin/accounts">@L["admin.accounts"]</NavLink>
    </div>

    <details class="admin-account">
        <summary class="admin-account__summary">
            <span class="admin-account__avatar" aria-hidden="true">@Initial</span>
            <span>@(Admin.Admin?.Username ?? "—")</span>
        </summary>
        <div class="admin-account__menu">
            <div class="admin-account__label">@L.Format("admin.auth.signedInAs", Admin.Admin?.Username ?? "")</div>
            <div class="admin-account__language"><LangToggle /></div>
            <a class="admin-account__item" href="/admin/password">@L["admin.auth.change"]</a>
            <button type="button" class="admin-account__item admin-account__item--danger" @onclick="SignOutAsync">@L["admin.auth.signOut"]</button>
        </div>
    </details>
</nav>

@code {
    [Inject] private AdminState Admin { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    // The nav is drawn before the session has resolved, so it has to redraw when it does.
    protected override void OnInitialized() => Admin.Changed += StateHasChanged;

    private string Initial => Admin.Admin?.Username is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?";

    public void Dispose() => Admin.Changed -= StateHasChanged;

    private async Task SignOutAsync()
    {
        await Admin.SignOutAsync();
        Nav.NavigateTo("/admin/login");
    }
}
