@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Kinds.Order
@using Quesshi.Shared

<section data-kind="order" class="kind-editor">
    @if (Value is { } payload)
    {
        @for (var index = 0; index < payload.Items?.Count; index++)
        {
            var item = index;
            <label>
                Item identifier
                <input data-item-id="@item" value="@payload.Items![item]?.Id" @oninput="e => ChangeId(item, e.Value?.ToString())" />
            </label>
            <label>
                Item text
                <input data-item-text="@item" value="@payload.Items![item]?.Text" @oninput="e => ChangeText(item, e.Value?.ToString())" />
            </label>
        }
        <button type="button" data-payload-save @onclick="EmitAsync">Save</button>
    }
    <ul class="validation-problems">
        @foreach (var problem in Problems)
        {
            <li data-problem="@problem.Code">@problem.Message</li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public object? Payload { get; set; }
    [Parameter, EditorRequired] public EventCallback<object?> PayloadChanged { get; set; }
    [Parameter, EditorRequired] public string Lang { get; set; } = "en";
    private object? sourcePayload;
    private OrderPayload? Value { get; set; }
    private IReadOnlyList<Problem> Problems => Value is { } payload ? new OrderKind().Validate(payload, new ValidateEnv(Lang)) : [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(sourcePayload, Payload)) return;
        sourcePayload = Payload;
        Value = Payload as OrderPayload;
    }

    private void ChangeId(int index, string? id) => ChangeItem(index, item => item with { Id = id });
    private void ChangeText(int index, string? text) => ChangeItem(index, item => item with { Text = text });

    private void ChangeItem(int index, Func<OrderItem, OrderItem> change)
    {
        if (Value?.Items is not { } items || index >= items.Count || items[index] is not { } item) return;
        var updated = items.ToArray();
        updated[index] = change(item);
        Value = Value with { Items = updated };
    }

    private Task EmitAsync() => PayloadChanged.InvokeAsync(Value);
}
