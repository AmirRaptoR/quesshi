@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Quesshi.Kinds.Order
@implements IAsyncDisposable

@if (Value is { } card)
{
    <div data-kind="order" data-version="1">
        <ol @ref="list" class="sortlist" @onpointermove="OnPointerMove" @onpointerup="EndDragAsync" @onpointercancel="EndDragAsync">
            @for (var index = 0; index < Ordering.ItemIds.Count; index++)
            {
                var place = index;
                var item = ItemAt(place);
                if (item is null) { continue; }
                <li class="sortrow" @key="item.Id">
                    <button type="button" class="sortrow__grip" data-grip data-place="@place" disabled="@Disabled"
                            aria-label="Move @item.Text" @onpointerdown="e => StartDragAsync(place, e)"
                            @onkeydown="e => OnKeyAsync(place, e)">
                        <span aria-hidden="true">↕</span>
                    </button>
                    <span class="grow" dir="auto">@item.Text</span>
                    <span class="sortrow__place numeral">@(place + 1)</span>
                </li>
            }
        </ol>
        <button type="button" data-order-submit disabled="@Disabled" @onclick="SubmitAsync">Submit order</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public object? Card { get; set; }
    [Parameter, EditorRequired] public EventCallback<object?> OnAnswer { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Inject] public IJSRuntime JS { get; set; } = null!;

    private OrderCard? currentCard;
    private OrderOrdering Ordering { get; set; } = OrderOrdering.Served([]);
    private int? dragging;
    private long? draggingPointerId;
    private double[] dragMidpoints = [];
    private ElementReference list;
    private IJSObjectReference? module;
    private OrderCard? Value => Card as OrderCard;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(currentCard, Value)) return;
        currentCard = Value;
        Ordering = OrderOrdering.Served(Value?.Items.Select(item => item.Id ?? "") ?? []);
    }

    private OrderItem? ItemAt(int place)
    {
        var id = Ordering.ItemIds[place];
        return Value?.Items.FirstOrDefault(item => item.Id == id);
    }

    private async Task StartDragAsync(int place, PointerEventArgs args)
    {
        if (Disabled) return;
        dragging = place;
        draggingPointerId = args.PointerId;
        var script = await ModuleAsync();
        dragMidpoints = await script.InvokeAsync<double[]>("midpoints", list);
        await script.InvokeVoidAsync("capture", list, args.PointerId);
    }

    private void OnPointerMove(PointerEventArgs args)
    {
        if (Disabled || dragging is not { } from || draggingPointerId != args.PointerId) return;
        var to = OrderDrag.TargetPlace(dragMidpoints, args.ClientY);
        if (to < 0 || to == from) return;
        Ordering = Ordering.Move(from, to);
        dragging = to;
    }

    private async Task EndDragAsync(PointerEventArgs args)
    {
        if (dragging is null || draggingPointerId != args.PointerId) return;
        dragging = null;
        dragMidpoints = [];
        var pointerId = draggingPointerId;
        draggingPointerId = null;
        if (pointerId is { } activePointerId && module is not null)
            await module.InvokeVoidAsync("release", list, activePointerId);
    }

    private void OnKeyAsync(int place, KeyboardEventArgs args)
    {
        if (Disabled) return;
        Ordering = args.Key switch
        {
            "ArrowUp" => Ordering.MoveUp(place),
            "ArrowDown" => Ordering.MoveDown(place),
            _ => Ordering
        };
    }

    private async ValueTask<IJSObjectReference> ModuleAsync() => module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Quesshi.Web.Plugins/Order/OrderPlay.razor.js");

    public async ValueTask DisposeAsync()
    {
        if (module is not null) await module.DisposeAsync();
    }

    private Task SubmitAsync() => Disabled ? Task.CompletedTask : OnAnswer.InvokeAsync(new OrderAnswer(Ordering.ItemIds));
}
