@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Kinds.Flashcard
@using Quesshi.Shared

<section data-kind="flashcard" class="kind-editor">
    @if (Value is { } payload)
    {
        <label>
            Back text
            <textarea data-flashcard-back value="@payload.Back" @oninput="e => ChangeBack(e.Value?.ToString())"></textarea>
        </label>
        <button type="button" data-payload-save @onclick="EmitAsync">Save</button>
    }
    <ul class="validation-problems">
        @foreach (var problem in Problems)
        {
            <li data-problem="@problem.Code">@problem.Message</li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public object? Payload { get; set; }
    [Parameter, EditorRequired] public EventCallback<object?> PayloadChanged { get; set; }
    [Parameter, EditorRequired] public string Lang { get; set; } = "en";

    private object? sourcePayload;
    private FlashcardPayload? Value { get; set; }
    private IReadOnlyList<Problem> Problems => Value is { } payload ? new FlashcardKind().Validate(payload, new ValidateEnv(Lang)) : [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(sourcePayload, Payload)) return;
        sourcePayload = Payload;
        Value = Payload as FlashcardPayload;
    }

    private void ChangeBack(string? back) => Value = Value is { } payload ? payload with { Back = back } : null;

    private Task EmitAsync() => PayloadChanged.InvokeAsync(Value);
}
