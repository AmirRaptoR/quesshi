@using System.Net.Http.Json
@using System.Text.Json
@using Quesshi.Shared
@using Quesshi.Web.Services
@inject ClientHttp Http
@inject ReportsApi Api
@inject IClientViewer Viewer

@* The finished session's reportable questions, for result screens that do not list their questions themselves. *@
@if (_enabled && !Viewer.IsGuest && _items.Count > 0)
{
    <ol class="stack" data-reportable-questions>
        @foreach (var item in _items)
        {
            <li @key="item.Slot" data-reportable-question="@item.Slot">
                <span data-field="prompt" dir="auto">@item.Prompt</span>
                <ReportQuestion QuestionId="item.QuestionId!.Value" />
            </li>
        }
    </ol>
}

@code {
    private const int PageSize = 50;
    private readonly List<SessionQuestionHistoryItem> _items = [];
    private bool _enabled;
    private string? _loadedId;

    [Parameter, EditorRequired] public string SessionId { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == SessionId) return;
        _loadedId = SessionId;
        _items.Clear();
        _enabled = !Viewer.IsGuest && await Api.IsEnabledAsync();
        if (!_enabled) return;

        var id = SessionId;
        int? after = null;
        try
        {
            do
            {
                var path = $"/api/sessions/{Uri.EscapeDataString(id)}/history?limit={PageSize}" + (after is { } slot ? $"&after={slot}" : "");
                using var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Get, path));
                if (id != SessionId || !response.IsSuccessStatusCode) return;
                var page = await response.Content.ReadFromJsonAsync<SessionQuestionHistoryPage>();
                if (page is null) return;
                _items.AddRange(page.Items.Where(item => item.QuestionId is not null));
                after = page.Next;
            }
            while (after is not null);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            // Reporting is a courtesy: the questions already read stay, and the result itself is unaffected.
        }
    }
}
