@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Web.Plugins
@inject ReportsApi Api
@inject IClientTranslator L
@inject IClientViewer Viewer

@* A quiet way to flag a bad question: present only to signed-in players on a tenant with reports on. *@
@if (_enabled && !Viewer.IsGuest)
{
    <span data-report-question="@QuestionId">
        @if (_done)
        {
            <span class="faint" data-report-thanks style="font-size:var(--step--1)">@L["report.thanks"]</span>
        }
        else if (!_open)
        {
            <button type="button" class="report__open" data-report-open @onclick="Open">@L["report.button"]</button>
        }
        else
        {
            <span class="report">
                <span class="faint" style="font-size:var(--step--1)">@L["report.why"]</span>
                <span class="report__reasons">
                    @foreach (var reason in ReportsApi.Reasons)
                    {
                        <button type="button" class="chip report__reason" data-report-reason="@reason" disabled="@_busy" @onclick="() => SendAsync(reason)">@L[$"report.{reason}"]</button>
                    }
                    <button type="button" class="chip report__reason" data-report-cancel @onclick="Close">@L["report.cancel"]</button>
                </span>
                @if (_failed)
                {
                    <span role="alert" data-report-error>@L["common.error"]</span>
                }
            </span>
        }
    </span>
}

@code {
    private bool _enabled, _open, _busy, _done, _failed;

    [Parameter, EditorRequired] public Guid QuestionId { get; set; }

    protected override async Task OnInitializedAsync() => _enabled = await Api.IsEnabledAsync();

    private void Open() => _open = true;

    private void Close() => _open = false;

    private async Task SendAsync(string reason)
    {
        if (_busy) return;
        _busy = true;
        _failed = false;
        try
        {
            var outcome = await Api.ReportAsync(QuestionId, reason);
            _done = outcome == ReportOutcome.Reported;
            _failed = outcome != ReportOutcome.Reported;
            if (_done) _open = false;
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
