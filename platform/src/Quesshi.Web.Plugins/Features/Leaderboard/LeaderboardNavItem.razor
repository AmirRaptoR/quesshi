@using Quesshi.Shared
@inject IClientTranslator L

<a href="/ranks" data-test="nav-ranks" aria-current="@(IsCurrent ? "page" : null)">@L["nav.ranks"]</a>

@code {
    [Parameter, EditorRequired] public NavItemParameters Parameters { get; set; } = default!;

    private bool IsCurrent => Parameters.CurrentPath.TrimEnd('/').Equals("ranks", StringComparison.OrdinalIgnoreCase);
}
