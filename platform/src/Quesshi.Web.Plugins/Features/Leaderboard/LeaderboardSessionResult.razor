@using Quesshi.Shared
@implements IDisposable
@inject LeaderboardApi Api
@inject IClientTranslator L
@inject TimeProvider Time

@if (_state == State.Pending)
{
    <p class="muted" data-test="rank-pending" role="status">@L["ranks.pending"]</p>
}
else if (_state == State.Done)
{
    <p data-test="rank-result">
        @if (_rank is { } rank)
        {
            @(string.Format(L["ranks.newRank"], rank))
        }
        else
        {
            @L["ranks.unranked"]
        }
    </p>
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private enum State { Pending, Done, Nothing }

    private readonly CancellationTokenSource _lifetime = new();
    private State _state = State.Pending;
    private int? _rank;

    [Parameter, EditorRequired] public SessionResultParameters Parameters { get; set; } = default!;

    protected override void OnInitialized() => _ = ConvergeAsync();

    /// <summary>Re-reads the effects until this feature's are settled, so the rank appears without a reload.</summary>
    private async Task ConvergeAsync()
    {
        var token = _lifetime.Token;
        try
        {
            while (!token.IsCancellationRequested)
            {
                string? status = null;
                try { status = await Api.EffectStatusAsync(Parameters.Session.Id, token); }
                catch (HttpRequestException) { status = "pending"; }

                if (status == "done")
                {
                    await ShowRankAsync(token);
                    return;
                }
                if (status is not "pending") { _state = State.Nothing; await InvokeAsync(StateHasChanged); return; }

                await Task.Delay(PollInterval, Time, token);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task ShowRankAsync(CancellationToken token)
    {
        try
        {
            var result = await Api.LoadAsync(LeaderboardApi.AllBoard, LeaderboardApi.AllPeriod, LeaderboardApi.AllScope, token);
            _rank = result.Board?.Me?.Rank;
        }
        catch (HttpRequestException) { _rank = null; }
        _state = State.Done;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
