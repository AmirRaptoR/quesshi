@using Microsoft.AspNetCore.Components.Web
@inject IClientTranslator T
@inject IClientLanguageInfo Language

@* The controls an async duel's shape is picked from: length, difficulty, topics and capacity.
   ReadOnly renders the same controls inert, which is what a non-owner sees. *@
<div class="duel-settings" dir="@Language.Direction" data-duel-settings>
    <div class="field">
        <label>@T["home.length"]</label>
        <div class="segmented" role="group" aria-label="@T["home.length"]">
            @foreach (var count in AsyncDuelSettingsRequest.QuestionCounts)
            {
                var value = count;
                <button type="button" class="segmented__option @(Settings.QuestionCount == value ? "is-on" : null)"
                        data-count="@value" aria-pressed="@Pressed(Settings.QuestionCount == value)"
                        disabled="@ReadOnly" @onclick="() => Change(Settings with { QuestionCount = value })">
                    @Language.Num(value)
                </button>
            }
        </div>
    </div>

    @if (PacksAvailable)
    {
        <div class="field" data-source-choice>
            <label>@T["packs.source"]</label>
            <div class="segmented" role="group" aria-label="@T["packs.source"]">
                <button type="button" class="segmented__option @(UsesPack ? null : "is-on")" data-source="bank" aria-pressed="@Pressed(!UsesPack)"
                        disabled="@ReadOnly" @onclick="() => Change(Settings with { PackId = null })">@T["packs.sourceBank"]</button>
                <button type="button" class="segmented__option @(UsesPack ? "is-on" : null)" data-source="pack" aria-pressed="@Pressed(UsesPack)"
                        disabled="@(ReadOnly || Packs.Count == 0)" @onclick="() => Change(Settings with { PackId = Packs[0].Id })">@T["packs.sourcePack"]</button>
            </div>
            @if (UsesPack)
            {
                <select class="input" data-pack-picker aria-label="@T["packs.pick"]" disabled="@ReadOnly" @onchange="PickPack">
                    @foreach (var pack in Packs)
                    {
                        <option value="@pack.Id" selected="@(pack.Id == Settings.PackId)">@pack.Title</option>
                    }
                </select>
            }
            else if (Packs.Count == 0)
            {
                <p class="faint" data-no-packs>@T["packs.none"]</p>
            }
        </div>
    }

    @if (!UsesPack)
    {
    <div class="field">
        <label>@T["home.levels"]</label>
        <p class="faint" data-levels-text>@(Levels.IsWhole ? T["questions.rampsUp"] : DuelSettingsLine.Difficulty(Summary, Words))</p>
        <input type="range" min="@DifficultyRange.Easiest" max="@DifficultyRange.Hardest" step="1" data-level="low"
               value="@Levels.Low" disabled="@ReadOnly" @onchange="MoveLow"
               aria-label="@T["questions.rangeLow"]" aria-valuetext="@T["level." + Levels.Low]" />
        <input type="range" min="@DifficultyRange.Easiest" max="@DifficultyRange.Hardest" step="1" data-level="high"
               value="@Levels.High" disabled="@ReadOnly" @onchange="MoveHigh"
               aria-label="@T["questions.rangeHigh"]" aria-valuetext="@T["level." + Levels.High]" />
    </div>

    <div class="field">
        <label>@T["home.categories"]</label>
        <div class="picker">
            @foreach (var category in Offered)
            {
                var id = category.Id;
                var on = Settings.CategoryIds.Contains(id);
                <button type="button" class="picker__chip @(on ? "is-on" : null)" style="--pick:@category.Color"
                        data-category="@id" aria-pressed="@Pressed(on)" disabled="@ReadOnly"
                        @onclick="() => Change(Settings with { CategoryIds = TopicPicks.Toggle(Settings.CategoryIds, id) })">
                    <span aria-hidden="true">@category.Icon</span> @category.Name
                </button>
            }
        </div>
        <p class="faint" data-topics-text>
            @(Settings.CategoryIds.Count == 0 ? T["home.anyCategory"] : Words.Format("home.pickedCount", Language.Num(Settings.CategoryIds.Count)))
        </p>
    </div>
    }

    <div class="field">
        <label for="duel-capacity">@T["asyncDuel.capacity"]</label>
        <input id="duel-capacity" class="input" type="number" min="@AsyncDuelSettingsRequest.MinCapacity" max="@AsyncDuelSettingsRequest.MaxCapacity"
               value="@Capacity" disabled="@ReadOnly" @onchange="ChangeCapacity" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DuelSettings Settings { get; set; } = new(10, [], []);
    [Parameter] public EventCallback<DuelSettings> SettingsChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<PickerCategory> Categories { get; set; } = [];
    [Parameter] public int? Capacity { get; set; }
    [Parameter] public EventCallback<int> CapacityChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The owner's packs; offered as a content source only while <see cref="PacksAvailable"/>.</summary>
    [Parameter] public IReadOnlyList<PickerPack> Packs { get; set; } = [];
    [Parameter] public bool PacksAvailable { get; set; }

    private bool UsesPack => PacksAvailable && Settings.PackId is not null;

    private Task PickPack(ChangeEventArgs e) =>
        ReadOnly || e.Value?.ToString() is not { Length: > 0 } id ? Task.CompletedTask : SettingsChanged.InvokeAsync(Settings with { PackId = id });

    private ClientWords? words;
    private ClientWords Words => words ??= new ClientWords(T, Language);
    private List<PickerCategory> Offered => TopicPicks.Offered(Categories, Language.Code);
    private DifficultyRange Levels => DifficultyRange.From(Settings.Levels);
    private DuelSettingsSummary Summary => DuelSettingsSummary.From(Settings);

    private Task Change(DuelSettings next) => ReadOnly ? Task.CompletedTask : SettingsChanged.InvokeAsync(next);

    private Task MoveLow(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? Change(Settings with { Levels = Levels.WithLow(value).Levels() }) : Task.CompletedTask;

    private Task MoveHigh(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? Change(Settings with { Levels = Levels.WithHigh(value).Levels() }) : Task.CompletedTask;

    private Task ChangeCapacity(ChangeEventArgs e) =>
        ReadOnly || !int.TryParse(e.Value?.ToString(), out var value) ? Task.CompletedTask
            : CapacityChanged.InvokeAsync(Math.Clamp(value, AsyncDuelSettingsRequest.MinCapacity, AsyncDuelSettingsRequest.MaxCapacity));

    private static string Pressed(bool on) => on ? "true" : "false";
}
