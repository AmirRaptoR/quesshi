@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@using Quesshi.Shared
@using Quesshi.Web.Plugins.Formats.Live
@inject IClientTranslator L
@inject IFormatCommands Commands

@{
    var view = Parameters.Session;
    var me = view.Me.Id;
    var gone = LiveElimination.IsEliminated(view.Me.Status) || LiveElimination.HasLeft(view.Me.Status);
}

<section class="poll-screen stack" dir="@L.Direction" data-poll-screen="@view.Id">
    <header class="topbar game-hud">
        <span class="muted numeral" data-poll-slot>@L.Num((_body.Slot ?? view.Slot) + 1)@(_body.TotalSlots is { } total ? " / " + L.Num(total) : "")</span>
    </header>

    <section class="card card--taq game-stage" @key="view.Slot" data-poll-question>
        <p class="game-kicker">@L["voting.play.choose"]</p>
        @if (_card is null)
        {
            <p role="alert">@L["common.error"]</p>
        }
        else if (!gone)
        {
            <KindPlay Card="_card" OnAnswer="SubmitAsync" Disabled="@_submitting" />
        }
    </section>

    @if (_stored is { } stored)
    {
        <p class="game-status enter" data-poll-stored><span class="chip chip--win">@L["live.answered"]</span> <strong dir="auto">@(stored.IsKey ? L[stored.Value] : stored.Value)</strong></p>
    }

    @if (gone)
    {
        <p class="game-status enter" data-poll-status>@L["live.question.waitingForThem"]</p>
    }
    else if (_body.Answer is not null)
    {
        <section class="game-status enter" style="text-align:center" data-poll-status data-poll-waiting>
            @L["voting.play.waiting"]
            <span class="faint" style="display:block;margin-top:.25rem">@string.Format(L["voting.play.answered"], L.Num(AnsweredCount), L.Num(Active.Count))</span>
            <span class="faint" style="display:block;margin-top:.25rem">@L["voting.play.answerHint"]</span>
        </section>
    }
    else
    {
        <p class="faint enter" style="text-align:center" data-poll-status>@L["voting.play.answerHint"]</p>
    }

    @if (_pending is not null)
    {
        <div class="notice notice--bad" role="alert" data-poll-send-failed>
            <span>@L["live.sendFailed"]</span>
            <button type="button" class="btn btn--ghost" data-poll-retry disabled="@_submitting" @onclick="RetryAsync">@L["common.retry"]</button>
        </div>
    }

    <ul class="stack" style="list-style:none;padding:0;margin:.4rem 0 0" data-poll-answered-list>
        @foreach (var seat in Active)
        {
            var answered = _body.AnsweredSeats.Contains(seat.Id);
            <li class="row" style="gap:.5rem" @key="seat.Id" data-seat="@seat.Id" data-answered="@(answered ? "true" : "false")">
                <span class="grow" dir="auto">@(seat.Id == me ? L["result.you"] : seat.Name)</span>
                @if (answered)
                {
                    <span class="chip chip--win">@L["live.answered"]</span>
                }
                else
                {
                    <span class="chip">@L["live.waiting"]</span>
                }
            </li>
        }
    </ul>
</section>

@code {
    private sealed record Pending(JsonElement Payload, int Revision, int Slot);

    private SessionView? _current;
    private PollBodyView _body = PollBodyView.Empty;
    private KindCard? _card;
    private StoredChoice? _stored;
    private Pending? _pending;
    private bool _submitting;

    [Parameter, EditorRequired] public FormatScreenParameters Parameters { get; set; } = default!;

    private IReadOnlyList<SessionRosterSeat> Active => [.. LiveElimination.Seats(Parameters.Session.Roster)
        .Where(seat => seat.Role == "player" && !LiveElimination.IsEliminated(seat.Status) && !LiveElimination.HasLeft(seat.Status))];

    private int AnsweredCount => Active.Count(seat => _body.AnsweredSeats.Contains(seat.Id));

    protected override void OnParametersSet()
    {
        var next = Parameters.Session;
        if (ReferenceEquals(next, _current)) return;

        var previous = _current;
        _current = next;
        _body = PollBodyView.From(next);
        _card = PollKinds.Card(_body.Kind, _body.KindVersion, _body.Card);
        _stored = PollKinds.Stored(_card, _body.Answer);
        if (previous is not null && (previous.Id != next.Id || previous.Slot != next.Slot)) _pending = null;
    }

    private Task SubmitAsync(object? answer)
    {
        if (_submitting || _card is null || PollKinds.Answer(_card.Kind, answer) is not { } payload) return Task.CompletedTask;
        return SendAsync(new Pending(payload, (_body.Revision ?? 0) + 1, Parameters.Session.Slot));
    }

    /// <summary>Resends the answer that did not go through with its original revision, so a retry never changes the choice.</summary>
    private Task RetryAsync() => _pending is { } pending && !_submitting ? SendAsync(pending) : Task.CompletedTask;

    private async Task SendAsync(Pending pending)
    {
        _submitting = true;
        try
        {
            _pending = await Commands.SendAsync("answer", pending.Payload, pending.Revision) ? null : pending;
        }
        catch (HttpRequestException)
        {
            _pending = pending;
        }
        finally
        {
            _submitting = false;
        }
    }
}
