@using System.Text.Json
@using Quesshi.Formats.Poll
@using Quesshi.Kinds.PollChoice
@using Quesshi.Kinds.PollRoster
@using Quesshi.Shared
@using Quesshi.Web.Plugins.Features.Reports
@inject IClientTranslator L
@inject IClientViewer Viewer

<section class="card stack" data-poll-result="@Parameters.Session.Id" dir="@Viewer.Direction">
    @if (_view.Result is not { PairStats: not null } result)
    {
        <h2 data-poll-no-contest>@PollResultsText.NoContest(L)</h2>
    }
    else
    {
        <h2>@L["voting.results.title"]</h2>
        @foreach (var slot in _view.Slots)
        {
            var counts = _view.Result.Slots.FirstOrDefault(s => s.Slot == slot.Slot) ?? new PollSlotResult(slot.Slot, slot.Counts, slot.AllAgreed);
            var naIndex = counts.Counts.Count - 1;
            var card = PollKinds.Card(slot.Kind, slot.KindVersion, slot.Card);
            var labels = CountLabels(card, counts.Counts.Count);
            var ownNotApplicable = IsNotApplicable(slot.Answers.FirstOrDefault(a => a.Player == Parameters.Session.Me.Id)?.Value);
            <div class="stack" data-poll-slot="@slot.Slot">
                <p class="muted" data-poll-agreement>@L[PollAgreementText.Key(counts, naIndex, ownNotApplicable)]</p>
                <div class="voting-distribution">
                    @for (var index = 0; index < counts.Counts.Count; index++)
                    {
                        <div class="row row--between" data-poll-count="@index">
                            <span dir="auto">@(labels[index] ?? (index == naIndex ? L["voting.answer.notApplicable"] : L.Num(index + 1)))</span>
                            <span class="numeral">@L.Num(counts.Counts[index])</span>
                        </div>
                    }
                </div>
                <div class="stack">
                    @foreach (var answer in slot.Answers)
                    {
                        <div class="row row--between" data-poll-answer="@answer.Player">
                            <span dir="auto">@(answer.Player == Parameters.Session.Me.Id ? L["result.you"] : Name(answer.Player))</span>
                            <span>@AnswerText(card, answer.Value)</span>
                        </div>
                    }
                </div>
            </div>
        }
        @if (result.PairStats is { Count: > 0 } pairs)
        {
            <div class="stack" data-poll-pairs>
                @foreach (var pair in pairs)
                {
                    <div class="row row--between" data-poll-pair="@pair.FirstPlayer:@pair.SecondPlayer"><span dir="auto">@Name(pair.FirstPlayer) · @Name(pair.SecondPlayer)</span><span>@PollResultsText.PairAgreement(pair, L)</span></div>
                }
            </div>
        }
        else if (result.AllAgreedCount is { } agreed)
        {
            <p class="muted" data-poll-overall>@string.Format(L["voting.results.allAgreed"], L.Num(agreed), L.Num(_view.Slots.Count))</p>
        }
    }
    <ReportableQuestions SessionId="@Parameters.Session.Id" />
</section>

@code {
    private static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web);
    private PollFinishedView _view = Empty;

    private static readonly PollFinishedView Empty = new(null!, [], []);

    [Parameter, EditorRequired] public FormatScreenParameters Parameters { get; set; } = default!;

    protected override void OnParametersSet() => _view = Read(Parameters.Session.Body);

    private static PollFinishedView Read(JsonElement body)
    {
        if (body.ValueKind != JsonValueKind.Object) return Empty;
        try
        {
            var view = body.Deserialize<PollFinishedView>(Options);
            return view is null ? Empty : view with { Slots = view.Slots ?? [], Seats = view.Seats ?? [] };
        }
        catch (JsonException)
        {
            return Empty;
        }
    }

    private string Name(string id) => Parameters.Session.Roster switch
    {
        CompleteRosterView complete => complete.Seats.FirstOrDefault(s => s.Id == id)?.Name ?? id,
        _ => id,
    };

    private static bool IsNotApplicable(JsonElement? value) => value is { ValueKind: JsonValueKind.Object } v
        && v.TryGetProperty("notApplicable", out var na) && na.ValueKind == JsonValueKind.True;

    private string?[] CountLabels(KindCard? card, int count)
    {
        var labels = new string?[count];
        switch (card?.Value)
        {
            case PollChoiceCard choice:
                for (var i = 0; i < choice.Options.Count && i < count; i++) labels[i] = choice.Options[i].Text;
                break;
            case PollRosterCard roster:
                for (var i = 0; i < roster.Options.Count && i < count; i++) labels[i] = roster.Options[i].Name;
                if (roster.Options.Count < count) labels[roster.Options.Count] = L["voting.answer.multiplePeople"];
                if (roster.Options.Count + 1 < count) labels[roster.Options.Count + 1] = L["voting.answer.noOne"];
                break;
        }
        if (count > 0) labels[count - 1] = L["voting.answer.notApplicable"];
        return labels;
    }

    private string AnswerText(KindCard? card, JsonElement? value)
    {
        if (value is not { ValueKind: JsonValueKind.Object } v) return string.Empty;
        if (PollKinds.Stored(card, v) is { } stored) return stored.IsKey ? L[stored.Value] : stored.Value;
        if (IsNotApplicable(v)) return L["voting.answer.notApplicable"];
        if (v.TryGetProperty("option", out var option)) return option.ToString();
        if (v.TryGetProperty("seat", out var seat)) return Name(SeatId(seat.GetInt32()));
        if (v.TryGetProperty("several", out _)) return L["voting.answer.multiplePeople"];
        if (v.TryGetProperty("none", out _)) return L["voting.answer.noOne"];
        return string.Empty;
    }

    private string SeatId(int seat) => Parameters.Session.Roster is CompleteRosterView complete
        ? complete.Seats.FirstOrDefault(s => s.Seat == seat)?.Id ?? seat.ToString()
        : seat.ToString();
}
