@using Microsoft.AspNetCore.Components.Web
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Quesshi.Domain
@using Quesshi.Formats.Poll
@using Quesshi.Shared
@using Quesshi.Web.Services
@inject ClientHttp Http
@inject IClientTranslator L

<div dir="@Direction" data-poll-settings>
    <div class="field" style="margin-top:.9rem">
        <label>@L["home.length"]</label>
        <div class="segmented" role="group" aria-label="@L["home.length"]">
            @foreach (var count in MatchRules.QuestionCountChoices)
            {
                var value = count;
                <button type="button" class="segmented__option @(Count == value ? "is-on" : null)" data-poll-count="@value"
                        aria-pressed="@((Count == value).ToString().ToLowerInvariant())"
                        disabled="@(!Parameters.IsOwner || _busy)" @onclick="() => SetCountAsync(value)">@value</button>
            }
        </div>
    </div>

    <div class="field">
        <label>@L["lang.pick"]</label>
        <div class="segmented" role="group" aria-label="@L["lang.pick"]">
            @foreach (var language in _languages)
            {
                var pick = language.Code;
                <button type="button" class="segmented__option @(Language == pick ? "is-on" : null)" data-poll-language="@pick"
                        aria-pressed="@((Language == pick).ToString().ToLowerInvariant())"
                        disabled="@(!Parameters.IsOwner || _busy)" @onclick="() => SetLanguageAsync(pick)">@L["lang." + pick]</button>
            }
        </div>
    </div>

    <div class="field">
        <label>@L["voting.lobby.categories"]</label>
        <div class="topic-grid" role="group" aria-label="@L["voting.lobby.categories"]">
            @foreach (var category in _categories)
            {
                var id = category.Id;
                var selected = Selected.Contains(id);
                <button type="button" class="topic-tile @(selected ? "is-on" : null)" data-poll-category="@id"
                        aria-pressed="@selected.ToString().ToLowerInvariant()"
                        disabled="@(!Parameters.IsOwner || _busy || (!selected && Selected.Count >= MaxCategories))"
                        @onclick="() => ToggleCategoryAsync(id)">
                    <span class="topic-tile__icon" aria-hidden="true">@category.Icon</span>
                    <span class="topic-tile__name" dir="auto">@category.Name</span>
                </button>
            }
        </div>
    </div>

    <div class="field">
        <label for="poll-capacity">@L["lobby.capacity"]</label>
        <input id="poll-capacity" class="input" type="number" data-poll-capacity
               min="@MatchRules.MinParticipants" max="@VotingRules.MaxParticipants" value="@Capacity"
               disabled="@(!Parameters.IsOwner || _busy)" @onchange="SetCapacityAsync" />
        <p class="faint">@string.Format(L["lobby.capacityRange"], MatchRules.MinParticipants, VotingRules.MaxParticipants)</p>
        @if (_error is not null)
        {
            <p role="alert" data-poll-error>@L[_error]</p>
        }
    </div>
</div>

@code {
    private const int MaxCategories = 3;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<LanguageDocument> _languages = [];
    private string _defaultLanguage = "";
    private IReadOnlyList<CategoryDocument> _categories = [];
    private string? _antiforgery;
    private string? _error;
    private bool _busy;
    private int? _count;
    private string? _language;
    private int? _capacity;
    private IReadOnlyList<string>? _selected;

    [Parameter, EditorRequired] public FormatSettingsParameters Parameters { get; set; } = default!;

    private int Count => _count ?? (Parameters.Session.Content.ValueKind == JsonValueKind.Object
        && Parameters.Session.Content.TryGetProperty("count", out var count) && count.TryGetInt32(out var value) ? value : MatchRules.QuestionCountChoices[0]);

    private string Language => _language ?? (Parameters.Session.Rules.ValueKind == JsonValueKind.Object
        && Parameters.Session.Rules.TryGetProperty("language", out var language) && language.GetString() is { } text ? text : _defaultLanguage);

    private string Direction => _languages.FirstOrDefault(language => language.Code == Language)?.Direction ?? "ltr";

    private int Capacity => _capacity ?? Math.Clamp(Parameters.Session.Roster.Total, MatchRules.MinParticipants, VotingRules.MaxParticipants);

    private IReadOnlyList<string> Selected => _selected ?? StoredCategories();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var config = await Http.GetFromJsonAsync<ConfigDocument>("/api/config");
            _languages = config?.Languages ?? [];
            _defaultLanguage = config?.DefaultLanguage ?? _languages.FirstOrDefault()?.Code ?? "";
            await LoadCategoriesAsync(Language);
        }
        catch (HttpRequestException)
        {
            _languages = [];
        }
    }

    private async Task LoadCategoriesAsync(string language)
    {
        var categories = await Http.GetFromJsonAsync<List<CategoryDocument>>(
            $"/api/categories?family={PollFormat.PollFamily}&language={Uri.EscapeDataString(language)}");
        _categories = categories ?? [];
    }

    private IReadOnlyList<string> StoredCategories() =>
        Parameters.Session.Content.ValueKind == JsonValueKind.Object
        && Parameters.Session.Content.TryGetProperty("parameters", out var parameters) && parameters.ValueKind == JsonValueKind.Object
        && parameters.TryGetProperty("categories", out var categories) && categories.ValueKind == JsonValueKind.Array
            ? categories.EnumerateArray().Select(item => item.GetString()).OfType<string>().ToArray()
            : [];

    private Task SetCountAsync(int count) => SaveAsync(count, Language, Capacity, Selected, () => _count = count);

    private Task SetLanguageAsync(string language) => SaveAsync(Count, language, Capacity, [], async () =>
    {
        _language = language;
        _selected = [];
        await LoadCategoriesAsync(language);
    });

    private Task ToggleCategoryAsync(string id)
    {
        var next = Selected.Contains(id) ? Selected.Where(item => item != id).ToArray() : [.. Selected, id];
        return SaveAsync(Count, Language, Capacity, next, () => _selected = next);
    }

    private Task SetCapacityAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var capacity) || capacity < MatchRules.MinParticipants || capacity > VotingRules.MaxParticipants)
        {
            _error = "lobby.badCapacity";
            return Task.CompletedTask;
        }

        return SaveAsync(Count, Language, capacity, Selected, () => _capacity = capacity);
    }

    private Task SaveAsync(int count, string language, int capacity, IReadOnlyList<string> categories, Action accept) =>
        SaveAsync(count, language, capacity, categories, () => { accept(); return Task.CompletedTask; });

    private async Task SaveAsync(int count, string language, int capacity, IReadOnlyList<string> categories, Func<Task> accept)
    {
        if (!Parameters.IsOwner || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            var content = JsonNode.Parse(Parameters.Session.Content.GetRawText()) as JsonObject ?? [];
            content["count"] = count;
            var parameters = content["parameters"] as JsonObject ?? [];
            parameters["categories"] = new JsonArray(categories.Select(id => (JsonNode?)JsonValue.Create(id)).ToArray());
            content["parameters"] = parameters;
            var rules = JsonNode.Parse(Parameters.Session.Rules.GetRawText()) as JsonObject ?? [];
            rules["language"] = language;
            var outcome = await PutAsync(new JsonObject { ["content"] = content, ["rules"] = rules, ["capacity"] = capacity });
            if (outcome is null) await accept();
            else _error = "common.error";
        }
        catch (HttpRequestException)
        {
            _error = "common.error";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> PutAsync(JsonObject body)
    {
        for (var attempt = 0; attempt < 2; attempt++)
        {
            if (string.IsNullOrEmpty(_antiforgery)) await RefreshAntiforgeryAsync();
            using var request = new HttpRequestMessage(HttpMethod.Put, $"/api/sessions/{Uri.EscapeDataString(Parameters.Session.Id)}/settings")
            {
                Content = JsonContent.Create(body),
            };
            request.Headers.TryAddWithoutValidation("X-CSRF", _antiforgery);
            using var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) return null;
            var error = await ReadErrorAsync(response);
            if (response.StatusCode == HttpStatusCode.BadRequest && attempt == 0 && error == "invalid_antiforgery")
            {
                _antiforgery = null;
                continue;
            }

            return error ?? "request_failed";
        }

        return "request_failed";
    }

    private async Task RefreshAntiforgeryAsync()
    {
        using var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Get, "/api/antiforgery"));
        response.EnsureSuccessStatusCode();
        _antiforgery = (await response.Content.ReadFromJsonAsync<TokenDocument>(JsonOptions))?.Token;
    }

    private static async Task<string?> ReadErrorAsync(HttpResponseMessage response)
    {
        try { return (await response.Content.ReadFromJsonAsync<ErrorDocument>(JsonOptions))?.Error; }
        catch (JsonException) { return null; }
    }

    private sealed record ConfigDocument(IReadOnlyList<LanguageDocument>? Languages, string? DefaultLanguage);
    private sealed record LanguageDocument(string Code, string? Direction);
    private sealed record CategoryDocument(string Id, string Name, string Icon);
    private sealed record TokenDocument(string? Token);
    private sealed record ErrorDocument(string? Error);
}
