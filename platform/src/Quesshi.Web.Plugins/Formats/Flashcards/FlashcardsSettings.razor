@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Shared
@using Quesshi.Web.Services
@inject ClientHttp Http
@inject IClientTranslator L
@inject NavigationManager Navigation

<div class="stack" dir="@L.Direction" data-flashcards-settings>
    @if (_packs.Count == 0)
    {
        <p class="faint" data-flashcards-no-packs>@L["packs.none"]</p>
    }
    else
    {
        <div class="field">
            <label for="flashcards-pack">@L["flashcards.pack"]</label>
            <select id="flashcards-pack" class="input" data-flashcards-pack disabled="@_busy" @onchange="Pick">
                @foreach (var pack in _packs)
                {
                    <option value="@pack.Id" selected="@(pack.Id == _picked)">@pack.Title</option>
                }
            </select>
        </div>
        <button type="button" class="btn" data-flashcards-start disabled="@(_busy || _picked is null)" @onclick="StartAsync">@L["flashcards.start"]</button>
    }
    @if (_error is not null)
    {
        <p role="alert" data-flashcards-error>@L[_error]</p>
    }
</div>

@code {
    private FlashcardsStarter _starter = default!;
    private IReadOnlyList<FlashcardsStarter.Pack> _packs = [];
    private string? _picked;
    private string? _error;
    private bool _busy;

    [Parameter, EditorRequired] public FormatSettingsParameters Parameters { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _starter = new FlashcardsStarter(Http);
        try
        {
            _packs = await _starter.PacksAsync();
            _picked = _packs.FirstOrDefault()?.Id;
        }
        catch (HttpRequestException)
        {
            _error = "common.error";
        }
    }

    private void Pick(ChangeEventArgs args) => _picked = args.Value?.ToString();

    private async Task StartAsync()
    {
        if (_busy || _picked is null) return;
        _busy = true;
        _error = null;
        try
        {
            var count = await _starter.CardCountAsync(_picked);
            if (count == 0)
            {
                _error = "flashcards.noCards";
                return;
            }

            var (id, error) = await _starter.CreateAsync(_picked, count);
            if (id is { } created) Navigation.NavigateTo($"/s/{created}");
            else _error = "common.error";
        }
        catch (HttpRequestException)
        {
            _error = "common.error";
        }
        finally
        {
            _busy = false;
        }
    }
}
