@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@using Quesshi.Shared
@using Quesshi.Web.Services
@inject ClientHttp Http
@inject IClientTranslator L
@inject NavigationManager Navigation

<section class="card stack" dir="@L.Direction" data-flashcards-result="@Parameters.Session.Id">
    <h2>@L["flashcards.ratings"]</h2>
    <ul class="stack" style="list-style:none;padding:0" data-flashcards-counts>
        @for (var rating = 0; rating < _counts.Count; rating++)
        {
            var value = rating;
            <li class="row" data-rating="@value" data-count="@_counts[value]">
                <span class="grow">@string.Format(L["flashcards.rating"], L.Num(value))</span>
                <strong class="numeral">@L.Num(_counts[value])</strong>
            </li>
        }
    </ul>
    @if (PackId is not null)
    {
        <button type="button" class="btn" data-flashcards-again disabled="@_busy" @onclick="AgainAsync">@L["flashcards.again"]</button>
    }
    @if (_error)
    {
        <p role="alert" data-flashcards-error>@L["common.error"]</p>
    }
</section>

@code {
    private IReadOnlyList<int> _counts = FlashcardsBodyView.Empty.Counts;
    private FlashcardsStarter _starter = default!;
    private bool _busy;
    private bool _error;

    [Parameter, EditorRequired] public FormatScreenParameters Parameters { get; set; } = default!;

    /// <summary>The pack the finished session drew its cards from.</summary>
    private string? PackId => Parameters.Session.Content.ValueKind == JsonValueKind.Object
        && Parameters.Session.Content.TryGetProperty("parameters", out var parameters) && parameters.ValueKind == JsonValueKind.Object
        && parameters.TryGetProperty("packId", out var id) && id.ValueKind == JsonValueKind.String ? id.GetString() : null;

    private int Count => Parameters.Session.Content.ValueKind == JsonValueKind.Object
        && Parameters.Session.Content.TryGetProperty("count", out var count) && count.TryGetInt32(out var value) ? value : 0;

    protected override void OnParametersSet()
    {
        _starter ??= new FlashcardsStarter(Http);
        _counts = FlashcardsBodyView.From(Parameters.Session).Counts;
    }

    private async Task AgainAsync()
    {
        if (_busy || PackId is not { } pack) return;
        _busy = true;
        _error = false;
        try
        {
            var (id, _) = await _starter.CreateAsync(pack, Count);
            if (id is { } created) Navigation.NavigateTo($"/s/{created}");
            else _error = true;
        }
        catch (HttpRequestException)
        {
            _error = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
