@using Microsoft.AspNetCore.Components.Web
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Quesshi.Domain
@using Quesshi.Formats.Live
@using Quesshi.Shared
@using Quesshi.Web.Services
@inject ClientHttp Http
@inject IClientTranslator L

<div class="field" style="margin-top:.9rem">
    <label>@L["home.length"]</label>
    <div class="segmented" role="group" aria-label="@L["home.length"]">
        @foreach (var count in MatchRules.QuestionCountChoices)
        {
            var value = count;
            <button type="button" class="segmented__option @(Count == value ? "is-on" : null)" data-live-count="@value"
                    aria-pressed="@((Count == value).ToString().ToLowerInvariant())"
                    disabled="@(!Parameters.IsOwner || _busy)" @onclick="() => SetCountAsync(value)">@value</button>
        }
    </div>
</div>

<div class="field">
    <label>@L["lang.pick"]</label>
    <div class="segmented" role="group" aria-label="@L["lang.pick"]">
        @foreach (var code in _languages)
        {
            var pick = code;
            <button type="button" class="segmented__option @(Language == pick ? "is-on" : null)" data-live-language="@pick"
                    aria-pressed="@((Language == pick).ToString().ToLowerInvariant())"
                    disabled="@(!Parameters.IsOwner || _busy)" @onclick="() => SetLanguageAsync(pick)">@L["lang." + pick]</button>
        }
    </div>
</div>

<div class="field">
    <label for="live-capacity">@L["lobby.capacity"]</label>
    <input id="live-capacity" class="input" type="number" data-live-capacity
           min="@MatchRules.MinParticipants" max="@LiveFormat.MeasuredMaxPlayers" value="@Capacity"
           disabled="@(!Parameters.IsOwner || _busy)" @onchange="SetCapacityAsync" />
    <p class="faint">@string.Format(L["lobby.capacityRange"], MatchRules.MinParticipants, LiveFormat.MeasuredMaxPlayers)</p>
    @if (_error is not null)
    {
        <p role="alert" data-live-capacity-error>@L[_error]</p>
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<string> _languages = [];
    private string? _antiforgery;
    private string? _error;
    private bool _busy;
    private int? _count;
    private string? _language;
    private int? _capacity;

    [Parameter, EditorRequired] public FormatSettingsParameters Parameters { get; set; } = default!;

    private int Count => _count ?? (Parameters.Session.Content.ValueKind == JsonValueKind.Object
        && Parameters.Session.Content.TryGetProperty("count", out var count) && count.TryGetInt32(out var value) ? value : MatchRules.QuestionCountChoices[0]);

    private string Language => _language ?? (Parameters.Session.Rules.ValueKind == JsonValueKind.Object
        && Parameters.Session.Rules.TryGetProperty("language", out var language) && language.GetString() is { } text ? text : _languages.FirstOrDefault() ?? "");

    private int Capacity => _capacity ?? Math.Clamp(Parameters.Session.Roster.Total, MatchRules.MinParticipants, LiveFormat.MeasuredMaxPlayers);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var config = await Http.GetFromJsonAsync<ConfigDocument>("/api/config");
            _languages = config?.Languages?.Select(language => language.Code).ToArray() ?? [];
        }
        catch (HttpRequestException)
        {
            _languages = [];
        }
    }

    private Task SetCountAsync(int count) => SaveAsync(count, Language, Capacity, () => _count = count);

    private Task SetLanguageAsync(string language) => SaveAsync(Count, language, Capacity, () => _language = language);

    private Task SetCapacityAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var capacity) || capacity < MatchRules.MinParticipants || capacity > LiveFormat.MeasuredMaxPlayers)
        {
            _error = "lobby.badCapacity";
            return Task.CompletedTask;
        }

        return SaveAsync(Count, Language, capacity, () => _capacity = capacity);
    }

    private async Task SaveAsync(int count, string language, int capacity, Action accept)
    {
        if (!Parameters.IsOwner || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            var content = JsonNode.Parse(Parameters.Session.Content.GetRawText()) as JsonObject ?? [];
            content["count"] = count;
            var rules = JsonNode.Parse(Parameters.Session.Rules.GetRawText()) as JsonObject ?? [];
            rules["language"] = language;
            var outcome = await PutAsync(new JsonObject { ["content"] = content, ["rules"] = rules, ["capacity"] = capacity });
            if (outcome is null) accept();
            else _error = outcome;
        }
        catch (HttpRequestException)
        {
            _error = "network_error";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> PutAsync(JsonObject body)
    {
        for (var attempt = 0; attempt < 2; attempt++)
        {
            if (string.IsNullOrEmpty(_antiforgery)) await RefreshAntiforgeryAsync();
            using var request = new HttpRequestMessage(HttpMethod.Put, $"/api/sessions/{Uri.EscapeDataString(Parameters.Session.Id)}/settings")
            {
                Content = JsonContent.Create(body),
            };
            request.Headers.TryAddWithoutValidation("X-CSRF", _antiforgery);
            using var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) return null;
            var error = await ReadErrorAsync(response);
            if (response.StatusCode == HttpStatusCode.BadRequest && attempt == 0 && error == "invalid_antiforgery")
            {
                _antiforgery = null;
                continue;
            }

            return error ?? "request_failed";
        }

        return "request_failed";
    }

    private async Task RefreshAntiforgeryAsync()
    {
        using var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Get, "/api/antiforgery"));
        response.EnsureSuccessStatusCode();
        _antiforgery = (await response.Content.ReadFromJsonAsync<TokenDocument>(JsonOptions))?.Token;
    }

    private static async Task<string?> ReadErrorAsync(HttpResponseMessage response)
    {
        try { return (await response.Content.ReadFromJsonAsync<ErrorDocument>(JsonOptions))?.Error; }
        catch (JsonException) { return null; }
    }

    private sealed record ConfigDocument(IReadOnlyList<LanguageDocument>? Languages);
    private sealed record LanguageDocument(string Code);
    private sealed record TokenDocument(string? Token);
    private sealed record ErrorDocument(string? Error);
}
