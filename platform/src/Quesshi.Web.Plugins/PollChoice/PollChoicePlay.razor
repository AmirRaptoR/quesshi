@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Kinds.PollChoice

@if (Value is { } card)
{
    <div class="answers voting-answers" data-kind="poll_choice" data-version="1">
        @foreach (var option in card.Options)
        {
            <button type="button" class="answer game-answer" data-option="@option.Id" disabled="@Disabled"
                    @onclick="() => SubmitAsync(new PollChoiceAnswer(option.Id, null))">@option.Text</button>
        }
        <button type="button" class="answer game-answer" data-not-applicable disabled="@Disabled"
                @onclick="() => SubmitAsync(new PollChoiceAnswer(null, true))">Not applicable</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public object? Card { get; set; }
    [Parameter, EditorRequired] public EventCallback<object?> OnAnswer { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private PollChoiceCard? Value => Card as PollChoiceCard;
    private Task SubmitAsync(PollChoiceAnswer answer) => Disabled ? Task.CompletedTask : OnAnswer.InvokeAsync(answer);
}
