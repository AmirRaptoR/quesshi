@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Kinds.PollRoster

@if (Value is { } card)
{
    <div class="answers voting-answers" data-kind="poll_roster" data-version="1">
        @foreach (var option in card.Options)
        {
            <button type="button" class="answer game-answer" data-seat="@option.Seat" disabled="@Disabled"
                    @onclick="() => SubmitAsync(new PollRosterAnswer(option.Seat, null, null, null))">@option.Name</button>
        }
        <button type="button" data-several disabled="@Disabled" @onclick="() => SubmitAsync(new PollRosterAnswer(null, true, null, null))">Several</button>
        <button type="button" data-none disabled="@Disabled" @onclick="() => SubmitAsync(new PollRosterAnswer(null, null, true, null))">None</button>
        <button type="button" data-not-applicable disabled="@Disabled" @onclick="() => SubmitAsync(new PollRosterAnswer(null, null, null, true))">Not applicable</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public object? Card { get; set; }
    [Parameter, EditorRequired] public EventCallback<object?> OnAnswer { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private PollRosterCard? Value => Card as PollRosterCard;
    private Task SubmitAsync(PollRosterAnswer answer) => Disabled ? Task.CompletedTask : OnAnswer.InvokeAsync(answer);
}
