@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Quesshi.Kinds.Choice

@if (Value is { } card)
{
    <div class="answers game-answers" data-kind="choice" data-version="1">
        @for (var index = 0; index < card.Options.Count; index++)
        {
            var choice = index;
            <button type="button" class="answer game-answer" data-choice="@choice" disabled="@Disabled"
                    @onclick="() => SubmitAsync(choice)">@card.Options[choice]</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public object? Card { get; set; }
    [Parameter, EditorRequired] public EventCallback<object?> OnAnswer { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ChoiceCard? Value => Card as ChoiceCard;

    private Task SubmitAsync(int index) => Disabled ? Task.CompletedTask : OnAnswer.InvokeAsync(new ChoiceAnswer(index));
}
