@using Quesshi.Web.Models
@using Quesshi.Web.Services
@inject AuthState Auth
@inject Translator Translator

<section class="card card--taq stack" aria-labelledby="confirm-profile-title">
    <h1 id="confirm-profile-title">@Translator["auth.confirmTitle"]</h1>
    <p class="muted">@Translator["auth.confirmBody"]</p>
    @if (!string.IsNullOrEmpty(error))
    {
        <p class="form-error" role="alert">@Translator[error]</p>
    }
    <form class="stack" @onsubmit="ConfirmAsync">
        <div class="field">
            <label for="confirmation-name">@Translator["profile.name"]</label>
            <input id="confirmation-name" class="input" @bind="displayName" required />
        </div>
        <div class="field">
            <label for="confirmation-avatar">@Translator["profile.avatar"]</label>
            <select id="confirmation-avatar" class="select" @bind="avatarSeed">
                @foreach (var avatar in AvatarSeeds)
                {
                    <option value="@avatar">@avatar</option>
                }
            </select>
        </div>
        <button class="btn btn--block" type="submit" disabled="@busy">@Translator["auth.confirm"]</button>
        <button class="btn btn--ghost btn--block" type="button" @onclick="OnCancelled" disabled="@busy">@Translator["auth.cancel"]</button>
    </form>
</section>

@code {
    private static readonly string[] AvatarSeeds = [.. Enumerable.Range(0, 12).Select(index => $"avatar-{index}")];
    private string displayName = string.Empty;
    private string avatarSeed = string.Empty;
    private string? error;
    private bool busy;

    [Parameter, EditorRequired] public VerificationResult Confirmation { get; set; } = default!;
    [Parameter] public EventCallback OnCancelled { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }

    protected override void OnParametersSet()
    {
        displayName = Confirmation.DisplayName ?? string.Empty;
        avatarSeed = Confirmation.AvatarSeed ?? "avatar-0";
    }

    private async Task ConfirmAsync()
    {
        busy = true;
        error = null;
        var result = await Auth.ConfirmProfileAsync(Confirmation.Token ?? string.Empty, displayName, avatarSeed, Confirmation.Lang ?? string.Empty);
        busy = false;
        if (result.IsSuccess)
        {
            await OnConfirmed.InvokeAsync();
            return;
        }

        error = "common.error";
    }
}
