@page "/join/{Code}"
@using Quesshi.Web.Services
@inject AuthState Auth
@inject Translator Translator
@inject NavigationManager Navigation
@inject PlayerApi Api
@inject PlatformState State
@inject AppConfig Config
@inject InviteTakeover Takeover

<section class="card card--taq stack" aria-labelledby="join-title" data-test="join">
    <h1 id="join-title">@Translator["join.title"]</h1>
    @if (joining)
    {
        <div class="spinner" role="status" aria-label="@Translator["common.loading"]"></div>
    }
    else
    {
        @if (errorKey is not null)
        {
            <p role="alert" class="notice notice--bad" data-test="join-error">@Translator[errorKey]</p>
        }
        <button class="btn btn--block" type="button" data-test="join-submit" @onclick="JoinAsync">@Translator["home.joinSubmit"]</button>
    }
</section>

@code {
    private bool joining;
    private string? errorKey;

    [Parameter] public string Code { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (Takeover.TakeIntent()) await JoinAsync();
    }

    private async Task JoinAsync()
    {
        if (joining) return;
        joining = true;
        errorKey = null;
        try
        {
            var outcome = await new HomeSessions(Api, State, Config).JoinByCodeAsync(Code);
            if (outcome.SessionId is { } id)
            {
                Navigation.NavigateTo($"/s/{id}");
                return;
            }

            errorKey = FailureKey(outcome.ErrorCode);
        }
        finally { joining = false; }
    }

    private static string FailureKey(string? code) => code switch
    {
        "expired" => "challenge.lobbyExpired",
        "not_found" => "join.noSuchCode",
        "session_full" => "challenge.lobbyFull",
        "late_join_not_allowed" => "challenge.lobbyStarted",
        _ => "join.failed",
    };
}
