@using Quesshi.Web.Models
@using Quesshi.Web.Services
@using Microsoft.JSInterop
@implements IDisposable
@inject AppConfig Config
@inject AuthState Auth
@inject Translator Translator
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (confirmation is not null)
{
    <ProfileConfirmation Confirmation="confirmation" OnCancelled="CancelConfirmationAsync" OnConfirmed="CompleteConfirmationAsync" />
}
else
{
    <section class="card card--taq stack" aria-labelledby="sign-in-title">
        <h1 id="sign-in-title">@Translator["auth.title"]</h1>
        <p class="muted">@Translator["auth.blurb"]</p>
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="form-error" role="alert">@Translator[error]</p>
        }
        @if (!codeRequested)
        {
            <form class="stack" @onsubmit="RequestCodeAsync">
                <div class="field">
                    <label for="email">@Translator["auth.email"]</label>
                    <input id="email" class="input" type="email" autocomplete="email" @bind="email" required />
                </div>
                <button class="btn btn--block" type="submit" disabled="@busy">@Translator["auth.send"]</button>
            </form>
        }
        else
        {
            <form class="stack" @onsubmit="VerifyCodeAsync">
                <div class="field">
                    <label for="code">@Translator["auth.code"]</label>
                    <input id="code" class="input code-input" inputmode="numeric" autocomplete="one-time-code" @bind="code" required />
                </div>
                <button class="btn btn--block" type="submit" disabled="@busy">@Translator["auth.verify"]</button>
                <button class="btn btn--ghost btn--block" type="button" @onclick="ResetCode">@Translator["auth.back"]</button>
            </form>
        }
        @if (GoogleClientId is not null)
        {
            <div id="google-sign-in" @ref="googleButton"></div>
        }
        @if (GuestsEnabled)
        {
            <GuestEntry OnCreated="GuestCreatedAsync" />
        }
    </section>
}

@code {
    private string email = string.Empty;
    private string code = string.Empty;
    private string? error;
    private bool busy;
    private bool codeRequested;
    private VerificationResult? confirmation;
    private ElementReference googleButton;
    private DotNetObjectReference<SignIn>? googleCredentialReceiver;
    private string? renderedGoogleClientId;

    private bool GuestsEnabled => Config.Current.Capabilities.TryGetValue("switch", out var switches)
        && switches.Contains("guests", StringComparer.Ordinal);

    private string? GoogleClientId
    {
        get
        {
            foreach (var method in Config.Current.SignInMethods)
            {
                if (string.Equals(method.Id, "google", StringComparison.Ordinal)
                    && !string.IsNullOrWhiteSpace(method.Settings?.ClientId)) return method.Settings.ClientId.Trim();
            }

            return null;
        }
    }

    protected override void OnInitialized() => Config.Changed += ConfigChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var clientId = GoogleClientId;
        if (clientId is null)
        {
            renderedGoogleClientId = null;
            return;
        }

        if (string.Equals(clientId, renderedGoogleClientId, StringComparison.Ordinal)) return;

        googleCredentialReceiver ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("quesshi.google.render", googleButton, clientId, googleCredentialReceiver);
            renderedGoogleClientId = clientId;
        }
        catch (JSException)
        {
            renderedGoogleClientId = clientId;
            error = "common.error";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RequestCodeAsync()
    {
        busy = true;
        error = null;
        var result = await Auth.RequestCodeAsync(email);
        busy = false;
        if (result.IsSuccess)
        {
            codeRequested = true;
            return;
        }

        error = result.Error == "invalid_email" ? "auth.badEmail" : "common.error";
    }

    private async Task VerifyCodeAsync()
    {
        busy = true;
        error = null;
        var result = await Auth.VerifyCodeAsync(email, code);
        busy = false;
        if (!result.IsSuccess || result.Value is null)
        {
            error = "auth.badCode";
            return;
        }

        if (string.Equals(result.Value.Status, "signed_in", StringComparison.Ordinal))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        if (string.Equals(result.Value.Status, "profile_needed", StringComparison.Ordinal)
            && result.Value.Token is not null
            && result.Value.DisplayName is not null
            && result.Value.AvatarSeed is not null
            && result.Value.Lang is not null)
        {
            confirmation = result.Value;
            return;
        }

        error = "auth.badCode";
    }

    [JSInvokable]
    public async Task GoogleCredentialAsync(string? idToken)
    {
        if (busy) return;

        if (string.IsNullOrWhiteSpace(idToken))
        {
            error = "common.error";
            await InvokeAsync(StateHasChanged);
            return;
        }

        busy = true;
        error = null;
        try
        {
            var result = await Auth.SignInWithGoogleAsync(idToken);
            if (!result.IsSuccess || result.Value is null)
            {
                error = "common.error";
                return;
            }

            if (string.Equals(result.Value.Status, "signed_in", StringComparison.Ordinal))
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            if (string.Equals(result.Value.Status, "profile_needed", StringComparison.Ordinal)
                && result.Value.Token is not null
                && result.Value.DisplayName is not null
                && result.Value.AvatarSeed is not null
                && result.Value.Lang is not null)
            {
                confirmation = result.Value;
                return;
            }

            error = "common.error";
        }
        catch (HttpRequestException)
        {
            error = "common.error";
        }
        finally
        {
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetCode()
    {
        codeRequested = false;
        code = string.Empty;
        error = null;
    }

    private Task CancelConfirmationAsync()
    {
        confirmation = null;
        ResetCode();
        return Task.CompletedTask;
    }

    private Task CompleteConfirmationAsync()
    {
        Navigation.NavigateTo("/", replace: true);
        return Task.CompletedTask;
    }

    private Task GuestCreatedAsync()
    {
        Navigation.NavigateTo("/", replace: true);
        return Task.CompletedTask;
    }

    private void ConfigChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Config.Changed -= ConfigChanged;
        googleCredentialReceiver?.Dispose();
    }
}
