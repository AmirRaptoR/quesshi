@using Quesshi.Web.Services
@using Quesshi.Web.Plugins
@implements IDisposable
@inject AppConfig Config
@inject AuthState Auth
@inject LanguageSelection Languages
@inject Translator Translator
@inject NavigationManager Navigation

@if (!languageInitialized)
{
    <main class="shell" aria-busy="true"></main>
}
else if (Navigation.Uri.Contains("map-pick-smoke=1", StringComparison.Ordinal))
{
    <MapPickBrowserSmoke />
}
else if (Navigation.Uri.Contains("eager-kind-smoke=1", StringComparison.Ordinal))
{
    <EagerKindBrowserSmoke />
}
else if (IsAdminRoute)
{
    <AdminRouteHost />
}
else
{
    <main class="shell" aria-live="polite">
        <header class="topbar">
            <span class="topbar__title">@Config.NameFor(Languages.CurrentCode)</span>
            <span class="topbar__spacer"></span>
            <label>
                <span class="sr-only">Language</span>
                <select class="select" value="@Languages.CurrentCode" @onchange="ChangeLanguageAsync">
                    @foreach (var language in Config.Current.Languages)
                    {
                        <option value="@language.Code">@language.DisplayName</option>
                    }
                </select>
            </label>
        </header>
        @if (Auth.Status == PlayerIdentityStatus.Loading)
        {
            <p class="muted">@Translator["common.loading"]</p>
        }
        else if (Auth.Status == PlayerIdentityStatus.Unconfirmed)
        {
            <section class="card stack" aria-labelledby="session-unconfirmed">
                <h1 id="session-unconfirmed">@Translator["session.unconfirmed.title"]</h1>
                <p>@Translator["session.unconfirmed.body"]</p>
                <button class="btn" @onclick="RetryIdentityAsync">@Translator["common.retry"]</button>
            </section>
        }
        else if (Auth.Status == PlayerIdentityStatus.SignedOut)
        {
            <SignIn />
        }
        else
        {
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" />
                </Found>
                <NotFound>
                    <Home />
                </NotFound>
            </Router>
        }
    </main>
}

@code {
    private bool authInitialized;
    private bool languageInitialized;

    protected override void OnInitialized()
    {
        Config.Changed += StateHasChanged;
        Auth.Changed += StateHasChanged;
        Navigation.LocationChanged += NavigationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var changed = false;
        if (firstRender)
        {
            await Languages.InitializeAsync();
            languageInitialized = true;
            changed = true;
        }

        if (!authInitialized && !IsAdminRoute)
        {
            authInitialized = true;
            await Auth.InitializeAsync();
            changed = true;
        }

        if (changed) StateHasChanged();
    }

    private async Task ChangeLanguageAsync(ChangeEventArgs args)
    {
        if (args.Value is string code) await Languages.UseAsync(code);
    }

    private async Task RetryIdentityAsync() => await Auth.RetryAsync();

    private bool IsAdminRoute => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);

    private void NavigationChanged(object? sender, LocationChangedEventArgs args) => StateHasChanged();

    public void Dispose()
    {
        Config.Changed -= StateHasChanged;
        Auth.Changed -= StateHasChanged;
        Navigation.LocationChanged -= NavigationChanged;
    }
}
