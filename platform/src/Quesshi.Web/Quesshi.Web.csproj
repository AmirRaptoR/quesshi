<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Quesshi.Shared/Quesshi.Shared.csproj" />
    <ProjectReference Include="../Quesshi.Kinds/Quesshi.Kinds.csproj" />
    <ProjectReference Include="../Quesshi.Web.Plugins/Quesshi.Web.Plugins.csproj" />
    <ProjectReference Include="../Quesshi.Web.Admin/Quesshi.Web.Admin.csproj" />
    <ProjectReference Include="../Quesshi.Kinds.MapPick.Client/Quesshi.Kinds.MapPick.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Quesshi.Kinds.MapPick.Client.dll" />
    <BlazorWebAssemblyLazyLoad Include="Quesshi.Web.Admin.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
