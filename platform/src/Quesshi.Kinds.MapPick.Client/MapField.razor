@using Quesshi.Kinds.MapPick
@inject HttpClient Http

<WorldMap Shape="Shape" BaseLayer="BaseLayer" Disabled="Disabled" Selection="Selection" SelectionChanged="SelectionChanged"
          TargetRadiusKm="ToleranceKm" Label="World map" />
<div class="mapbar @(Selection is null ? "mapbar--empty" : null)" role="status">
    @if (Selection is null)
    {
        <span>@(Shape == MapTargetKind.Point ? "Tap the map to drop a pin" : "Tap a country")</span>
    }
    else if (Selection.IsCountry)
    {
        <span>@MapText.CountryName(countries, Selection.CountryCode) (@Selection.CountryCode)</span>
    }
    else
    {
        <span>@MapText.Coordinates(Selection)</span>
    }
    @if (OnConfirm.HasDelegate)
    {
        <button type="button" class="btn btn--sm" disabled="@(Selection is null || Disabled)" @onclick="OnConfirm">Lock it in</button>
    }
</div>

@code {
    [Parameter] public MapTargetKind? Shape { get; set; }
    [Parameter] public MapBaseLayer? BaseLayer { get; set; }
    [Parameter] public MapSelection? Selection { get; set; }
    [Parameter] public EventCallback<MapSelection> SelectionChanged { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Shown around a point selection while its author adjusts a point target.</summary>
    [Parameter] public double? ToleranceKm { get; set; }
    private IReadOnlyList<MapCountry> countries = [];
    protected override async Task OnInitializedAsync() => countries = await new WorldMapAsset(Http).LoadAsync();
}
