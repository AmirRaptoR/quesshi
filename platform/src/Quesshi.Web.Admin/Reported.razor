@inject IClientTranslator Text

<section class="stack" aria-labelledby="admin-reported-title">
    <h1 id="admin-reported-title">@Text[ReportedText.Title]</h1>
    @if (error is not null)
    {
        <p class="form-error" role="alert">@Text[error]</p>
    }
    @if (reports is null)
    {
        <p class="muted">@Text["common.loading"]</p>
    }
    else if (reports.Count == 0)
    {
        <p class="muted">@Text[ReportedText.Empty]</p>
    }
    else
    {
        @foreach (var report in reports)
        {
            <article class="card stack" data-testid="reported-@report.QuestionId">
                <p dir="auto" data-testid="reported-prompt-@report.QuestionId">@(prompts.GetValueOrDefault(report.QuestionId) ?? report.QuestionId.ToString())</p>
                <dl>
                    <dt>@Text[ReportedText.Count]</dt><dd data-testid="reported-count-@report.QuestionId">@report.Count</dd>
                    <dt>@Text[ReportedText.Reasons]</dt>
                    <dd data-testid="reported-reasons-@report.QuestionId">
                        @foreach (var reason in report.Reasons)
                        {
                            <span class="chip chip--loss">@reason</span>
                        }
                    </dd>
                </dl>
                <button class="btn" type="button" data-testid="dismiss-reported-@report.QuestionId" disabled="@busy" @onclick="() => DismissAsync(report)">@Text[ReportedText.Dismiss]</button>
            </article>
        }
    }
</section>

@code {
    [CascadingParameter] public AdminState? State { get; set; }

    private List<ReportedQuestion>? reports;
    private readonly Dictionary<Guid, string> prompts = [];
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (State is null) return;
        var result = await State.GetAsync<List<ReportedQuestion>>("/api/admin/x/reports");
        if (!result.Success)
        {
            error = result.Error ?? ReportedText.LoadFailed;
            reports ??= [];
            return;
        }

        reports = result.Value ?? [];
        error = null;
        foreach (var report in reports.Where(report => !prompts.ContainsKey(report.QuestionId)))
        {
            // Details are best effort: the moderation list stays usable when a question cannot be read.
            var question = await State.GetAsync<QuestionResponse>($"/api/admin/questions/{report.QuestionId}");
            if (question.Success && question.Value is not null) prompts[report.QuestionId] = question.Value.Prompt;
        }
    }

    private async Task DismissAsync(ReportedQuestion report)
    {
        if (State is null || busy) return;
        busy = true;
        try
        {
            var result = await State.MutateAsync<object>(HttpMethod.Post, $"/api/admin/x/reports/{report.QuestionId}/dismiss", null);
            if (!result.Success)
            {
                error = result.Error ?? ReportedText.DismissFailed;
                return;
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private sealed record ReportedQuestion(Guid QuestionId, long Count, IReadOnlyList<string> Reasons);
}
