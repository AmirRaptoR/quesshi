@inherits CapabilityFormBase
@inject IClientTranslator Text

<CapabilityFormFrame Type="@Row.Type" Key="@Row.Key" Entitled="@Row.Entitled" @bind-Enabled="Enabled" Messages="Messages" Saved="Saved" OnSubmit="SubmitAsync">
    <p><a id="capability-bank-categories-link" href="/admin/categories">@Text[CapabilitiesAdminText.BankCategoriesLink]</a></p>
    @foreach (var family in families)
    {
        var name = family;
        <fieldset data-testid="@($"capability-bank-family-{name}")">
            <legend>@Text[CategoryAdminText.Family(name)]</legend>
            @foreach (var category in categories)
            {
                var id = category.Id;
                <label><input type="checkbox" checked="@IsAllowed(name, id)" @onchange="change => SetAllowed(name, id, change.Value is true)" /> @NameFor(category)</label>
            }
        </fieldset>
    }
</CapabilityFormFrame>

@code {
    private static readonly string[] KnownFamilies = ["trivia", "poll"];

    [CascadingParameter] public AdminState? State { get; set; }

    private readonly List<CategoryResponse> categories = [];
    private readonly Dictionary<string, HashSet<Guid>> allowed = [];
    private string[] families = KnownFamilies;
    private bool categoriesLoaded;

    protected override void Load(System.Text.Json.JsonElement settings)
    {
        allowed.Clear();
        if (settings.ValueKind == System.Text.Json.JsonValueKind.Object
            && settings.TryGetProperty("categoriesByFamily", out var byFamily) && byFamily.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            foreach (var family in byFamily.EnumerateObject())
            {
                allowed[family.Name] = family.Value.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? family.Value.EnumerateArray().Select(item => item.TryGetGuid(out var id) ? id : Guid.Empty).Where(id => id != Guid.Empty).ToHashSet()
                    : [];
            }
        }

        families = KnownFamilies.Concat(allowed.Keys.Except(KnownFamilies, StringComparer.Ordinal).Order(StringComparer.Ordinal)).ToArray();
        foreach (var family in families) allowed.TryAdd(family, []);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (categoriesLoaded || State is null) return;
        categoriesLoaded = true;
        var result = await State.GetAsync<List<CategoryResponse>>("/api/admin/categories");
        if (result.Success && result.Value is not null) categories.AddRange(result.Value);
    }

    protected override object BuildSettings() => new { categoriesByFamily = allowed.ToDictionary(pair => pair.Key, pair => pair.Value.ToArray()) };

    private bool IsAllowed(string family, Guid id) => allowed.TryGetValue(family, out var ids) && ids.Contains(id);

    private void SetAllowed(string family, Guid id, bool selected)
    {
        if (!allowed.TryGetValue(family, out var ids)) allowed[family] = ids = [];
        if (selected) ids.Add(id); else ids.Remove(id);
    }

    private static string NameFor(CategoryResponse category) => category.Names.Values.FirstOrDefault(name => !string.IsNullOrWhiteSpace(name)) ?? category.Slug;

    private sealed record CategoryResponse(Guid Id, string Slug, Dictionary<string, string> Names);
}
