@page "/admin/capabilities"
@layout AdminLayout
@inject NavigationManager Navigation
@inject IClientTranslator Text

@if (State?.Status == AdminSessionStatus.Loading) { <p class="muted">@Text["common.loading"]</p> }
else if (!CanManage) { <section class="card"><p>@Text[CapabilitiesAdminText.Denied]</p></section> }
else
{
    <section class="stack" aria-labelledby="admin-capabilities-title">
        <h1 id="admin-capabilities-title">@Text[CapabilitiesAdminText.Title]</h1>
        @if (error is not null) { <p class="form-error" role="alert">@Text[error]</p> }

        @foreach (var row in rows)
        {
            var current = row;
            var form = CapabilityForms.For(current.Type, current.Key);
            if (form is null) continue;
            var id = Id(current);
            <DynamicComponent Type="form" Parameters="@(new Dictionary<string, object?>
            {
                [nameof(CapabilityFormBase.Row)] = current,
                [nameof(CapabilityFormBase.Messages)] = messages.GetValueOrDefault(id) ?? [],
                [nameof(CapabilityFormBase.Saved)] = saved.Contains(id),
                [nameof(CapabilityFormBase.Save)] = (Func<bool, object, Task>)((enabled, settings) => SaveAsync(current, enabled, settings)),
            })" />
        }
    </section>
}

@code {
    [CascadingParameter] public AdminState? State { get; set; }

    private readonly List<CapabilityRow> rows = [];
    private readonly Dictionary<string, IReadOnlyList<string>> messages = [];
    private readonly HashSet<string> saved = [];
    private string? error;
    private bool loaded;

    private bool CanManage => State?.Session is { IsPlatform: true } || string.Equals(State?.Session?.Role, "Owner", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (State?.Status == AdminSessionStatus.SignedOut) { Navigation.NavigateTo("/admin/login"); return; }
        if (State?.Session?.MustChangePassword == true) { Navigation.NavigateTo("/admin/password"); return; }
        if (CanManage && !loaded) await LoadAsync();
    }

    private static string Id(CapabilityRow row) => $"{row.Type}/{row.Key}";

    private async Task LoadAsync()
    {
        if (State is null) return;
        var result = await State.GetAsync<List<CapabilityRow>>("/api/admin/capabilities");
        if (!result.Success || result.Value is null)
        {
            error = CapabilitiesAdminText.LoadFailed;
            return;
        }

        rows.Clear();
        rows.AddRange(result.Value);
        loaded = true;
        error = null;
    }

    private async Task SaveAsync(CapabilityRow row, bool enabled, object settings)
    {
        if (State is null) return;
        var id = Id(row);
        saved.Remove(id);
        messages.Remove(id);
        var result = await State.MutateAsync<object>(HttpMethod.Put, $"/api/admin/capabilities/{row.Type}/{row.Key}", new { enabled, settings });
        try { Apply(row, result, enabled, settings); }
        finally { StateHasChanged(); }
    }

    private void Apply(CapabilityRow row, AdminResult<object> result, bool enabled, object settings)
    {
        var id = Id(row);
        if (!result.Success)
        {
            if (result.Failure?.Messages is { Count: > 0 } returned) messages[id] = returned;
            else error = CapabilitiesAdminText.SaveFailed;
            return;
        }

        error = null;
        saved.Add(id);
        var index = rows.IndexOf(row);
        if (index >= 0) rows[index] = row with { Enabled = enabled, Settings = System.Text.Json.JsonSerializer.SerializeToElement(settings, SettingsOptions) };
    }

    private static readonly System.Text.Json.JsonSerializerOptions SettingsOptions = new(System.Text.Json.JsonSerializerDefaults.Web);
}
