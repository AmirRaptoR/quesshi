@page "/admin/packs"
@layout AdminLayout
@inject NavigationManager Navigation
@inject ClientHttp Http
@inject IClientTranslator Text

@if (State?.Status == AdminSessionStatus.Loading)
{
    <p class="muted">@Text["common.loading"]</p>
}
else if (!CanEdit)
{
    <section class="card"><p>@Text[PackAdminText.Denied]</p></section>
}
else
{
    <section class="stack" data-testid="pack-screen" aria-labelledby="admin-packs-title">
        <h1 id="admin-packs-title">@Text[PackAdminText.Title]</h1>
        @if (error is not null) { <p class="form-error" role="alert">@Text[error]</p> }

        <section class="card stack" data-testid="pack-list">
            @foreach (var pack in packs)
            {
                <article data-testid="pack-row" data-pack-id="@pack.Id">
                    <strong>@pack.Title</strong> <span>@pack.Visibility</span>
                    <button type="button" data-testid="edit-pack" @onclick="() => OpenAsync(pack.Id)">@Text[PackAdminText.Edit]</button>
                </article>
            }
            @if (packs.Count == 0) { <p>@Text[PackAdminText.Empty]</p> }
        </section>

        <section class="card stack" aria-label="@Text[PackAdminText.New]">
            <h2>@Text[PackAdminText.New]</h2>
            <label>@Text[PackAdminText.Name] <input data-testid="new-pack-title" @bind="newTitle" /></label>
            <label>@Text[PackAdminText.Language] <input data-testid="new-pack-language" @bind="newLanguage" /></label>
            <button type="button" data-testid="create-pack" @onclick="CreateAsync">@Text[PackAdminText.Create]</button>
        </section>

        @if (open is not null)
        {
            <section class="card stack" data-testid="pack-editor" data-pack-id="@open.Pack.Id">
                <label>@Text[PackAdminText.Name] <input data-testid="pack-title" @bind="title" /></label>
                <label>@Text[PackAdminText.Description] <input data-testid="pack-description" @bind="description" /></label>
                <button type="button" data-testid="save-pack" @onclick="SaveAsync">@Text[PackAdminText.Save]</button>
                <label>@Text[PackAdminText.Visibility]
                    <select data-testid="pack-visibility" value="@open.Pack.Visibility" @onchange="SetVisibilityAsync">
                        <option value="private">@Text[PackAdminText.Private]</option>
                        <option value="unlisted">@Text[PackAdminText.Unlisted]</option>
                        <option value="tenant">@Text[PackAdminText.Tenant]</option>
                    </select>
                </label>
                <button type="button" data-testid="delete-pack" @onclick="DeleteAsync">@Text[PackAdminText.Delete]</button>

                <h2>@Text[PackAdminText.Questions]</h2>
                @foreach (var question in open.Questions)
                {
                    <article class="stack" data-testid="pack-question" data-question-id="@question.Id" data-kind="@question.Kind">
                        <label>@Text[PackAdminText.Prompt] <input data-testid="pack-question-prompt" value="@prompts[question.Id]" @onchange="change => prompts[question.Id] = change.Value?.ToString() ?? string.Empty" /></label>
                        <KindEditor Kind="@question.Kind" Payload="@payloads[question.Id]" PayloadChanged="value => SetPayload(question.Id, value)" Lang="@question.Language" />
                        <button type="button" data-testid="save-pack-question" @onclick="() => SaveQuestionAsync(question)">@Text[PackAdminText.Save]</button>
                        <button type="button" data-testid="move-up" disabled="@(question.Position == 0)" @onclick="() => MoveAsync(question.Id, -1)">@Text[PackAdminText.MoveUp]</button>
                        <button type="button" data-testid="move-down" disabled="@(question.Position == open.Questions.Count - 1)" @onclick="() => MoveAsync(question.Id, 1)">@Text[PackAdminText.MoveDown]</button>
                        <button type="button" data-testid="remove-pack-question" @onclick="() => RemoveAsync(question.Id)">@Text[PackAdminText.Remove]</button>
                    </article>
                }
                @if (open.Questions.Count == 0) { <p>@Text[PackAdminText.NoQuestions]</p> }

                <article class="stack" data-testid="new-pack-question">
                    <label>@Text[PackAdminText.Kind]
                        <select data-testid="new-question-kind" value="@draftKind" @onchange="ChangeDraftKind">
                            <option value="choice">choice</option><option value="order">order</option><option value="map_pick">map_pick</option><option value="poll_choice">poll_choice</option><option value="poll_roster">poll_roster</option>
                        </select>
                    </label>
                    <label>@Text[PackAdminText.Prompt] <input data-testid="new-question-prompt" @bind="draftPrompt" /></label>
                    <KindEditor Kind="@draftKind" Payload="@draftPayload" PayloadChanged="value => { draftPayload = value; return Task.CompletedTask; }" Lang="@open.Pack.Language" />
                    <button type="button" data-testid="add-pack-question" @onclick="AddQuestionAsync">@Text[PackAdminText.AddQuestion]</button>
                </article>
            </section>
        }
    </section>
}

@code {
    [CascadingParameter] public AdminState? State { get; set; }

    private readonly List<PackSummary> packs = [];
    private readonly Dictionary<Guid, string> prompts = [];
    private readonly Dictionary<Guid, object> payloads = [];
    private QuestionAdminApi? api;
    private PackDetail? open;
    private string newTitle = string.Empty;
    private string newLanguage = "en";
    private string title = string.Empty;
    private string? description;
    private string draftKind = "choice";
    private string draftPrompt = string.Empty;
    private object draftPayload = QuestionPayloadCodec.NewPayload("choice");
    private bool loaded;
    private string? error;

    private bool CanEdit => State?.Session is { IsPlatform: true } || string.Equals(State?.Session?.Role, "Owner", StringComparison.OrdinalIgnoreCase) || string.Equals(State?.Session?.Role, "Editor", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (State?.Status == AdminSessionStatus.SignedOut) { Navigation.NavigateTo("/admin/login"); return; }
        if (State?.Session?.MustChangePassword == true) { Navigation.NavigateTo("/admin/password"); return; }
        if (CanEdit && !loaded)
        {
            loaded = true;
            api = new QuestionAdminApi(Http);
            await LoadListAsync();
        }
    }

    private async Task LoadListAsync()
    {
        var result = await api!.GetAsync<List<PackSummary>>("/api/admin/packs");
        if (!result.Success) { error = PackAdminText.LoadFailed; return; }
        packs.Clear();
        packs.AddRange(result.Value ?? []);
    }

    private async Task OpenAsync(Guid id)
    {
        var result = await api!.GetAsync<PackDetail>($"/api/admin/packs/{id}");
        if (!result.Success || result.Value is null) { error = PackAdminText.LoadFailed; return; }
        open = result.Value;
        title = open.Pack.Title;
        description = open.Pack.Description;
        prompts.Clear();
        payloads.Clear();
        foreach (var question in open.Questions)
        {
            prompts[question.Id] = question.Prompt;
            payloads[question.Id] = QuestionPayloadCodec.ReadPayload(question.Kind, question.Payload);
        }
    }

    private async Task CreateAsync()
    {
        var result = await api!.SendAsync<PackSummary>(HttpMethod.Post, "/api/admin/packs", new { title = newTitle, language = newLanguage }, default);
        if (!Check(result) || result.Value is null) return;
        newTitle = string.Empty;
        await LoadListAsync();
        await OpenAsync(result.Value.Id);
    }

    private async Task SaveAsync()
    {
        if (!Check(await api!.SendAsync<PackSummary>(HttpMethod.Put, $"/api/admin/packs/{open!.Pack.Id}", new { title, description }, default))) return;
        await LoadListAsync();
        await OpenAsync(open.Pack.Id);
    }

    private async Task SetVisibilityAsync(ChangeEventArgs change)
    {
        if (!Check(await api!.SendAsync<PackSummary>(HttpMethod.Put, $"/api/admin/packs/{open!.Pack.Id}/visibility", new { visibility = change.Value?.ToString() }, default))) return;
        await LoadListAsync();
        await OpenAsync(open.Pack.Id);
    }

    private async Task DeleteAsync()
    {
        if (!Check(await api!.SendAsync<object>(HttpMethod.Delete, $"/api/admin/packs/{open!.Pack.Id}", null, default))) return;
        open = null;
        await LoadListAsync();
    }

    private Task SetPayload(Guid id, object value) { payloads[id] = value; return Task.CompletedTask; }

    private async Task SaveQuestionAsync(PackQuestion question)
    {
        var write = new QuestionWrite(question.Kind, question.KindVersion, question.Family, question.Language, question.CategoryId, question.Level, prompts[question.Id], QuestionPayloadCodec.WritePayload(question.Kind, payloads[question.Id]), question.Explanation, null, question.Status, "pack", null, question.MediaId);
        Check(await api!.UpdateAsync(question.Id, write));
    }

    private async Task ChangeDraftKind(ChangeEventArgs change)
    {
        draftKind = change.Value?.ToString() ?? "choice";
        draftPayload = QuestionPayloadCodec.NewPayload(draftKind);
        await Task.CompletedTask;
    }

    private async Task AddQuestionAsync()
    {
        var family = draftKind.StartsWith("poll_", StringComparison.Ordinal) ? "poll" : "trivia";
        var write = new QuestionWrite(draftKind, 1, family, open!.Pack.Language, null, 1, draftPrompt, QuestionPayloadCodec.WritePayload(draftKind, draftPayload), null, null, "approved", "pack", null, null);
        var created = await api!.CreateAsync(write);
        if (!Check(created) || created.Value is null) return;
        if (!Check(await api.SendAsync<object>(HttpMethod.Post, $"/api/admin/packs/{open.Pack.Id}/questions", new { questionId = created.Value.Id }, default))) return;
        draftPrompt = string.Empty;
        draftPayload = QuestionPayloadCodec.NewPayload(draftKind);
        await OpenAsync(open.Pack.Id);
    }

    private async Task RemoveAsync(Guid questionId)
    {
        if (!Check(await api!.SendAsync<object>(HttpMethod.Delete, $"/api/admin/packs/{open!.Pack.Id}/questions/{questionId}", null, default))) return;
        await OpenAsync(open.Pack.Id);
    }

    private async Task MoveAsync(Guid questionId, int offset)
    {
        var ids = open!.Questions.Select(question => question.Id).ToList();
        var index = ids.IndexOf(questionId);
        var target = index + offset;
        if (index < 0 || target < 0 || target >= ids.Count) return;
        (ids[index], ids[target]) = (ids[target], ids[index]);
        if (!Check(await api!.SendAsync<object>(HttpMethod.Put, $"/api/admin/packs/{open.Pack.Id}/questions/order", new { ids }, default))) return;
        await OpenAsync(open.Pack.Id);
    }

    private bool Check<T>(QuestionApiResult<T> result)
    {
        error = result.Success ? null : PackAdminText.Failed;
        return result.Success;
    }

    private sealed record PackSummary(Guid Id, string Title, string? Description, string Language, string Visibility);
    private sealed record PackQuestion(int Position, Guid Id, string Kind, int KindVersion, string Family, string Language, Guid? CategoryId, int? Level, string Prompt, System.Text.Json.JsonElement Payload, string? Explanation, string Status, Guid? MediaId);
    private sealed record PackDetail(PackSummary Pack, List<PackQuestion> Questions);
}
