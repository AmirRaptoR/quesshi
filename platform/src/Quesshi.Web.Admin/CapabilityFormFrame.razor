@inject IClientTranslator Text

<form id="@FormId" class="card stack" data-testid="@FormId" @onsubmit="OnSubmit" @onsubmit:preventDefault>
    <h2>@Title</h2>
    @if (!Entitled) { <p class="muted" data-testid="capability-not-entitled">@Text[CapabilitiesAdminText.NotEntitled]</p> }
    <label><input id="@($"{FormId}-enabled")" type="checkbox" disabled="@(!Entitled)" checked="@Enabled" @onchange="change => EnabledChanged.InvokeAsync(change.Value is true)" /> @Text[CapabilitiesAdminText.Enabled]</label>
    @ChildContent
    @if (Messages.Count > 0)
    {
        <ul class="form-error" role="alert" data-testid="capability-messages">
            @foreach (var message in Messages) { <li>@message</li> }
        </ul>
    }
    @if (Saved) { <p role="status" data-testid="capability-saved">@Text[CapabilitiesAdminText.Saved]</p> }
    <button id="@($"{FormId}-save")" class="btn" type="submit" disabled="@(!Entitled)">@Text[CapabilitiesAdminText.Save]</button>
</form>

@code {
    [Parameter, EditorRequired] public string Type { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Key { get; set; } = string.Empty;
    [Parameter] public bool Entitled { get; set; } = true;
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Messages { get; set; } = [];
    [Parameter] public bool Saved { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string FormId => $"capability-{Type}-{Key}";

    private string Title
    {
        get
        {
            var name = CapabilitiesAdminText.Name(Type, Key);
            var text = Text[name];
            return text == name ? $"{Type}: {Key}" : text;
        }
    }
}
