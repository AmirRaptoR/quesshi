@inherits CapabilityFormBase
@inject IClientTranslator Text

<CapabilityFormFrame Type="@Row.Type" Key="@Row.Key" Entitled="@Row.Entitled" @bind-Enabled="Enabled" Messages="Messages" Saved="Saved" OnSubmit="SubmitAsync">
    <label>@Text[CapabilitiesAdminText.SessionsCapacity] <input id="capability-sessions-capacity" type="number" min="1" max="500" value="@capacity" @onchange="change => capacity = int.TryParse(change.Value?.ToString(), out var value) ? value : 0" /></label>
</CapabilityFormFrame>

@code {
    private int capacity = 20;

    protected override void Load(System.Text.Json.JsonElement settings) => capacity = ReadInt(settings, "capacity") ?? 20;

    protected override object BuildSettings() => new { capacity };
}
