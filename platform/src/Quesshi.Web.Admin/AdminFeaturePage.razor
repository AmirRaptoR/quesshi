@page "/admin/feature/{*Path}"
@layout AdminLayout
@inject NavigationManager Navigation
@inject IAdminClientRegistry Registry
@inject IClientTranslator Text

@if (State?.Status is null or AdminSessionStatus.Loading || !capabilitiesReady)
{
    <p class="muted">@Text["common.loading"]</p>
}
else if (Contribution is null || State?.Session is not { } session || !Contribution.IsVisibleTo(new AdminNavigationContext(session.Role, session.IsPlatform, State.Capabilities)))
{
    <section class="card"><p data-testid="admin-feature-denied">@Text["admin.feature.unavailable"]</p></section>
}
else
{
    <ErrorBoundary @key="Contribution.Path">
        <ChildContent><DynamicComponent Type="Contribution.Component" /></ChildContent>
        <ErrorContent><p class="form-error" role="alert" data-testid="admin-feature-failed">@Text["admin.feature.failed"]</p></ErrorContent>
    </ErrorBoundary>
}

@code {
    private bool capabilitiesReady;

    [CascadingParameter] public AdminState? State { get; set; }
    [Parameter] public string? Path { get; set; }

    private AdminPageContribution? Contribution => Registry.FeaturePages.FirstOrDefault(page => string.Equals(page.Path, Path, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (State?.Status == AdminSessionStatus.SignedOut) { Navigation.NavigateTo("/admin/login"); return; }
        if (State?.Session?.MustChangePassword == true) { Navigation.NavigateTo("/admin/password"); return; }
        if (State is { Status: AdminSessionStatus.SignedIn } && Contribution?.Capability is not null) await State.LoadCapabilitiesAsync();
        capabilitiesReady = true;
    }
}
