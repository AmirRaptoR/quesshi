@page "/admin/password"
@layout AdminLayout
@inject NavigationManager Navigation
@inject IClientTranslator Text

<section class="card stack admin-auth" aria-labelledby="admin-password-title">
    <h1 id="admin-password-title">@Text["admin.password.title"]</h1>
    <EditForm Model="model" OnValidSubmit="SubmitAsync"><div class="stack">
        <label>@Text["admin.field.currentPassword"] <InputText type="password" @bind-Value="model.Current" /></label>
        <label>@Text["admin.field.newPassword"] <InputText type="password" @bind-Value="model.Password" /></label>
        <button class="btn" type="submit">@Text["admin.password.submit"]</button>
        @if (error is not null) { <p class="form-error" role="alert">@Text[error]</p> }
    </div></EditForm>
</section>

@code {
    [CascadingParameter] public AdminState? State { get; set; }
    private readonly PasswordModel model = new(); private string? error;
    protected override void OnParametersSet() { if (State?.Status == AdminSessionStatus.SignedOut) Navigation.NavigateTo("/admin/login"); }
    private async Task SubmitAsync()
    {
        if (State is null) return;
        var result = await State.ChangePasswordAsync(model.Current, model.Password);
        if (result.Success) Navigation.NavigateTo("/admin"); else error = result.Error;
    }
    private sealed class PasswordModel { public string Current { get; set; } = string.Empty; public string Password { get; set; } = string.Empty; }
}
