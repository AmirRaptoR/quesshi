@page "/admin"
@layout AdminLayout
@inject NavigationManager Navigation
@inject IClientTranslator Text

@if (State?.Status == AdminSessionStatus.Loading)
{
    <p class="muted">@Text["common.loading"]</p>
}
else
{
    <p class="muted">@Text["common.loading"]</p>
}

@code {
    [CascadingParameter] public AdminState? State { get; set; }
    protected override void OnParametersSet()
    {
        if (State?.Status == AdminSessionStatus.SignedOut) Navigation.NavigateTo("/admin/login");
        else if (State?.Session?.MustChangePassword == true) Navigation.NavigateTo("/admin/password");
        else if (State?.Session is not null) Navigation.NavigateTo("/admin/dashboard");
    }
}
