@inject ClientHttp Http
@inject IAdminClientRegistry Registry

<CascadingValue Value="state">
    <Router AppAssembly="@typeof(AdminApp).Assembly" AdditionalAssemblies="@Registry.PageAssemblies">
        <Found Context="routeData"><RouteView RouteData="@routeData" /></Found>
        <NotFound><AdminHome /></NotFound>
    </Router>
</CascadingValue>

@code {
    private AdminState state = null!;

    protected override async Task OnInitializedAsync()
    {
        state = new AdminState(new AdminApi(Http));
        await state.InitializeAsync();
    }
}
