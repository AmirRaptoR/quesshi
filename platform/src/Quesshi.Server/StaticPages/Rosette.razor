@* The shamseh rosette of the app's landing page, copied from the client as plain static SVG. *@
<svg class="shamseh shamseh--ignite" viewBox="0 0 100 100" width="@Size" height="@Size" role="img" aria-label="@Label">
    <g>
        @for (var i = 0; i < Slots * 2; i++)
        {
            var mine = i < Slots;
            var slot = mine ? i : i - Slots;
            var state = StateOf(mine ? Mine : Theirs, slot);
            <polygon class="shamseh__ray shamseh__ray--@state" points="@Ray(i, Slots * 2)" style="animation-delay:@(i * 55)ms" />
        }
    </g>
    <line class="shamseh__seam" x1="50" y1="2" x2="50" y2="98" />
    <circle class="shamseh__hub" cx="50" cy="50" r="13" />
</svg>

@code {
    [Parameter] public IReadOnlyList<bool?>? Mine { get; set; }
    [Parameter] public IReadOnlyList<bool?>? Theirs { get; set; }
    [Parameter] public string Size { get; set; } = "100%";
    [Parameter] public string Label { get; set; } = "";

    private const int Slots = 6;

    private static string StateOf(IReadOnlyList<bool?>? run, int slot)
        => run is null || slot >= run.Count || run[slot] is null ? "idle" : (run[slot]!.Value ? "right" : "wrong");

    // Ray 0 points up; the first half sweeps clockwise down the right side, the rest back up the left.
    private static string Ray(int index, int total)
    {
        const double cx = 50, cy = 50, tip = 46, shoulder = 27, inner = 15;
        var step = 360.0 / total;
        var angle = index * step - 90;
        return string.Join(' ', new[]
        {
            Point(cx, cy, tip, angle),
            Point(cx, cy, shoulder, angle - step / 2),
            Point(cx, cy, inner, angle),
            Point(cx, cy, shoulder, angle + step / 2)
        });
    }

    private static string Point(double cx, double cy, double radius, double degrees)
    {
        var radians = degrees * Math.PI / 180;
        return string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{cx + radius * Math.Cos(radians):0.##},{cy + radius * Math.Sin(radians):0.##}");
    }
}
