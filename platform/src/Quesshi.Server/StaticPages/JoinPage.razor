@*
    Where an invite link lands, as static HTML. It never looks the lobby up: the preview is the same
    generic per-tenant card for every code. The app boots into the empty #app container and takes
    over from #preview; that hand-off is not done here.
*@
<!DOCTYPE html>
<html lang="@Page.Language" dir="@Page.Direction" translate="no" class="notranslate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <title>@Title</title>
    <meta name="description" content="@Description" />
    <meta name="google" content="notranslate" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Page.AppName" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:image" content="@Page.ImageUrl" />
    <meta property="og:url" content="@Url" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    <meta name="twitter:image" content="@Page.ImageUrl" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="css/app.css" />
    <link id="tenant-theme" rel="stylesheet" href="/theme.css" />
    <link rel="manifest" href="/manifest.webmanifest" />
</head>
<body>
<div id="preview">
    <div class="shell">
        <div class="stack" style="margin-top:10vh">
            <div class="enter" style="text-align:center">
                <div style="width:7.5rem;margin-inline:auto">
                    <Rosette Mine="Mark" Theirs="Mark" Label="@Page.AppName" />
                </div>
                <h1 style="margin-top:1.1rem;font-size:var(--step-2)">@Page.AppName</h1>
            </div>
            <div class="card card--taq enter">
                <div style="text-align:center">
                    <h3 style="font-size:var(--step--1)">@Page["join.title"]</h3>
                    <p class="muted" style="margin:.7rem 0 0">@Description</p>
                </div>
                <div class="stack" style="margin-top:1.2rem">
                    <a id="join-button" class="btn btn--block" role="button" href="@SignInHref">@Page["join.playAsGuest"]</a>
                    <a class="btn btn--ghost btn--block" href="@SignInHref">@Page["join.signInInstead"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="app"></div>
<script src="_framework/blazor.webassembly.js"></script>
</body>
</html>

@code {
    private static readonly IReadOnlyList<bool?> Mark = [true, null, true, null, true, null];

    [Parameter, EditorRequired] public StaticPageModel Page { get; set; } = null!;
    [Parameter] public string Code { get; set; } = "";

    private string Title => $"{Page["join.title"]} · {Page.AppName}";
    private string Description => Page.LandingText ?? Page["landing.lede"];
    private string Url => $"{Page.Origin}/join/{Uri.EscapeDataString(Code)}";

    /// <summary>Signing in comes back to the invite, so it is not lost on the way through.</summary>
    private string SignInHref => $"/signin?next={Uri.EscapeDataString($"/join/{Code}")}";
}
