# Copy this file to .env on the staging host. Values are deliberately non-secret examples.
# Keep every value on one line without shell quoting; deploy.sh reads this as Docker Compose dotenv.

# Isolated host bindings: these differ from the production stack defaults.
APP_BIND=127.0.0.1
APP_PORT=5011
# Leave this at /health. It is configurable so deployment checks can inject a failed candidate.
APP_HEALTH_PATH=/health
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=55432
MAILPIT_BIND=127.0.0.1
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# PostgreSQL bootstrap account and database. The three Quesshi role passwords must be unique.
POSTGRES_DB=quesshi_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-postgres-bootstrap-password
DB_OWNER_PASSWORD=replace-with-a-long-owner-password
DB_APP_PASSWORD=replace-with-a-long-app-password
DB_SYSTEM_PASSWORD=replace-with-a-long-system-password

# Named volumes remain staging-only even when Docker project-name behaviour differs by host.
POSTGRES_VOLUME=quesshi-platform-staging-postgres
MEDIA_VOLUME=quesshi-platform-staging-media

# App configuration. Set TRUSTED_PROXIES to the address/range of the reverse proxy, not a public client.
SECRET_KEY=replace-with-a-long-random-secret-key
TRUSTED_PROXIES=127.0.0.1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false

# Deployment state holds the last healthy release's Compose configuration and must be private.
# RELEASE_TAG is normally the first argument to deploy.sh; this default is useful for manual Compose use.
RELEASE_TAG=local
# PLATFORM_COMPOSE_PROJECT=quesshi-platform-staging  # optional: use a distinct name for an isolated test stack
DEPLOY_STATE_DIR=/var/lib/quesshi-platform-staging
DEPLOY_HEALTH_TIMEOUT_SECONDS=180
DEPLOY_HEALTH_POLL_SECONDS=5
DEPLOY_POSTGRES_TIMEOUT_SECONDS=120
DEPLOY_POSTGRES_POLL_SECONDS=2
# DEPLOY_ENV_FILE=/absolute/path/to/.env  # optional deploy.sh override; normally leave unset
