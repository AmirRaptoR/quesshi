# Caddy enables HTTP/2 for HTTPS sites automatically. Replace the host with the staging DNS name.
# The proxy and the app normally share a host, hence the loopback upstream and TRUSTED_PROXIES=127.0.0.1.
staging.example.test {
	@stream path /api/stream*
	@notStream {
		not path /api/stream*
	}
	encode @notStream zstd gzip

	handle @stream {
		reverse_proxy 127.0.0.1:5011 {
			header_up Host {host}
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:5011 {
			header_up Host {host}
		}
	}
}
