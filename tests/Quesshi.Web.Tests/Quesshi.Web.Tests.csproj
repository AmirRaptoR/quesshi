<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quesshi.Web\Quesshi.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Quesshi.Web\wwwroot\i18n\**\*.json" LinkBase="i18n" CopyToOutputDirectory="PreserveNewest" />
    <!-- The landmark tests read the real, shipped asset, not a fixture, so a change to the
         SVG that breaks the projection assumptions gets caught here. -->
    <Content Include="..\..\src\Quesshi.Web\wwwroot\maps\**\*.svg" LinkBase="maps" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
