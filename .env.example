# Copy to .env and adjust. Defaults (no .env at all) give a working local development stack.

# Local development ------------------------------------------------------------------
# ENVIRONMENT=Development
# APP_PORT=5010
# CONFIG_FILE=./src/Quesshi.Server/appsettings.Development.json
# MEDIA_DIR=./.media

# The server -------------------------------------------------------------------------
# TAG=20260821-120000
# ENVIRONMENT=Production
# APP_PORT=5199
# MONGO_IMAGE=mongo:4.4.18
# MONGO_PORT=27018
# REDIS_PORT=6380
# CONFIG_FILE=/home/you/deployments/quesshi/appsettings.Production.json
# MEDIA_DIR=/home/you/deployments/quesshi/data
# The server's volumes were created by an earlier compose that prefixed them with the project name.
# Check with: docker volume ls | grep quesshi
# MONGO_VOLUME=quesshi_quesshi-mongo
# REDIS_VOLUME=quesshi_quesshi-redis
