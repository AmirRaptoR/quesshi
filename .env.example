# Copy to .env and adjust. Defaults (no .env at all) give a working local development stack.

# Local development ------------------------------------------------------------------
# ENVIRONMENT=Development
# APP_PORT=5010
# CONFIG_FILE=./src/Quesshi.Server/appsettings.Development.json
# MEDIA_DIR=./.media

# Mail is caught by Mailpit locally; read it at http://localhost:8025
# MAILPIT_UI_PORT=8025

# Or opt out of mail entirely: an empty host means the sign-in code and any reset link are written
# to the app's log instead of being sent, so a development machine needs no mail in the loop at all.
# Read them with: docker compose logs -f app
# SMTP_HOST=

# The server -------------------------------------------------------------------------
# TAG=20260821-120000
# ENVIRONMENT=Production
# APP_PORT=5199
# MONGO_IMAGE=mongo:4.4.18
# MONGO_PORT=27018
# REDIS_PORT=6380
# CONFIG_FILE=/home/you/deployments/quesshi/appsettings.Production.json
# MEDIA_DIR=/home/you/deployments/quesshi/data
# A server sends through a real provider, so Mailpit just sits there unused; these must be set,
# because compose environment variables outrank appsettings.Production.json and the local defaults
# would otherwise redirect every sign-in code to a host that does not exist.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# The server's volumes were created by an earlier compose that prefixed them with the project name.
# Check with: docker volume ls | grep quesshi
# MONGO_VOLUME=quesshi_quesshi-mongo
# REDIS_VOLUME=quesshi_quesshi-redis
